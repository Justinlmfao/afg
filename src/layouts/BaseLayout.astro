---
// Base layout shared by every page: <head>, fonts, skip link, header and
// footer. The scripts on the site are the phone menu and the light/dark
// switch (Header.astro), plus a few lines here that apply a remembered
// light/dark choice before the page is drawn.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/components.css';
import {
  getLangFromUrl,
  localizePath,
  ui,
  langOrder,
  htmlLangs,
  hreflangs,
} from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = ui[lang];
const htmlLang = htmlLangs[lang];
const ogLocale = { en: 'en', zh: 'zh_HK', hans: 'zh_CN' }[lang];

interface Props {
  title: string;
  description?: string;
  /** Scopes that page's stylesheet, e.g. "page-home". */
  pageClass?: string;
  /** Keep a page out of search results (the 404 and thank-you pages). */
  noindex?: boolean;
  /** Share image for link previews, 1200×630. Defaults to /og-default.jpg. */
  image?: string;
  imageAlt?: string;
}

const {
  title,
  pageClass,
  noindex = false,
  image = '/og-default.jpg',
  imageAlt,
  description = 'AI For Good is a student-run organisation in Hong Kong. We write policy recommendations for the government and run free tutoring for primary school children from underprivileged families.',
} = Astro.props;

// Each page's title ends with the site name, which says "Hong Kong" so it
// can't be confused with the many other organisations called AI for Good.
// A title that already starts with the name (the home pages) is used as is.
const fullTitle = title.startsWith('AI For Good') ? title : `${title} — ${t.siteName}`;

// Absolute URLs for the <head>. Always with a trailing slash, matching how
// the pages are built (/policy/index.html), served and listed in the sitemap,
// so every signal points search engines at the same address for each page.
const site = Astro.site ?? Astro.url;
const absolute = (path: string) => new URL(path.endsWith('/') ? path : `${path}/`, site).href;
const canonical = absolute(Astro.url.pathname);
const shareImage = new URL(image, site).href;

// Tells search engines what kind of organisation this is.
const organisation = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'AI For Good Hong Kong',
  url: new URL('/', site).href,
  logo: new URL('/icon-512.png', site).href,
  foundingDate: '2023-06',
  areaServed: 'Hong Kong',
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- The site icon: browser tabs, bookmarks, home screens, and beside the
         site's name in search results. All made from public/favicon.svg by
         `npm run icons`. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#16171B" />
    <!-- Apply a light or dark choice made earlier, before anything is drawn -->
    <script is:inline>
      try {
        var theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch (e) {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- The one address this page should be indexed under -->
    <link rel="canonical" href={canonical} />

    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? t.shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organisation)} />

    <!-- Each page exists in all three languages; tell search engines which is which -->
    {
      !noindex && langOrder.map((code) => (
        <link
          rel="alternate"
          hreflang={hreflangs[code]}
          href={absolute(localizePath(Astro.url.pathname, code))}
        />
      ))
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={absolute(localizePath(Astro.url.pathname, 'en'))} />}

    <!-- Fonts are served from this site (see global.css). The body face is
         fetched early because nearly every line on the page is set in it. -->
    <link rel="preload" href="/fonts/source-sans-3-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <Header />
    <main id="main" class={pageClass}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
