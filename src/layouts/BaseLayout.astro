---
// Base layout shared by every page: <head>, fonts, skip link, header/footer
// shell, and the three pieces of behaviour the site actually uses —
// selective entrances, the one count-up figure, and the photo lightbox.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import {
  getLangFromUrl,
  localizePath,
  ui,
  langOrder,
  htmlLangs,
  hreflangs,
} from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = ui[lang];
const htmlLang = htmlLangs[lang];
const ogLocale = { en: 'en', zh: 'zh_HK', hans: 'zh_CN' }[lang];

interface Props {
  title: string;
  description?: string;
  /** Scopes that page's stylesheet, e.g. "page-home". */
  pageClass?: string;
}

const {
  title,
  pageClass,
  description = 'AI For Good is a student-run organisation in Hong Kong. We write policy recommendations for the government and run free tutoring for primary school children from underprivileged families.',
} = Astro.props;

// Each page's title ends with the site name, which says "Hong Kong" so it
// can't be confused with the many other organisations called AI for Good.
// A title that already starts with the name (the home pages) is used as is.
const fullTitle = title.startsWith('AI For Good') ? title : `${title} — ${t.siteName}`;

// Absolute URLs for the <head>. Always with a trailing slash, matching how
// the pages are built (/policy/index.html), served and listed in the sitemap,
// so every signal points search engines at the same address for each page.
const site = Astro.site ?? Astro.url;
const absolute = (path: string) => new URL(path.endsWith('/') ? path : `${path}/`, site).href;
const canonical = absolute(Astro.url.pathname);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- The one address this page should be indexed under -->
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Each page exists in all three languages; tell search engines which is which -->
    {
      langOrder.map((code) => (
        <link
          rel="alternate"
          hreflang={hreflangs[code]}
          href={absolute(localizePath(Astro.url.pathname, code))}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={absolute(localizePath(Astro.url.pathname, 'en'))} />

    <!-- Newsreader (headings) + Inter (body, UI, numbers) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header />
    <main id="main" class={pageClass}>
      <slot />
    </main>
    <Footer />

    <script>
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      // Selective entrances — only elements that opt in with [data-reveal].
      const revealEls = document.querySelectorAll('[data-reveal]');
      if (reduceMotion) {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -6% 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // Count-up for [data-count] on the 86% figures. The real number is in
      // the HTML, so it stays correct with no JS or if the observer never
      // fires; the animation only ever starts from 0 once it is on screen.
      const countEls = document.querySelectorAll<HTMLElement>('[data-count]');
      const runCount = (el: HTMLElement) => {
        const target = parseFloat(el.dataset.count || '0');
        if (reduceMotion) {
          el.textContent = String(target);
          return;
        }
        el.textContent = '0';
        const dur = 1400;
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min((now - start) / dur, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = String(Math.round(target * eased));
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = String(target);
        };
        requestAnimationFrame(tick);
      };
      const countIO = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              runCount(entry.target as HTMLElement);
              countIO.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.5 }
      );
      countEls.forEach((el) => countIO.observe(el));

      // Lightbox for [data-lightbox] photos (teaching page).
      const triggers = Array.from(
        document.querySelectorAll<HTMLElement>('[data-lightbox]')
      );
      if (triggers.length) {
        const items = triggers.map((t) => ({
          src: t.dataset.src || '',
          alt: t.dataset.alt || '',
        }));
        let current = 0;
        let lastFocus: HTMLElement | null = null;

        const box = document.createElement('div');
        box.className = 'lightbox';
        box.setAttribute('role', 'dialog');
        box.setAttribute('aria-modal', 'true');
        box.setAttribute('aria-label', 'Photo viewer');
        box.innerHTML = `
          <button class="lightbox-btn lightbox-close" aria-label="Close">✕</button>
          <button class="lightbox-btn lightbox-prev" aria-label="Previous photo">‹</button>
          <button class="lightbox-btn lightbox-next" aria-label="Next photo">›</button>
          <img alt="" />
          <p class="lightbox-cap"></p>`;
        document.body.appendChild(box);
        const img = box.querySelector('img') as HTMLImageElement;
        const cap = box.querySelector('.lightbox-cap') as HTMLElement;
        const closeBtn = box.querySelector('.lightbox-close') as HTMLElement;

        const render = () => {
          img.src = items[current].src;
          img.alt = items[current].alt;
          cap.textContent = items[current].alt;
        };
        const open = (i: number) => {
          current = i;
          lastFocus = document.activeElement as HTMLElement;
          render();
          box.classList.add('open');
          closeBtn.focus();
        };
        const close = () => {
          box.classList.remove('open');
          lastFocus?.focus();
        };
        const step = (d: number) => {
          current = (current + d + items.length) % items.length;
          render();
        };

        triggers.forEach((t, i) => t.addEventListener('click', () => open(i)));
        closeBtn.addEventListener('click', close);
        box.querySelector('.lightbox-prev')!.addEventListener('click', () => step(-1));
        box.querySelector('.lightbox-next')!.addEventListener('click', () => step(1));
        box.addEventListener('click', (e) => {
          if (e.target === box) close();
        });
        document.addEventListener('keydown', (e) => {
          if (!box.classList.contains('open')) return;
          if (e.key === 'Escape') close();
          else if (e.key === 'ArrowRight') step(1);
          else if (e.key === 'ArrowLeft') step(-1);
        });
      }
    </script>
  </body>
</html>
