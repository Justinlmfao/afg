---
// Base layout shared by every page: <head>, fonts, skip link, header/footer
// shell, and the one piece of behaviour the site uses: the photo lightbox.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import {
  getLangFromUrl,
  localizePath,
  ui,
  langOrder,
  htmlLangs,
  hreflangs,
} from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = ui[lang];
const htmlLang = htmlLangs[lang];
const ogLocale = { en: 'en', zh: 'zh_HK', hans: 'zh_CN' }[lang];

interface Props {
  title: string;
  description?: string;
  /** Scopes that page's stylesheet, e.g. "page-home". */
  pageClass?: string;
  /** Keep a page out of search results (the 404 and thank-you pages). */
  noindex?: boolean;
  /** Share image for link previews, 1200×630. Defaults to /og-default.jpg. */
  image?: string;
  imageAlt?: string;
}

const {
  title,
  pageClass,
  noindex = false,
  image = '/og-default.jpg',
  imageAlt,
  description = 'AI For Good is a student-run organisation in Hong Kong. We write policy recommendations for the government and run free tutoring for primary school children from underprivileged families.',
} = Astro.props;

// Each page's title ends with the site name, which says "Hong Kong" so it
// can't be confused with the many other organisations called AI for Good.
// A title that already starts with the name (the home pages) is used as is.
const fullTitle = title.startsWith('AI For Good') ? title : `${title} — ${t.siteName}`;

// Absolute URLs for the <head>. Always with a trailing slash, matching how
// the pages are built (/policy/index.html), served and listed in the sitemap,
// so every signal points search engines at the same address for each page.
const site = Astro.site ?? Astro.url;
const absolute = (path: string) => new URL(path.endsWith('/') ? path : `${path}/`, site).href;
const canonical = absolute(Astro.url.pathname);
const shareImage = new URL(image, site).href;

// Tells search engines what kind of organisation this is.
const organisation = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'AI For Good Hong Kong',
  url: new URL('/', site).href,
  logo: new URL('/icon-512.png', site).href,
  foundingDate: '2023-06',
  areaServed: 'Hong Kong',
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#16171B" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- The one address this page should be indexed under -->
    <link rel="canonical" href={canonical} />

    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? t.shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organisation)} />

    <!-- Each page exists in all three languages; tell search engines which is which -->
    {
      !noindex && langOrder.map((code) => (
        <link
          rel="alternate"
          hreflang={hreflangs[code]}
          href={absolute(localizePath(Astro.url.pathname, code))}
        />
      ))
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={absolute(localizePath(Astro.url.pathname, 'en'))} />}

    <!-- Fonts are served from this site (see global.css). The body face is
         fetched early because nearly every line on the page is set in it. -->
    <link rel="preload" href="/fonts/source-sans-3-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body
    data-photo-viewer={t.photoViewer}
    data-photo-close={t.photoClose}
    data-photo-prev={t.photoPrev}
    data-photo-next={t.photoNext}
  >
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header />
    <main id="main" class={pageClass}>
      <slot />
    </main>
    <Footer />

    <script>
      // Lightbox for [data-lightbox] photos (teaching page).
      const triggers = Array.from(
        document.querySelectorAll<HTMLElement>('[data-lightbox]')
      );
      if (triggers.length) {
        const items = triggers.map((t) => ({
          src: t.dataset.src || '',
          alt: t.dataset.alt || '',
        }));
        let current = 0;
        let lastFocus: HTMLElement | null = null;

        // Labels come from the page's language (set on <body> by the layout)
        const label = document.body.dataset;
        const icon = (d: string) =>
          `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;

        const box = document.createElement('div');
        box.className = 'lightbox';
        box.setAttribute('role', 'dialog');
        box.setAttribute('aria-modal', 'true');
        box.setAttribute('aria-label', label.photoViewer || 'Photo viewer');
        box.innerHTML = `
          <button class="lightbox-btn lightbox-close" aria-label="${label.photoClose}">${icon('M6 6l12 12M18 6L6 18')}</button>
          <button class="lightbox-btn lightbox-prev" aria-label="${label.photoPrev}">${icon('M15 5l-7 7 7 7')}</button>
          <button class="lightbox-btn lightbox-next" aria-label="${label.photoNext}">${icon('M9 5l7 7-7 7')}</button>
          <img alt="" />
          <p class="lightbox-cap"></p>`;
        document.body.appendChild(box);
        const img = box.querySelector('img') as HTMLImageElement;
        const cap = box.querySelector('.lightbox-cap') as HTMLElement;
        const closeBtn = box.querySelector('.lightbox-close') as HTMLElement;
        const buttons = Array.from(box.querySelectorAll<HTMLElement>('button'));

        const render = () => {
          img.src = items[current].src;
          img.alt = items[current].alt;
          cap.textContent = items[current].alt;
        };
        const open = (i: number) => {
          current = i;
          lastFocus = document.activeElement as HTMLElement;
          render();
          box.classList.add('open');
          // The page behind stays still while a photo is open
          document.documentElement.style.overflow = 'hidden';
          closeBtn.focus();
        };
        const close = () => {
          box.classList.remove('open');
          document.documentElement.style.overflow = '';
          lastFocus?.focus();
        };
        const step = (d: number) => {
          current = (current + d + items.length) % items.length;
          render();
        };

        triggers.forEach((t, i) => t.addEventListener('click', () => open(i)));
        closeBtn.addEventListener('click', close);
        box.querySelector('.lightbox-prev')!.addEventListener('click', () => step(-1));
        box.querySelector('.lightbox-next')!.addEventListener('click', () => step(1));
        box.addEventListener('click', (e) => {
          if (e.target === box) close();
        });
        document.addEventListener('keydown', (e) => {
          if (!box.classList.contains('open')) return;
          if (e.key === 'Escape') close();
          else if (e.key === 'ArrowRight') step(1);
          else if (e.key === 'ArrowLeft') step(-1);
          else if (e.key === 'Tab') {
            // Keep focus inside the viewer while it is open
            const i = buttons.indexOf(document.activeElement as HTMLElement);
            const next = (i + (e.shiftKey ? -1 : 1) + buttons.length) % buttons.length;
            buttons[next].focus();
            e.preventDefault();
          }
        });
      }
    </script>
  </body>
</html>
