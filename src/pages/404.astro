---
// Served for any address that doesn't exist (Netlify picks up 404.html).
// One page for every language, so the Chinese lines sit below the English.
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/utility.css';
---

<BaseLayout
  title="Page not found"
  description="This page doesn't exist on the AI For Good website."
  pageClass="page-utility"
  noindex
>
  <section class="page-top">
    <div class="container prose">
      <p class="kicker">Page not found</p>
      <h1>This page isn't here</h1>
      <p class="lead">
        The link may be out of date, or the page may have moved. These are
        good places to start:
      </p>
      <ul class="next-links">
        <li><a class="link-quiet" href="/">Home →</a></li>
        <li><a class="link-quiet" href="/policy">Policy →</a></li>
        <li><a class="link-quiet" href="/teaching">Teaching →</a></li>
        <li><a class="link-quiet" href="/get-involved">Contact →</a></li>
      </ul>
      <div class="other-langs">
        <p lang="zh-Hant-HK">找不到這個頁面。<a href="/zh/">前往繁體中文首頁 →</a></p>
        <p lang="zh-Hans">找不到这个页面。<a href="/zh-hans/">前往简体中文首页 →</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
