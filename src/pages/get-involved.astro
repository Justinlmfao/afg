---
// Contact page: the email address, who usually writes to us, and the form.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTop from '../components/PageTop.astro';
import '../styles/pages/contact.css';
import { contactEmail, contactForm } from '../data/facts';
import { getLangFromUrl, ui } from '../i18n';

const t = ui[getLangFromUrl(Astro.url)];
---

<BaseLayout
  title="Contact"
  pageClass="page-contact"
  description="Get in touch with AI For Good: students who want to research or teach, schools and partners, and anyone else."
>
  <PageTop vertical="聯絡">
    <h1>Get in touch.</h1>
    <p class="lead">
      Email us at <a href={`mailto:${contactEmail}`}>{contactEmail}</a> or fill in the form below. We're
      based in Hong Kong. We usually reply within a week.
    </p>
  </PageTop>

  <!-- Who writes to us sits in the margin column beside the form -->
  <section class="sec">
    <div class="wrap rail">
      <ul class="routes">
        <li id="students">
          <h2>Students</h2>
          <p>
            Want to do real research or teach? We care more about the work than about titles. Tell us what
            you'd like to work on.
          </p>
        </li>
        <li id="schools">
          <h2>Schools &amp; partners</h2>
          <p>
            If you run a school or programme for children from underprivileged families, we'd love to work
            with you. We'll bring the lessons, the tutors and the equipment.
          </p>
        </li>
        <li>
          <h2>Everyone else</h2>
          <p>Press, partnerships or just a question: write to us.</p>
        </li>
      </ul>

      <!--
        Messages go to Formspree (the address is contactForm in
        src/data/facts.ts), which emails them on. The hidden _gotcha field
        catches simple spam bots: people never see it, so anything typed in
        it marks the message as spam. Both languages use the same form.
      -->
      <form
        method="POST"
        action={contactForm}
        data-thanks="/thanks/"
        class="contact-form"
      >
        <input type="hidden" name="_subject" value="Message from the AI For Good website" />
        <p class="hidden-field" aria-hidden="true">
          <label>
            Don't fill this out if you're human: <input name="_gotcha" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <div class="field">
          <label for="name">Name</label>
          <input id="name" type="text" name="name" autocomplete="name" required />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input id="email" type="email" name="email" autocomplete="email" required />
        </div>

        <div class="field">
          <label for="organization">Organisation <span class="optional">(optional)</span></label>
          <input id="organization" type="text" name="organization" autocomplete="organization" />
        </div>

        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>

        <button type="submit" class="btn" data-sending={t.sending}>Send message</button>
        <p class="form-error" role="alert" hidden>{t.formError}</p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  // Sends the form without leaving the page, then shows our own thank-you
  // page. While it sends, the button says so and can't be pressed twice. The
  // browser's own checks run first, so this only runs on a valid form.
  // Without this script the form still sends, and Formspree shows its own
  // confirmation page instead.
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const error = form?.querySelector<HTMLElement>('.form-error');
  const idleText = button?.textContent;

  const reset = () => {
    if (!button) return;
    button.disabled = false;
    button.removeAttribute('aria-busy');
    button.textContent = idleText || '';
  };

  form?.addEventListener('submit', async (event) => {
    if (!button) return;
    event.preventDefault();
    button.disabled = true;
    button.setAttribute('aria-busy', 'true');
    button.textContent = button.dataset.sending || '';
    if (error) error.hidden = true;
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(String(response.status));
      window.location.href = form.dataset.thanks || '/thanks/';
    } catch {
      reset();
      if (error) error.hidden = false;
    }
  });

  // Coming back with the browser's Back button restores a usable form
  window.addEventListener('pageshow', reset);
</script>
