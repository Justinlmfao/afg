---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, ui } from '../i18n';
import '../styles/pages/contact.css';

// Contact address chosen by Justin (school-affiliated).
const email = 'ps20153216@student.vsa.edu.hk';
const t = ui[getLangFromUrl(Astro.url)];
---

<BaseLayout
  title="Contact"
  description="Get in touch with AI For Good: students who want to research or teach, schools and partners, and anyone else."

  pageClass="page-contact">
  <section class="page-top">
    <div class="container prose">
      <p class="kicker">Contact</p>
      <h1>Get in touch</h1>
      <p class="lead">
        Email us at <a href={`mailto:${email}`}>{email}</a> or fill in the form
        below. We're based in Hong Kong.
      </p>
    </div>
  </section>

  <!-- Who writes to us sits in the margin column beside the form -->
  <section>
    <div class="container rail">
      <ul class="routes rail-head">
        <li>
          <h2>Students</h2>
          <p>
            Want to do real research or teach? We care more about the work than
            about titles. Tell us what you'd like to work on.
          </p>
        </li>
        <li>
          <h2>Schools &amp; partners</h2>
          <p>
            If you run a school or programme for children from underprivileged
            families, we'd love to work with you. We'll bring the lessons, the
            tutors and the equipment.
          </p>
        </li>
        <li>
          <h2>Everyone else</h2>
          <p>Press, partnerships or just a question: write to us.</p>
        </li>
      </ul>

      <!--
        Netlify Forms: `data-netlify` + the hidden `form-name` input let
        Netlify capture submissions with no backend; the honeypot filters
        simple bots. Submissions appear in the Netlify dashboard under Forms.
      -->
      <form
        name="contact"
        method="POST"
        action="/thanks/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="contact-form rail-body"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden-field" aria-hidden="true">
          <label>
            Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <div class="field">
          <label for="name">Name</label>
          <input id="name" type="text" name="name" autocomplete="name" required />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input id="email" type="email" name="email" autocomplete="email" required />
        </div>

        <div class="field">
          <label for="organization">Organisation <span class="optional">(optional)</span></label>
          <input id="organization" type="text" name="organization" autocomplete="organization" />
        </div>

        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>

        <button type="submit" class="btn btn-policy" data-sending={t.sending}>
          <span class="btn-label">Send message</span> <span class="arrow" aria-hidden="true">→</span>
        </button>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  // While the form sends, the button says so and can't be pressed twice.
  // The browser's own checks run first, so this only fires on a valid form.
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const buttonLabel = button?.querySelector('.btn-label');
  const idleText = buttonLabel?.textContent;
  form?.addEventListener('submit', () => {
    if (!button || !buttonLabel) return;
    button.disabled = true;
    button.setAttribute('aria-busy', 'true');
    buttonLabel.textContent = button.dataset.sending || '';
  });
  // Coming back with the browser's Back button restores a usable form
  window.addEventListener('pageshow', () => {
    if (!button || !buttonLabel) return;
    button.disabled = false;
    button.removeAttribute('aria-busy');
    buttonLabel.textContent = idleText || '';
  });
</script>

