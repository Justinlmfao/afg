---
import BaseLayout from '../layouts/BaseLayout.astro';

// Contact address chosen by Justin (school-affiliated).
const email = 'ps20153216@student.vsa.edu.hk';
---

<BaseLayout
  title="Contact"
  description="Contact AI For Good — for students who want to research or teach, schools and partners, and everyone else."
>
  <section class="page-top">
    <div class="container prose">
      <p class="kicker">Contact</p>
      <h1>Get in touch</h1>
      <p class="lead">
        Email <a href={`mailto:${email}`}>{email}</a> or use the form below.
        Based in Hong Kong.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <ul class="routes">
        <li>
          <h2>Students</h2>
          <p>
            Want to do real research or teach? We look for people who care more
            about the work than the title. Tell us what you'd want to work on.
          </p>
        </li>
        <li>
          <h2>Schools &amp; partners</h2>
          <p>
            If you run a school or programme serving underprivileged students,
            we'd like to work with you. We bring the curriculum, the tutors,
            and the equipment.
          </p>
        </li>
        <li>
          <h2>Everyone else</h2>
          <p>Press, collaboration, or questions — write to us.</p>
        </li>
      </ul>

      <!--
        Netlify Forms: `data-netlify` + the hidden `form-name` input let
        Netlify capture submissions with no backend; the honeypot filters
        simple bots. Submissions appear in the Netlify dashboard under Forms.
      -->
      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="contact-form"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden-field">
          <label>
            Don't fill this out if you're human: <input name="bot-field" />
          </label>
        </p>

        <div class="field">
          <label for="name">Name</label>
          <input id="name" type="text" name="name" required />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input id="email" type="email" name="email" required />
        </div>

        <div class="field">
          <label for="organization">Organisation <span class="optional">(optional)</span></label>
          <input id="organization" type="text" name="organization" />
        </div>

        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>

        <button type="submit" class="btn btn-policy">
          Send message <span class="arrow">→</span>
        </button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .page-top {
    border-bottom: 1px solid var(--rule);
  }

  .routes {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 2.75rem;
  }

  .routes h2 {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }

  .routes p {
    color: var(--graphite);
  }

  .contact-form {
    max-width: var(--measure);
    border-top: 1px solid var(--rule);
    padding-top: 2rem;
  }

  .field {
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .optional {
    color: var(--graphite);
    font-weight: 400;
  }

  .field input,
  .field textarea {
    font-family: inherit;
    font-size: 1rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .field input:focus,
  .field textarea:focus {
    border-color: var(--policy);
    box-shadow: 0 0 0 3px rgba(47, 93, 147, 0.15);
    outline: none;
  }

  .field textarea {
    resize: vertical;
  }

  .hidden-field {
    position: absolute;
    left: -9999px;
  }

  @media (max-width: 52rem) {
    .routes {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
