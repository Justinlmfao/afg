---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/team.css';
import { getCollection, render } from 'astro:content';

// Team members from src/content/team/ (drafts excluded), sorted by `order`.
// The Markdown body of each file is that person's bio; pressing their name
// opens it. Anyone without a bio is still listed, just without the toggle.
const members = await Promise.all(
  (await getCollection('team'))
    .filter((m) => !m.data.draft)
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (m) => ({
      name: m.data.name,
      role: m.data.role,
      Bio: m.body?.trim() ? (await render(m)).Content : null,
    }))
);
---

<BaseLayout
  title="Team"
  description="AI For Good is run entirely by students: more than 35 members working on policy research and tutoring."

  pageClass="page-team">
  <section class="page-top">
    <div class="container prose">
      <p class="kicker">Team</p>
      <h1>Run entirely by students</h1>
      <p class="lead">
        More than 35 of us work on policy research and tutoring. These are the
        people who lead the work. Press a name to read more about them.
      </p>
    </div>
  </section>

  <!-- The leads. Each name opens its bio: native <details>, so it works
       without JavaScript and from the keyboard. -->
  <section class="section-tight">
    <div class="container">
      <div class="people">
        {
          members.map(({ name, role, Bio }) =>
            Bio ? (
              <details class="person">
                <summary>
                  <span class="person-head">
                    <h2 class="person-name">{name}</h2>
                    <span class="person-role">{role}</span>
                  </span>
                  <span class="person-toggle" aria-hidden="true" />
                </summary>
                <div class="person-bio">
                  <Bio />
                </div>
              </details>
            ) : (
              <div class="person person-static">
                <span class="person-head">
                  <h2 class="person-name">{name}</h2>
                  <span class="person-role">{role}</span>
                </span>
              </div>
            )
          )
        }
      </div>
    </div>
  </section>

  <!-- Team photographs -->
  <section class="section-tight">
    <div class="container team-photos">
      <figure>
        <img
          src="/programs/team-classroom.jpg"
          alt="Six AI For Good members in a classroom at Ho Man Tin Ling To Catholic School after a session."
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure>
        <img
          src="/programs/team-outside-school.jpg"
          alt="Five AI For Good members outside Ho Man Tin Ling To Catholic School."
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>
</BaseLayout>
