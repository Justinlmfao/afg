---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Team members from src/content/team/ (drafts excluded), sorted by `order`.
const members = (await getCollection('team'))
  .filter((m) => !m.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Team"
  description="AI For Good is run entirely by students — 35+ members across research, partnerships, and technical teams."
>
  <section class="page-top">
    <div class="container prose">
      <p class="kicker">Team</p>
      <h1>Run entirely by students</h1>
      <p class="lead">
        35+ members work across policy research and the tutoring programme.
        The people who lead it:
      </p>
    </div>
  </section>

  <!-- Team photographs -->
  <section class="section-tight">
    <div class="container team-photos">
      <figure>
        <img
          src="/programs/team-classroom.jpg"
          alt="Six AI For Good members in a classroom at Ho Man Tin Ling To Catholic School after a session."
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure>
        <img
          src="/programs/team-outside-school.jpg"
          alt="Five AI For Good members outside Ho Man Tin Ling To Catholic School."
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <ul class="team-list">
        {
          members.map((person) => (
            <li class="member">
              <p class="member-name">{person.data.name}</p>
              <p class="member-role">{person.data.role}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .page-top {
    border-bottom: 1px solid var(--rule);
  }

  .team-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .team-photos figure {
    margin: 0;
  }

  .team-photos img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
  }

  @media (max-width: 46rem) {
    .team-photos {
      grid-template-columns: 1fr;
    }
  }

  .team-list {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
    border-top: 1px solid var(--rule);
  }

  .member {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--rule);
  }

  .member-name {
    font-family: var(--serif);
    font-size: 1.35rem;
  }

  .member-role {
    color: var(--graphite);
    font-weight: 600;
    font-size: 0.95rem;
  }

  @media (max-width: 34rem) {
    .member {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
