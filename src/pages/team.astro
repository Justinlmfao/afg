---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Team members from src/content/team/ (drafts excluded), sorted by `order`.
const members = (await getCollection('team'))
  .filter((m) => !m.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Team"
  description="AI For Good is run entirely by students — 35+ members across research, partnerships, and technical teams."
>
  <section class="page-top">
    <div class="container prose">
      <p class="kicker">Team</p>
      <h1>Run entirely by students</h1>
      <p class="lead">
        35+ members work across research, partnerships, and the technical side
        of the tutoring curriculum. The people who lead it:
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <ul class="team-list">
        {
          members.map((person) => (
            <li class="member">
              <p class="member-name">{person.data.name}</p>
              <p class="member-role">{person.data.role}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .page-top {
    border-bottom: 1px solid var(--rule);
  }

  .team-list {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
    border-top: 1px solid var(--rule);
  }

  .member {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--rule);
  }

  .member-name {
    font-family: var(--serif);
    font-size: 1.35rem;
  }

  .member-role {
    color: var(--graphite);
    font-weight: 600;
    font-size: 0.95rem;
  }

  @media (max-width: 34rem) {
    .member {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
