---
// GENERATED FILE — do not edit by hand.
// Run `npm run zh-hans` to rebuild this from src/pages/zh/.
// Simplified Chinese Teaching page. Shares src/styles/pages/teaching.css
// with the English page. Module copy comes from the *_zh fields in
// src/content/programs/. Keep each Chinese paragraph on one source line.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTop from '../../components/PageTop.astro';
import OnThisPage from '../../components/OnThisPage.astro';
import Case from '../../components/Case.astro';
import Steps from '../../components/Steps.astro';
import Annotated from '../../components/Annotated.astro';
import Gallery from '../../components/Gallery.astro';
import MarginNote from '../../components/MarginNote.astro';
import '../../styles/pages/teaching.css';
import { getCollection } from 'astro:content';
import { facts, showSamples } from '../../data/facts';
import { getLangFromUrl, ui } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const f = facts;

const modules = (await getCollection('programs'))
  .filter((m) => !m.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .map((m) => m.data);
---

<BaseLayout
  title="教学计划"
  pageClass="page-teaching"
  description="为香港基层家庭的小学生提供免费补习。43 位受训学生导师在 7 所学校教过 350 个孩子；自 2024 年起，86% 的学生至少升了一个组别。"
>
  <PageTop vertical="教学">
    <h1>免费补习：孩子先自己尝试，再问人工智能。</h1>
    <p class="lead">
      我们的学生导师在全港各区为基层家庭的小学生上课。每个科目都配上人工智能，让孩子多了一个免费、有耐性、课后也能继续用的学习伙伴。
    </p>
    <OnThisPage
      items={[
        { href: '#how-it-started', label: '怎样开始' },
        { href: '#think-first', label: 'Think First 先想后问' },
        { href: '#promises', label: '我们的承诺' },
        { href: '#modules', label: '四个单元' },
        { href: '#sample-lesson', label: '示范课堂' },
        { href: '#where-we-teach', label: '在哪里教' },
      ]}
    />
  </PageTop>

  <section class="sec" aria-labelledby="how-it-started">
    <div class="wrap">
      <Case
        id="how-it-started"
        title="我们为什么教，又带来了什么改变。"
        noticed={{
          date: '2023',
          text: '在香港，课后的额外辅导通常要花钱。付得起补习费的家庭会请补习，付不起的，只能看着孩子落后。一位有耐性的人工智能导师可以改变这一点，但前提是有人教孩子怎样好好使用它。',
        }}
        did={{
          date: '2024/2026',
          text: `我们培训了 ${f.tutors.value} 位中学生导师，在${f.schools.word.zh}所学校教过 ${f.children.value} 个孩子，共四个单元（数学、英文、经济和科学），每一节课都以 Think First 先想后问为基础。`,
        }}
        changed={{
          dateLabel: `自 ${f.bandUp.since} 年起`,
          status: 'changed',
          figure: `${f.bandUp.value}${f.bandUp.unit}`,
          text: '的学生至少升了一个组别。',
        }}
      >
        <Fragment slot="changed-note">
          <MarginNote label="关于这个数字。" id="results">这不是我们一个人的功劳。老师、家长和学生自己都付出了努力。但这是我们用来要求自己的数字。</MarginNote>
          {
            showSamples && f.bandUp.method.sample && (
              <MarginNote label="我们怎样计算。">
                <span class="sample-tag" data-sample>{ui[lang].sample}</span>
                {f.bandUp.method.zh}
              </MarginNote>
            )
          }
          {!f.bandUp.method.sample && <MarginNote label="我们怎样计算。">{f.bandUp.method.zh}</MarginNote>}
        </Fragment>
      </Case>

      <figure class="quote">
        <blockquote>
          <p>
            我们去天主教领岛学校之前，以为要花很多力气，才能说服一班孩子人工智能和时事跟他们有关。我们错了。他们不是没有兴趣，只是从来没有人给过他们机会。不到一小时，他们已经在争论一个演算法算不算公平。他们从来不缺好奇心，缺的是机会。
          </p>
        </blockquote>
        <figcaption>我们的一位导师，在天主教领岛学校上完一节课之后</figcaption>
      </figure>
    </div>
  </section>

  <section class="sec" aria-labelledby="think-first">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="think-first">每一节课，都跟从同样的四个步骤。</h2>
        <p>
          工具有多大用处，要看孩子懂不懂得好好使用。一个直接问人工智能要答案的孩子，什么也学不到；一个先自己尝试、再问提示、最后用自己的话解释答案的孩子，学到的会比自己一个人学更多。教会孩子分辨这两种用法，就是我们的导师在做的事。我们把它叫做 Think First 先想后问。
        </p>
      </div>
      <Steps
        items={[
          { name: '尝试', text: '孩子先自己试着解题。' },
          { name: '提问', text: '他们只问人工智能要提示或核对，永远不直接问答案。' },
          { name: '核对', text: '他们比较人工智能的回应和自己的做法，找出不同之处。' },
          { name: '解释', text: '关掉人工智能后，用自己的话解释答案。' },
        ]}
      />

      <p class="sheet-intro">
        这是我们其中一节课的工作纸：孩子比较自己常玩的游戏里的两个角色，再论证哪一个比较好。
      </p>
      <Annotated
        notes={[
          '数字由孩子从自己的游戏画面读出来，所以数据是他们自己的。',
          '意想不到的结果：通常是较快的角色胜出。单看一个数字，说明不了太多。',
          '诚实地替另一方写一句。这和我们写每一份建议书时用的规矩一样。',
        ]}
      />

      <p class="closing-line">
        孩子能在没有人工智能的情况下解释，就代表学会了；做不到的话，我们就退回上一步。
      </p>
    </div>
  </section>

  <section class="sec" aria-labelledby="promises">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="promises">学校和家长可以放心的事。</h2>
      </div>
      <ul class="promise-list">
        <li>导师上课时，一定有学校或中心的职员在场。</li>
        <li>我们不收集儿童的个人资料。</li>
        <li>我们只使用合作学校批准的人工智能工具。</li>
        <li>教学永远免费。</li>
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="modules">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="modules">四个学科，每一科都以人工智能作为学习伙伴。</h2>
        <p>
          我们不把人工智能当作独立的科目来教。我们的导师都是中学生，完成 AFG 的培训后才开始教学，并以小组形式上课，让每个孩子都得到照顾。
        </p>
      </div>
      <ul class="module-list">
        {
          modules.map((m) => (
            <li class="module">
              <h3>{m.title_hans ?? m.title}</h3>
              <p>{m.summary_hans ?? m.summary}</p>
              {m.why_hans && (
                <p class="module-why">
                  <b>有什么帮助：</b>{m.why_hans}
                </p>
              )}
              {m.body_hans && (
                <details>
                  <summary>这个单元的详情</summary>
                  <div class="prose">
                    <p>{m.body_hans}</p>
                  </div>
                </details>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="sample-lesson">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="sample-lesson">一节课，由头到尾。</h2>
      </div>
      <div class="prose">
        <p>
          <strong>数字大，不代表比较强：</strong>一节 60 分钟的课，对象是小五至小六学生，用上数学和英文，每 8–10 位学生配 2 位导师。我们把它公开，让学校在邀请我们之前，先看看一节课是怎样设计的。
        </p>
        <p><a class="textlink" href="/zh-hans/teaching/sample-lesson">完整教案</a></p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="where-we-teach">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="where-we-teach">我们在哪里教。</h2>
      </div>
      <div>
        <p class="prose">
          我们上课的小学包括何文田的<strong>天主教领岛学校</strong>和 <strong>Kennedy Town School</strong>，也和社区伙伴 <strong>St. Barnabas' Home &amp; Society</strong> 及 <strong>10% Organisation</strong> 合作。
        </p>
        <div class="place-gallery">
          <Gallery
            photos={[
              {
                name: 'teaching-ai-tools.jpg',
                alt: '两位导师介绍人工智能助手可以做什么：搜寻资料、拆解难题，以及协助写作。',
                caption: '在天主教领岛学校，介绍人工智能助手可以做什么。',
              },
              {
                name: 'teaching-english-careers.jpg',
                alt: '两位导师教英文单元，幻灯片说明英文怎样在医疗、贸易、科技和旅游业打开就业之门。',
                caption: '英文单元。',
              },
              {
                name: 'teaching-exploring-interests.jpg',
                alt: '一位导师示范怎样用人工智能探索自己的兴趣，由恐龙、太空到音乐。',
                caption: '用人工智能探索自己的兴趣。',
              },
            ]}
          />
        </div>

        <h3 class="place-h">与沪江维多利亚学校合作</h3>
        <p class="prose">
          除了在小学上课，我们也和沪江维多利亚学校合办课程，对象是社区里的年轻人。
        </p>
        <dl class="years">
          <div>
            <dt>2024–25</dt>
            <dd>教学生在自己的社区里运用人工智能：这些工具擅长做什么，以及怎样用它们做些真正有用的事。</dd>
          </div>
          <div>
            <dt>2025–26</dt>
            <dd>教社区里的孩子，人工智能可以令哪些事情变得更好，以及怎样分辨和避开它被滥用的情况。</dd>
          </div>
        </dl>
        <div class="place-gallery">
          <Gallery
            photos={[
              {
                name: 'vsa-2025-26-poster.jpg',
                alt: '学生制作海报，列出一个问题、一个人工智能方案，以及怎样落实。',
                caption: '学生构思怎样用人工智能处理社区里的一个问题，2025–26 年度。',
              },
              {
                name: 'vsa-2024-25-group.jpg',
                alt: '2024–25 年度课程结束时，导师和学生在一张感谢大家参加的幻灯片前合照。',
                caption: '2024–25 年度课程的最后一节。',
              },
              {
                name: 'vsa-2025-26-cohort.jpg',
                alt: '2025–26 年度的学生和导师在教室里合照。',
                caption: '学生和导师，2025–26 年度。',
              },
            ]}
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
