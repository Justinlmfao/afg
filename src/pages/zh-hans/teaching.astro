// src/content/programs/. Keep each Chinese paragraph on one source line.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTop from '../../components/PageTop.astro';
import OnThisPage from '../../components/OnThisPage.astro';
import Case from '../../components/Case.astro';
import Steps from '../../components/Steps.astro';
import Annotated from '../../components/Annotated.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import MarginNote from '../../components/MarginNote.astro';
import Lesson from './_lesson.astro';
import '../../styles/pages/teaching.css';
import { getCollection } from 'astro:content';
import { facts, showSamples } from '../../data/facts';
import { getLangFromUrl, ui } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const f = facts;

const modules = (await getCollection('programs'))
  .filter((m) => !m.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .map((m) => m.data);

// Photos from sessions at Ho Man Tin Ling To Catholic School. The first is
// shown large.
const photos = [
  { name: 'teaching-classroom.jpg', alt: '导师在天主教领岛学校授课，一名学生举手回答。', position: '60% 40%' },
  { name: 'teaching-chalkboard-maths.jpg', alt: '导师在黑板上示范 1117 × 1117 的心算捷径。' },
  { name: 'teaching-ai-study-partner.jpg', alt: '导师手持笔记本电脑，示范如何向人工智能大声讲解一个数学概念，借此检查自己是否真的明白。' },
  { name: 'teaching-ai-tools.jpg', alt: '两位导师介绍人工智能助理可以做什么：查找资料、拆解难题，以及协助写作。' },
  { name: 'teaching-exploring-interests.jpg', alt: '导师示范如何用人工智能探索自己的兴趣，由恐龙、太空到音乐。' },
  { name: 'teaching-english-careers.jpg', alt: '两位导师教授英文单元，幻灯片说明英文如何在医疗、贸易、科技与旅游业打开职业大门。' },
];

// Sessions run at Victoria Shanghai Academy, grouped by year: six each.
const cohorts = [
  {
    years: '2024–25',
    summary: '教学生在自己的社区里运用人工智能：这些工具擅长做什么，以及怎样用它们做些真正有用的事。',
    photos: [
      { name: 'vsa-2024-25-group.jpg', alt: '2024/25 年度课程结束时，导师与学生在感谢参加者的幻灯片前合照。' },
      { name: 'vsa-2024-25-presenting.jpg', alt: '两位导师在 2024/25 年度的一节课上向使用笔记本电脑的学生讲解。' },
      { name: 'vsa-2024-25-activity.jpg', alt: '导师在屏幕上展示范例，说明人工智能影像工具如何把一张图片转换成另一张。' },
      { name: 'vsa-2024-25-helping-pair.jpg', alt: '导师俯身协助两名一起使用笔记本电脑的学生。' },
      { name: 'vsa-2024-25-helping.jpg', alt: '导师协助一名使用笔记本电脑的年幼学生。', position: '50% 35%' },
      { name: 'vsa-2024-25-side-by-side.jpg', alt: '导师与学生并肩在笔记本电脑前完成练习。', position: '50% 35%' },
    ],
  },
  {
    years: '2025–26',
    summary: '教社区里的孩子，人工智能可以令哪些事情变得更好，以及怎样分辨和避开它被滥用的情况。',
    photos: [
      { name: 'vsa-2025-26-group.jpg', alt: '年度结束时，导师在写着“Thanks for joining — A.I. For Good 25–26”的白板前合照。' },
      { name: 'vsa-2025-26-cohort.jpg', alt: '2025/26 年度的学生与导师在教室内合照。' },
      { name: 'vsa-2025-26-uses.jpg', alt: '导师展示人工智能的用途例子，包括缓解交通、预测天灾，以及为基层学生提供辅导。', position: '50% 35%' },
      { name: 'vsa-2025-26-poster.jpg', alt: '学生制作海报，列出问题、人工智能的解决方案，以及实行方式。' },
      { name: 'vsa-2025-26-discussion.jpg', alt: '导师与学生在笔记本电脑前讨论作业。' },
      { name: 'vsa-2025-26-helping.jpg', alt: '导师在课堂上协助一名使用笔记本电脑的学生。' },
    ],
  },
];
---

<BaseLayout
  title="教学计划"
  pageClass="page-teaching tone-teaching"
  description="为香港基层家庭的小学生提供免费补习。43 位受训学生导师在 7 所学校教过 350 个孩子；自 2024 年起，86% 的学生至少升了一个组别。"
>
  <PageTop vertical="教学" band>
    <h1>免费补习：<wbr />孩子先自己尝试，<wbr />再问人工智能。</h1>
    <p class="lead">
      我们的学生导师在全港各区为基层家庭的小学生上课。每个科目都配上人工智能，让孩子多了一个免费、有耐性、课后也能继续用的学习伙伴。
    </p>
    <OnThisPage
      items={[
        { href: '#why-we-teach', label: '为什么教' },
        { href: '#think-first', label: 'Think First 先想后问' },
        { href: '#modules', label: '四个单元' },
        { href: '#sample-lesson', label: '示范课堂' },
        { href: '#where-we-teach', label: '在哪里教' },
        { href: '#in-the-classroom', label: '教室里' },
      ]}
    />
  </PageTop>

  <section class="sec" aria-labelledby="the-programme">
    <div class="wrap">
      <Case
        id="the-programme"
        title="我们为什么教，又带来了什么改变。"
        noticed={{
          date: '2023',
          text: '在香港，课后的额外辅导通常要花钱。付得起补习费的家庭会请补习，付不起的，只能看着孩子落后。一位有耐性的人工智能导师可以改变这一点，但前提是有人教孩子怎样好好使用它。',
        }}
        did={{
          date: '2024/2026',
          text: `我们培训了 ${f.tutors.value} 位中学生导师，在${f.schools.word[lang]}所学校教四个单元（数学、英文、经济和科学），每一节课都以 Think First 先想后问为基础。`,
        }}
        changed={{
          dateLabel: `自 ${f.bandUp.since} 年起`,
          status: 'changed',
          figure: `${f.bandUp.value}${f.bandUp.unit}`,
          text: `的学生自 ${f.bandUp.since} 年起，至少升了一个组别。`,
        }}
      >
        <Fragment slot="changed-note">
          <p class="quiet-facts">教过 {f.children.value} 个孩子 · {f.schools.value} 所学校 · {f.tutors.value} 位受训导师</p>
          <MarginNote id="results">这 {f.bandUp.value}{f.bandUp.unit} 不是我们一个人的功劳。老师、家长和学生自己都付出了努力。但这是我们用来要求自己的数字。</MarginNote>
          {
            showSamples && f.bandUp.method.sample && (
              <MarginNote label="我们怎样计算。">
                <span class="sample-tag" data-sample>{ui[lang].sample}</span>
                {f.bandUp.method[lang]}
              </MarginNote>
            )
          }
          {!f.bandUp.method.sample && <MarginNote label="我们怎样计算。">{f.bandUp.method[lang]}</MarginNote>}
        </Fragment>
      </Case>
    </div>
  </section>

  <section class="sec" aria-labelledby="why-we-teach">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="why-we-teach">我们为什么教</h2>
      </div>
      <div class="prose">
        <p class="tagline">每个请不起补习的孩子，都值得一位免费导师。</p>
        <p>
          在香港，课后的额外辅导通常要花钱。付得起补习费的家庭会请补习，付不起的，只能看着孩子落后。人工智能改变了这一点：第一次，一位能用五种方法解释同一条题目、又有耐性的导师，可以免费得到。
        </p>
        <p>
          但工具有多大用处，要看孩子懂不懂得好好使用。一个直接问人工智能要答案的孩子，什么也学不到；一个先自己尝试、再问提示、最后用自己的话解释答案的孩子，学到的会比自己一个人学更多。教会孩子分辨这两种用法，就是我们的导师在做的事。
        </p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="a-moment">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="a-moment">课堂上的一刻</h2>
      </div>
      <figure class="quote">
        <blockquote>
          <p>
            我们去天主教领岛学校之前，以为要花很多力气，才能说服一班孩子人工智能和时事跟他们有关。我们错了。他们不是没有兴趣，只是从来没有人给过他们机会。不到一小时，他们已经在争论一个演算法算不算公平。他们从来不缺好奇心，缺的是机会。
          </p>
        </blockquote>
        <figcaption>我们的一位导师，在天主教领岛学校上完一节课之后</figcaption>
      </figure>
    </div>
  </section>

  <section class="sec washed" aria-labelledby="think-first">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker-date">我们怎样教：Think First 先想后问</p>
        <h2 id="think-first">每一节课，<wbr />都跟从同样的<wbr />四个步骤。</h2>
        <p>每一节用到人工智能的课，都跟从同样的四个步骤。</p>
      </div>
      <Steps
        items={[
          { name: '尝试', text: '孩子先自己试着解题。' },
          { name: '提问', text: '他们只问人工智能要提示或核对，永远不直接问答案。' },
          { name: '核对', text: '他们比较人工智能的回应和自己的做法，找出不同之处。' },
          { name: '解释', text: '关掉人工智能后，用自己的话解释答案。' },
        ]}
      />

      <p class="sheet-intro">
        这是我们其中一节课的工作纸：孩子比较自己常玩的游戏里的两个角色，再论证哪一个比较好。
      </p>
      <Annotated
        notes={[
          '数字由孩子从自己的游戏画面读出来，所以数据是他们自己的。',
          '意想不到的结果：通常是较快的角色胜出。单看一个数字，说明不了太多。',
          '诚实地替另一方写一句。这和我们写每一份提案时用的规矩一样。',
        ]}
      />

      <div class="prose">
        <p class="closing-line">
          孩子能在没有人工智能的情况下解释，就代表学会了；做不到的话，我们就退回上一步。
        </p>
        <p>
          我们不把人工智能当作独立的科目来教。我们教数学、英文、经济和科学，再让孩子看到人工智能可以怎样帮助他们学好每一科。我们的导师都是中学生，完成 AFG 的培训后才开始教学，并以小组形式上课，让每个孩子都得到照顾。
        </p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="modules">
    <div class="wrap rail">
      <div class="rail-head">
        <p class="kicker-date">我们的四个单元</p>
        <h2 id="modules">四个学科，<wbr />每一科都以<wbr />人工智能<wbr />作为学习伙伴。</h2>
        <p>每个单元都把一个学科和人工智能配合起来，目的是缩小我们的学生和家境较好的同龄人之间的差距，而不是令它扩大。</p>
      </div>
      <ul class="module-list">
        {
          modules.map((m) => (
            <li class="module">
              <h3>{m.title_hans ?? m.title}</h3>
              <div class="prose">
                <p>{m.body_hans}</p>
              </div>
              {m.why_hans && (
                <p class="module-why">
                  <b>有什么帮助：</b>{m.why_hans}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec washed" aria-labelledby="sample-lesson">
    <div class="wrap">
      <div class="rail lesson-top">
        <div class="rail-head">
          <p class="kicker-date">示范课堂</p>
          <h2 id="sample-lesson">数字大，<wbr />不代表比较强</h2>
        </div>
        <div>
          <p class="prose">
            这节课用上了上面的<strong>数学</strong>和<strong>英文</strong>单元。我们把它公开，让学校在邀请我们之前，先看看一节课是怎样设计的。
          </p>
          <ul class="lesson-facts">
            <li><span>程度</span>小五至小六</li>
            <li><span>时长</span>60 分钟</li>
            <li><span>人手</span>每 8–10 位学生配 2 位导师</li>
          </ul>
          <p><a class="more" href="/zh-hans/teaching/sample-lesson">独立一页的教案，附可列印的工作纸</a></p>
        </div>
      </div>
      <Lesson />
    </div>
  </section>

  <section class="sec" aria-labelledby="where-we-teach">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="where-we-teach">我们在哪里教</h2>
      </div>
      <p class="prose">
        我们在七所学校上课，包括何文田的<strong>天主教领岛学校</strong>和 <strong>Kennedy Town School</strong>，也和社区伙伴 <strong>St. Barnabas' Home &amp; Society</strong> 及 <strong>10% Organisation</strong> 合作。
      </p>
    </div>
  </section>

  <section class="sec" aria-labelledby="promises">
    <div class="wrap rail">
      <div class="rail-head">
        <p class="kicker-date">我们对学校和家长的承诺</p>
        <h2 id="promises">学校和家长<wbr />可以放心的事。</h2>
      </div>
      <ul class="promise-list">
        <li>导师上课时，一定有学校或中心的职员在场。</li>
        <li>我们不收集儿童的个人资料。</li>
        <li>我们只使用合作学校批准的人工智能工具。</li>
        <li>教学永远免费。</li>
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="in-the-classroom">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="in-the-classroom">教室里</h2>
        <p>我们的导师在天主教领岛学校上课。</p>
      </div>
      <PhotoGrid photos={photos} feature />
    </div>
  </section>

  <section class="sec" aria-labelledby="with-vsa">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="with-vsa">与沪江维多利亚学校<wbr />合作</h2>
        <p>除了在小学上课，我们也和沪江维多利亚学校合办课程，对象是社区里的年轻人。</p>
      </div>
      <div>
        {
          cohorts.map((cohort) => (
            <div class="cohort">
              <h3>{cohort.years}</h3>
              <p class="prose">{cohort.summary}</p>
              <PhotoGrid photos={cohort.photos} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sec washed" aria-label="参与我们">
    <div class="wrap">
      <div class="halves-plain cta-pair">
        <div>
          <h2>邀请我们到你的学校</h2>
          <p>如果你负责一间小学、社区中心或儿童计划，希望为学生提供免费补习，欢迎联系我们。</p>
          <a class="btn" href="/zh-hans/get-involved#schools">联系我们</a>
        </div>
        <div>
          <h2>成为导师</h2>
          <p>如果你是想教学的中学生，我们会先为你提供培训。</p>
          <a class="btn" href="/zh-hans/get-involved#students">报名</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
