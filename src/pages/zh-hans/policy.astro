---
// GENERATED FILE — do not edit by hand.
// Run `npm run zh-hans` to rebuild this from src/pages/zh/.
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/pages/policy.css';
import { getCollection } from 'astro:content';

const submissions = (await getCollection('submissions'))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="政策研究"
  pageClass="page-policy"
  description="由学生主导的智库，向香港的立法与决策者提交书面建议——每年约二十项，涵盖施政报告、财政预算案及五年规划咨询。"
>
  <section class="page-top">
    <div class="container prose">
      <p class="kicker">政策研究</p>
      <h1>一个向决策者递交建议的智库</h1>
      <p class="lead">
        AI For Good 的政策部门研究并撰写向香港政府提交的书面建议。这些工作是真实的、已经递交的，而且仍在继续。
      </p>
    </div>
  </section>

  <section class="record">
    <div class="container">
      <h2 class="section-title">纪录</h2>
      <dl class="ledger">
        <div class="ledger-row">
          <dt class="ledger-figure">~20</dt>
          <dd class="ledger-label">每年向政府提交的建议</dd>
        </div>
        <div class="ledger-row weighted">
          <dt class="ledger-figure">HK$50M</dt>
          <dd class="ledger-label">
            2026–27 年度财政预算案拨予 <strong>AI for All</strong> 的款项——我们一直倡议的普及人工智能计划。<a class="link-quiet" href="#ai-for-all">我们提交了什么，又能说什么 →</a>
          </dd>
        </div>
        <div class="ledger-row">
          <dt class="ledger-figure">2024–</dt>
          <dd class="ledger-label">
            自 2024 年起，每个周期均就施政报告咨询及财政预算案建议提交意见
          </dd>
        </div>
        <div class="ledger-row">
          <dt class="ledger-figure">2026–2030</dt>
          <dd class="ledger-label">
            正就《经济和社会发展第一个五年规划》提交意见
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section id="ai-for-all" class="flagship">
    <div class="container">
      <div class="prose">
        <p class="kicker">代表作</p>
        <h2>AI for All</h2>
        <p class="flagship-lede">
          2026 年 2 月，香港财政预算案拨款五千万港元推行一项普及人工智能计划，预计两年内通过超过 200 项课程、讲座与比赛，接触约 50,000 名市民。计划由数码港、香港科技园公司及香港生产力促进局推行，其中数码港的部分以学生、家长、长者及基层社群为对象。
        </p>
      </div>

      <p class="attribution">
        <strong>我们能说的是：</strong>我们提出了这项建议，而预算案朝这个方向走。
        AI for All 是政府的计划，由公营机构拨款及推行——我们没有出资、没有运营，也不能说是我们促成的。
      </p>

      <ol class="timeline">
        <li>
          <span class="t-phase">我们看见的问题<span class="t-date">2024</span></span><span class="t-body">
            在没有人工智能课程、也没有预算开设课程的学校授课时，我们在每一间教室都记录到同一件事：孩子学得很快，缺的是接触的机会。最可能被人工智能抛离的家庭，恰恰最难被任何经由学校与雇主推行的计划触及。
          </span>
        </li>
        <li>
          <span class="t-phase">我们做了什么<span class="t-date">2025 年 8 月</span></span><span class="t-body">
            我们把看见的变成书面论证：先访问前线授课的成员，再研究既有的公共供给覆盖了谁、又遗漏了谁，然后写成一份先列出支持理由、再列出反对理由、最后才提出建议的意见书。我们于 2025 年 8 月就施政报告咨询提交，并在财政预算案的意见中重申同一论点。
          </span>
        </li>
        <li>
          <span class="t-phase">结果如何<span class="t-date">2026 年 2–6 月</span></span><span class="t-body">
            2026–27 年度财政预算案拨款五千万港元予 AI for All，计划并于 2026 年 6 月启动。我们一直提出的论点，在计划的设计中得到呼应：数码港的部分以学生、家长、长者及基层社群为对象——正是我们指出一般人工智能技能推广最迟才会照顾到的一群。资料来源列于下方，请自行查证，不必只听我们说。
          </span>
        </li>
      </ol>

      <article class="proposal" aria-label="AI for All — 我们的意见书及我们的判断">
        <div class="proposal-part">
          <p class="part-label">我们为何提出</p>
          <p class="part-body">
            我们在没有人工智能课程、也没有预算开设课程的学校里教小学生。问题不在兴趣——孩子学得很快——而在机会。因此我们历年的意见书都提出同一点：若人工智能素养只通过学校与雇主资助，最终只会抵达本来已经拥有的家庭，错过真正需要的一群。公帑应该花在队伍最后的人身上，而不是最前面的人。
          </p>
        </div>
        <div class="proposal-part">
          <p class="part-label">我们提交了什么</p>
          <p class="part-body">
            2025 年 8 月，我们就施政报告咨询提出这项论点，并在财政预算案的意见中重申：应直接资助最不可能接触到人工智能的一群——资源不足学校的儿童、他们的家长，以及长者——而不是通过最迟才会照顾到他们的机构层层转介。我们要求的是专门针对这群人的公共拨款，而非一项笼统的人工智能技能承诺。
          </p>
        </div>
        <div class="proposal-part part-recommendation">
          <p class="part-label">这代表什么，又不代表什么</p>
          <p class="part-body">
            这笔拨款是起点，不是终点。政府形容五千万港元为初步款项，
            50,000 名参加者亦只是按现有资源订立的基准；官员表示若需求存在，可能会有进一步拨款。五万人只占香港人口的一小部分。我们在下一个周期的立场是：需求确实存在，拨款应该跟上，而我们会在五年规划的意见书中如此陈述。
          </p>
        </div>
      </article>

      <aside class="sources" aria-label="AI for All 数据来源">
        <p class="sources-label">资料来源</p>
        <ul>
          <li>
            <a href="https://www.info.gov.hk/gia/general/202606/10/P2026061000476.htm" rel="noopener">
              政府新闻公报，2026 年 6 月 10 日
            </a><span>info.gov.hk</span>
          </li>
          <li>
            <a href="https://www.thestandard.com.hk/news/article/334092/HK-launches-50m-AI-for-All-campaign-to-benefit-50000-residents" rel="noopener">
              “HK launches $50m AI for All campaign to benefit 50,000 residents”
            </a><span>The Standard</span>
          </li>
          <li>
            <a href="https://www.scmp.com/news/hong-kong/hong-kong-economy/article/3365474/hong-kong-launch-free-ai-courses-tech-giants-google-microsoft-smes" rel="noopener">
              “Hong Kong to launch free AI courses with tech giants Google, Microsoft for SMEs”
            </a><span>South China Morning Post</span>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="method">
    <div class="container">
      <h2 class="section-title">一份建议是怎样写成的</h2>
      <ol class="steps-detail">
        <li>
          <span class="step-num">1</span>
          <div>
            <h3>成员访谈</h3>
            <p>
              议题来自成员亲眼见到的事，而不是新闻上有什么。我们访问前线授课的人：在教室里遇到了什么、影响了哪些孩子、是偶发一次还是每周如此。若一个问题只有一个人注意到，就要再找证据，才会成为提案。
            </p>
          </div>
        </li>
        <li>
          <span class="step-num">2</span>
          <div>
            <h3>研究</h3>
            <p>
              接着检验它是否真的是一个政策问题。政府在这个范畴已经资助了什么？现有供给触及谁、又遗漏谁？其他可比司法管辖区试过什么、成本多少？如果既有政策已经涵盖这个问题，我们就直说并停止——这一步的用意是否决提案，而不是为提案背书。
            </p>
          </div>
        </li>
        <li>
          <span class="step-num">3</span>
          <div>
            <h3>撰写与递交</h3>
            <p>
              由成员按下方的三段结构起草，而反对理由会写到我们诚实能写的最强程度。若反对一方胜出，提案就不会发出。通过的则递交至当时开放的咨询——施政报告咨询、财政预算案建议，或个别政策局的意见征集——建议会写得足够具体，让对方可以据以行动。
            </p>
          </div>
        </li>
      </ol>

      <p class="method-note prose">
        每一份提案都是同一个形状——让这份工作站得住脚的是这个形状，而不是篇幅：
      </p>

      <article class="proposal proposal-demo" aria-label="每份提案共用的结构">
        <header class="proposal-head">
          <h3 class="proposal-title">每一份提案，同一个形状</h3>
          <p class="proposal-meta">AI For Good 意见书的固定结构</p>
        </header>
        <div class="proposal-part">
          <p class="part-label">支持的理由</p>
          <p class="part-body">
            以最有力的方式陈述赞成的论点：这项政策会达成什么、惠及谁，并以证据支撑。
          </p>
        </div>
        <div class="proposal-part">
          <p class="part-label">反对的理由</p>
          <p class="part-body">
            诚实地写出反面：成本、风险，以及由谁承担。若反对一方胜出，这份提案不会递交。
          </p>
        </div>
        <div class="proposal-part part-recommendation">
          <p class="part-label">建议</p>
          <p class="part-body">
            在双方理由都陈述过之后，才平实地写出我们希望政府做什么。
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="filings">
    <div class="container">
      <h2 class="section-title">已递交的意见书</h2>
      {
        submissions.length === 0 ? (
          <p class="empty-note">意见书会在正式递交后于此发布。</p>
        ) : (
          <div class="filed-list">
            {submissions.map((s) => (
              <article class="proposal">
                <header class="proposal-head">
                  <h3 class="proposal-title">{s.data.title_hans ?? s.data.title}</h3>
                  <p class="proposal-meta">
                    递交予 {s.data.submittedTo_hans ?? s.data.submittedTo} · {s.data.date}
                  </p>
                </header>
                <div class="proposal-part">
                  <p class="part-label">支持的理由</p>
                  <p class="part-body">{s.data.for_hans ?? s.data.for}</p>
                </div>
                <div class="proposal-part">
                  <p class="part-label">反对的理由</p>
                  <p class="part-body">{s.data.against_hans ?? s.data.against}</p>
                </div>
                <div class="proposal-part part-recommendation">
                  <p class="part-label">建议</p>
                  <p class="part-body">{s.data.recommendation_hans ?? s.data.recommendation}</p>
                </div>
                {s.data.pdf && (
                  <p class="proposal-pdf">
                    <a class="link-quiet" href={s.data.pdf}>阅读意见书全文（PDF）→</a>
                  </p>
                )}
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
