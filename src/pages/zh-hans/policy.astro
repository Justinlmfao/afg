---
// GENERATED FILE — do not edit by hand.
// Run `npm run zh-hans` to rebuild this from src/pages/zh/.
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/pages/policy.css';
import { render } from 'astro:content';
import { getLangFromUrl } from '../../i18n';
import { getPapers, formatMonth, paperLabels } from '../../papers';

// Papers in this page's language, oldest first: the .zh.md files here, and the
// generated .hans.md files on the Simplified page (the language comes from the
// URL).
const lang = getLangFromUrl(Astro.url);
const label = paperLabels[lang];
const papers = await Promise.all(
  (await getPapers(lang)).map(async (s) => ({ ...s.data, Body: (await render(s)).Content }))
);
// For "Builds on" / "Led to" links, which appear only when both papers exist
const titles = new Map(papers.map((p) => [p.key, p.title]));
---

<BaseLayout
  title="政策研究"
  pageClass="page-policy"
  description="AI For Good 的政策研究：每年向香港政府提交约二十项书面建议，涵盖施政报告、财政预算案和第一个五年规划。"
>
  <section class="page-top">
    <div class="container prose">
      <p class="kicker">政策研究</p>
      <h1>写给作决定的人</h1>
      <p class="lead">
        我们的政策团队研究在香港看到的问题，再向政府提交建议。凡标明“已提交建议”的，都是真正提交给政府的文件，而且还会陆续有更多。
      </p>
    </div>
  </section>

  <section class="record rail-section">
    <div class="container rail">
      <h2 class="rail-head">到目前为止</h2>
      <div class="rail-body">
        <dl class="ledger">
          <div class="ledger-row">
            <dt class="ledger-figure">~20</dt>
            <dd class="ledger-label">每年向政府提交的建议</dd>
          </div>
          <div class="ledger-row weighted">
            <dt class="ledger-figure">HK$50M</dt>
            <dd class="ledger-label">
              2026–27 年度财政预算案拨给 <strong>AI for All</strong> 的款项，正是我们一直倡议的那类普及人工智能计划。<a class="link-quiet" href="#ai-for-all">我们提交了什么，又可以怎样说 →</a>
            </dd>
          </div>
          <div class="ledger-row">
            <dt class="ledger-figure">2024–</dt>
            <dd class="ledger-label">
              自 2024 年起，每一轮施政报告和财政预算案咨询都有提交意见
            </dd>
          </div>
          <div class="ledger-row">
            <dt class="ledger-figure">2026–2030</dt>
            <dd class="ledger-label">
              正在为《经济和社会发展第一个五年规划》撰写意见书
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section id="ai-for-all" class="flagship rail-section">
    <div class="container rail">
      <div class="rail-head">
        <p class="kicker">我们的主要项目</p>
        <h2>AI for All</h2>
      </div>
      <div class="rail-body">
        <p class="flagship-lede">
          2026 年 2 月，香港财政预算案拨出五千万港元，推行一个普及人工智能计划。计划预计在两年内，通过超过 200 个课程、讲座和比赛，接触约 50,000 名市民，由数码港、香港科技园公司和香港生产力促进局负责推行，其中数码港的部分以学生、家长、长者和基层社群为对象。
        </p>

      <p class="attribution">
        <strong>我们可以这样说：</strong>我们提出了这项建议，而预算案朝这个方向走。AI for All 是政府的计划，由公营机构出资和推行。我们没有出资，也没有参与运营。
      </p>

      <ol class="timeline">
        <li>
          <span class="t-phase">我们看到的问题<span class="t-date">2024</span></span><span class="t-body">
            我们在一些没有人工智能课堂、也没有资源开办的学校教书，每间教室都看到同一件事：孩子学得很快，缺的是接触的机会。最容易被人工智能抛离的家庭，偏偏也是经学校和雇主推行的计划最难接触到的一群。
          </span>
        </li>
        <li>
          <span class="t-phase">我们做了什么<span class="t-date">2025 年 8 月</span></span><span class="t-body">
            我们把看到的写成一份论证：先访问负责教学的成员，再研究现有的公共支援帮到谁、漏了谁，然后写成一份包括支持理由、反对理由和建议的意见书。我们在 2025 年 8 月把它提交到施政报告咨询，之后在财政预算案的意见中再次提出同一论点。
          </span>
        </li>
        <li>
          <span class="t-phase">之后的发展<span class="t-date">2026 年 2–6 月</span></span><span class="t-body">
            2026–27 年度财政预算案拨出五千万港元推行 AI for All，计划在 2026 年 6 月正式启动。我们一直提出的论点，在计划的设计中得到呼应：数码港的部分以学生、家长、长者和基层社群为对象，正是我们指出一般人工智能技能推广最迟才会照顾到的人。资料来源列在下面，你可以自己查证。
          </span>
        </li>
      </ol>

      <article class="proposal" aria-label="AI for All：我们的意见书和我们对结果的看法">
        <div class="proposal-part">
          <p class="part-label">我们为什么提出</p>
          <p class="part-body">
            我们在没有人工智能课堂、也没有相关预算的学校教小学生。孩子很有兴趣，也学得很快，他们缺的是机会。所以我们每年的意见书都提出同一点：如果人工智能培训只经学校和雇主推行，最后只会惠及本来已有机会的家庭，漏掉真正需要的人。公帑应该先照顾排在队尾的人。
          </p>
        </div>
        <div class="proposal-part">
          <p class="part-label">我们提交了什么</p>
          <p class="part-body">
            2025 年 8 月，我们在施政报告咨询中提出这个论点，之后在财政预算案的意见中再次提出。我们建议政府直接资助最难接触到人工智能的人，例如资源不足学校的孩子、他们的家长和长者，而不是经那些最迟才会照顾到他们的机构转介。我们要求的是专门拨给这群人的款项，而不是一个笼统的人工智能技能承诺。
          </p>
        </div>
        <div class="proposal-part part-recommendation">
          <p class="part-label">这代表什么，又不代表什么</p>
          <p class="part-body">
            这是一个开始，不是终点。政府形容五千万港元只是初步拨款，50,000 名参加者的目标也只是按现有资源订下的基准；官员表示如果有需求，可能会再增加拨款。五万人只占香港人口的一小部分。我们在下一轮的立场是：需求确实存在，拨款应该跟上，我们也打算在五年规划的意见书中这样说。
          </p>
        </div>
      </article>

      <div class="flagship-more">
        <h3>为什么这很重要</h3>
        <p>
          能够接触人工智能，只解决了一半问题。2019 年，全港有 94% 的家庭可以上网，但月入少于一万港元的家庭只有 71%。而即使有电脑，如果没有人教孩子好好使用人工智能，他们也可能只是依赖它，而不是从中学习。这第二道差距，正是我们<a href="#think-first">《Think First 先想后问》建议</a>要处理的问题。
        </p>
        <h3>我们接下来会留意的事</h3>
        <ul class="watch-list">
          <li>
            <strong>接触到谁。</strong>名额是否真的去到低收入家庭的学生、家长和长者，以及政府会否公布参加者的背景。
          </li>
          <li>
            <strong>怎样教。</strong>给孩子的课程，是否教他们用人工智能来思考，而不只是教他们怎样用。
          </li>
          <li>
            <strong>会否扩大。</strong>五千万港元和五万人是一个开始。我们会继续主张拨款应该跟随需求增加。
          </li>
        </ul>
      </div>

      <aside class="sources" aria-label="AI for All 资料来源">
        <p class="sources-label">资料来源</p>
        <ul>
          <li>
            <a href="https://www.info.gov.hk/gia/general/202606/10/P2026061000476.htm" rel="noopener">
              政府新闻公报，2026 年 6 月 10 日
            </a><span>info.gov.hk</span>
          </li>
          <li>
            <a href="https://www.thestandard.com.hk/news/article/334092/HK-launches-50m-AI-for-All-campaign-to-benefit-50000-residents" rel="noopener">
              “HK launches $50m AI for All campaign to benefit 50,000 residents”
            </a><span>The Standard</span>
          </li>
          <li>
            <a href="https://www.scmp.com/news/hong-kong/hong-kong-economy/article/3365474/hong-kong-launch-free-ai-courses-tech-giants-google-microsoft-smes" rel="noopener">
              “Hong Kong to launch free AI courses with tech giants Google, Microsoft for SMEs”
            </a><span>South China Morning Post</span>
          </li>
        </ul>
      </aside>
      </div>
    </div>
  </section>

  <section class="method rail-section">
    <div class="container rail">
      <h2 class="rail-head">我们怎样写一份提案</h2>
      <div class="rail-body">
        <ol class="steps-detail">
          <li>
            <span class="step-num">1</span>
            <div>
              <h3>和受影响的人交谈</h3>
              <p>
                每一份提案都从受政策影响的人开始。我们的议题来自成员亲眼见到的事，而不是新闻；我们会访问老师、家长、上班族和一线人员，也会问我们自己的导师：发生了什么、影响了谁、是只发生过一次还是每星期都有。如果只有一个人留意到某个问题，我们会先找更多证据，才把它写成提案。
              </p>
            </div>
          </li>
          <li>
            <span class="step-num">2</span>
            <div>
              <h3>做研究</h3>
              <p>
                接着我们会检查这是否真的是政策问题。政府在这方面已经资助了什么？这些资助帮到谁、漏了谁？其他地方试过什么方法、成本多少？如果现有政策已经处理了这个问题，我们会直说，然后放弃这份提案。这一步的目的是筛掉提案，而不是替提案找理由。
              </p>
            </div>
          </li>
          <li>
            <span class="step-num">3</span>
            <div>
              <h3>撰写和提交</h3>
              <p>
                由一位成员按下面的三段格式撰写提案，反对的理由会写得尽量有力。如果反对的理由胜出，提案就不会提交。通过的提案会交到当时开放的咨询，例如施政报告、财政预算案或个别政策局的意见征集，而建议会写得清楚具体，让对方可以据此行动。
              </p>
            </div>
          </li>
        </ol>

        <p class="method-note">
          每一份提案都用同一个三段格式：
        </p>

        <article class="proposal proposal-demo" aria-label="每份提案共用的格式">
          <header class="proposal-head">
            <h3 class="proposal-title">每份提案都用的格式</h3>
            <p class="proposal-meta">AI For Good 意见书的结构</p>
          </header>
          <div class="proposal-part">
            <p class="part-label">支持的理由</p>
            <p class="part-body">
              最有力的支持论点：这项政策能做到什么、帮到谁，以及背后的证据。
            </p>
          </div>
          <div class="proposal-part">
            <p class="part-label">反对的理由</p>
            <p class="part-body">
              诚实地写出反对的论点：成本、风险，以及由谁承担。如果这一方胜出，我们就不提交。
            </p>
          </div>
          <div class="proposal-part part-recommendation">
            <p class="part-label">建议</p>
            <p class="part-body">
              在两方面都说清楚之后，用简单直接的话写出我们希望政府做什么，包括需要多少钱，以及怎样知道它是否有效。
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="filings rail-section">
    <div class="container rail">
      <h2 class="rail-head">我们的政策文件</h2>
      <div class="rail-body">
        <p class="filings-note">
          按时间排列，最早的在前。<strong>已提交建议</strong>是我们向政府咨询提交过的建议；<strong>回顾</strong>是我们事后为政府已推行的措施所写的检讨：改变了什么、惠及哪些人，以及我们现在会怎样改。回顾会列出措施公布和我们撰写的日期，并按措施公布的日期排列。每一份文件都会先写支持和反对的理由，然后才提出建议。
        </p>
        {
          papers.length === 0 ? (
            <p class="empty-note">文件完成后，会在这里公开。</p>
          ) : (
            papers.map(({ key, title, kind, measureDate, written, area, summary, builtOn, ledTo, pdf, Body }) => (
              <article class={`filed filed-${kind}`} id={key}>
                <p class="filed-meta">
                  <span class="filed-kind">{label.kind[kind]}</span>
                  {measureDate && (
                    <>
                      {' · '}
                      {label.announced}<time datetime={measureDate}>{formatMonth(measureDate, lang)}</time>
                    </>
                  )}
                  {' · '}
                  {label.written}<time datetime={written}>{formatMonth(written, lang)}</time>
                  {' · '}
                  {area}
                </p>
                <h3 class="filed-title">{title}</h3>
                <p class="filed-summary">{summary}</p>
                {[['builtOn', builtOn], ['ledTo', ledTo]].map(([rel, target]) =>
                  target && titles.has(target) ? (
                    <p class="filed-link">
                      {label[rel as 'builtOn' | 'ledTo']}<a href={`#${target}`}>{titles.get(target)}</a>
                    </p>
                  ) : null
                )}
                <details class="filed-more">
                  <summary>阅读全文</summary>
                  <div class="filed-body">
                    <Body />
                    {pdf && (
                      <p>
                        <a class="link-quiet" href={pdf}>下载 PDF →</a>
                      </p>
                    )}
                  </div>
                </details>
              </article>
            ))
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
