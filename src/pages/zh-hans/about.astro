---
// GENERATED FILE — do not edit by hand.
// Run `npm run zh-hans` to rebuild this from src/pages/zh/.
// Simplified Chinese About page. Shares src/styles/pages/about.css with the
// English page. Roles and bios come from role_hans and bio_hans in
// src/content/team/*.md (bio_hans is one string per paragraph); anything
// untranslated falls back to English. Keep each Chinese paragraph on one
// source line.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTop from '../../components/PageTop.astro';
import SummaryList from '../../components/SummaryList.astro';
import Gallery from '../../components/Gallery.astro';
import '../../styles/pages/about.css';
import { getCollection, render } from 'astro:content';
import { facts } from '../../data/facts';

const f = facts;

const people = await Promise.all(
  (await getCollection('team'))
    .filter((m) => !m.data.draft)
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (m) => ({
      name: m.data.name,
      first: m.data.name.split(' ')[0],
      role: m.data.role_hans ?? m.data.role,
      paras: m.data.bio_hans,
      Bio: m.body?.trim() ? (await render(m)).Content : null,
    }))
);
---

<BaseLayout
  title="关于我们"
  pageClass="page-about"
  description="AI For Good 是一个由香港学生运营的组织，于 2023 年 6 月成立。我们为政府撰写政策建议，也为基层家庭的孩子提供免费补习。"
>
  <PageTop vertical="关于我们">
    <h1>政策和教学，出于同一个原因。</h1>
    <p class="lead">
      AI For Good 是一个由香港学生运营的组织，于 {f.founded.zh}成立。我们为政府撰写人工智能和经济政策的建议，也为基层家庭的小学生提供免费补习。
    </p>
  </PageTop>

  <section class="sec" aria-labelledby="at-a-glance">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="at-a-glance">概览。</h2>
      </div>
      <SummaryList
        rows={[
          { key: '成立', value: `${f.founded.zh}，由 ${f.founders[0]}、${f.founders[1]} 和 ${f.founders[2]} 创办` },
          { key: '成员', value: `${f.members.value} 位学生` },
          {
            key: '政策',
            value: `每年约 ${f.recsPerYear.value.replace('~', '')} 项建议；自 ${f.recsPerYear.since} 年起，回应每一份施政报告及财政预算案咨询`,
          },
          {
            key: '教学',
            value: `${f.children.value} 个孩子、${f.schools.value} 所学校、${f.tutors.value} 位受训导师、${f.modules.length} 个单元`,
          },
          {
            key: '成果',
            value: `${f.aiForAll.budget} 年度财政预算案<a href="/zh-hans/policy#ai-for-all">拨款${f.aiForAll.amount.zh}推行 AI for All</a>`,
          },
          {
            key: '合作伙伴',
            value: "天主教领岛学校、Kennedy Town School、St. Barnabas' Home &amp; Society 及 10% Organisation",
          },
        ]}
      />
    </div>
  </section>

  <section class="sec" aria-labelledby="why-both">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="why-both">写政策的人，应该见过受政策影响的人。</h2>
      </div>
      <div class="prose">
        <p class="lead">
          如果写人工智能政策的人从未见过受影响的人，这样的政策不会是好政策。我们教的孩子，正是受影响的人。
        </p>
        <p>
          我们两样都做，并不是巧合。坐在何文田的教室里，看着一个孩子第一次用人工智能导师，你会明白很多咨询文件不会告诉你的事：哪些孩子家里早就有补习老师，哪些有电脑，而哪些孩子正因为一项人人都说能“拉平差距”的科技，被抛得更远。
        </p>
        <p>
          我们大部分的意见书都是从这里开始的。教学让我们看到差距在哪里，研究帮我们判断这是不是政策问题，最后由意见书请政府去解决。反过来也一样：我们在研究教育和劳工政策时学到的东西，也会改变我们觉得值得教给十岁孩子的内容。比起只读过资料的人，我们宁愿做真正去过现场的人。
        </p>
      </div>
    </div>
  </section>

  <!-- Justin's own account, in the first person and left in his words. -->
  <section class="sec" aria-labelledby="why-i-started">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="why-i-started">我为什么创办它。</h2>
      </div>
      <div class="prose">
        <h3>为什么做政策研究</h3>
        <p>
          人工智能来到香港的速度，比这座城市决定它应该为谁服务还要快。我先在自己的学校看到它，然后是朋友的实习，再然后是政府的规划，每次的情况都一样：本来机会最多的人，最先得到它。没有人刻意这样选择，只是因为从来没有人被问过。我花了两年时间去了解公帑怎样分配、一个决定的代价最后由谁承担。眼看这些决定就在几公里外发生，自己却什么都不做，实在说不过去。所以我们开始写信给作决定的人。
        </p>
        <h3>为什么做教学</h3>
        <p>
          一开始，只是我们几个同学在学校里互相教人工智能，大多是边玩边学。我们做过很多失败的东西，也做出了几样成功的。很明显，只要有人教你第一步，这些工具能帮到你很多。接着我们也看得很清楚，是谁没有人教。最能从人工智能得益的孩子，往往最没有机会接触它，而这个差距不会自己消失。于是我们把原本在教室里玩得很开心的事，带到一些没有人提供这些的学校。
        </p>
        <p class="signed">创办人兼总监 Justin Lo</p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="people">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="people">全由学生运营。</h2>
        <p>我们的成员分别参与政策研究和补习工作。以下是带领团队的成员。</p>
      </div>
      <div>
        <ul class="people">
          {
            people.map(({ name, first, role, paras, Bio }) => (
              <li class="person">
                <h3>{name}</h3>
                <p class="person-role">{role}</p>
                {(paras || Bio) && (
                  <details>
                    <summary>关于 {first}</summary>
                    <div class="prose" lang={paras ? undefined : 'en'}>
                      {paras ? paras.map((p) => <p>{p}</p>) : Bio && <Bio />}
                    </div>
                  </details>
                )}
              </li>
            ))
          }
        </ul>
        <div class="people-photos">
          <Gallery
            photos={[
              {
                name: 'team-classroom.jpg',
                alt: '六位 AI For Good 成员在天主教领岛学校的教室内，摄于一节课之后。',
                caption: '在天主教领岛学校的教室内，摄于一节课之后。',
              },
              {
                name: 'team-outside-school.jpg',
                alt: '五位 AI For Good 成员在天主教领岛学校门外。',
                caption: '学校门外。',
              },
            ]}
          />
        </div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="how-it-started">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="how-it-started">我们怎样开始。</h2>
      </div>
      <div class="prose">
        <p>
          AI For Good 由 <strong>Justin Lo</strong>、<strong>Ka Hei Ng</strong> 和 <strong>Oscar Zheng</strong> 创立，<strong>David Dong</strong> 和 <strong>Jackie Xue</strong> 其后加入。我们一开始是校外的独立智库，不是学校的学会。后来成员渐渐增加，也开始和全港各区的学校合作，补习计划就是这样接触到今天这些孩子。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
