---
// GENERATED FILE — do not edit by hand.
// Run `npm run zh-hans` to rebuild this from src/pages/zh/.
// Simplified Chinese home page. Shares the English page's stylesheet
// (src/styles/pages/home.css) via pageClass, so layout changes stay in one
// place; only the prose differs. Keep each Chinese paragraph on one source
// line: Astro turns a line break into a space, which shows in Chinese.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import NowStrip from '../../components/NowStrip.astro';
import FigureRow from '../../components/FigureRow.astro';
import Case from '../../components/Case.astro';
import Ledger from '../../components/Ledger.astro';
import Steps from '../../components/Steps.astro';
import Gallery from '../../components/Gallery.astro';
import MarginNote from '../../components/MarginNote.astro';
import '../../styles/pages/home.css';
import { getCollection } from 'astro:content';
import { facts, showSamples } from '../../data/facts';
import { aiForAllCase } from '../../data/cases';
import { formatDate } from '../../lib/dates';
import { getSubmissions, submissionHref } from '../../lib/submissions';
import { getLangFromUrl } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const f = facts;
const story = aiForAllCase(lang, { document: '/zh-hans/policy#ai-for-all' });
// The proposals with a page of their own.
const proposals = (await getSubmissions(lang)).filter((s) => s.hasPaper);
const modules = (await getCollection('programs'))
  .filter((m) => !m.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
// Photographs for the proposal cards, in order. They show our own work in
// class, so they are decorative here (empty alt text).
const cardPhotos = ['teaching-chalkboard-maths.jpg', 'team-outside-school.jpg'];
---

<BaseLayout
  title="AI For Good 香港：学生主导的人工智能政策研究与免费补习"
  pageClass="page-home"
  description="AI For Good 是一个由香港学生创办和运营的组织：我们向政府提交政策建议，也为基层家庭的小学生提供免费补习。"
>
  <!-- "Now": what we're working on this month, in a strip under the header -->
  <NowStrip />

  <!-- Hero: the words on the left, the classroom on the right, running to
       the edge of the screen. On phones the photo comes first. -->
  <div class="hero-split">
    <div class="hero-text">
      <p class="kicker-date">学生主导的政策研究</p>
      <h1>香港学生撰写<wbr />人工智能政策建议，<wbr />也为受影响的孩子<wbr />上课。</h1>
      <p class="lead">
        我们是一群香港学生，研究人工智能和经济政策如何改变这座城市，每年向政府提交约{f.recsPerYear.word[lang]}项建议。我们也为基层家庭的小学生免费教授人工智能和经济知识。
      </p>
      <div class="actions">
        <a class="btn" href="/zh-hans/policy">阅读我们的政策研究</a>
        <a class="textlink" href="/zh-hans/teaching">看看我们的教学</a>
      </div>
    </div>
    <figure class="hero-photo">
      <Photo
        name="teaching-classroom.jpg"
        alt="导师在天主教领岛学校上课，一名学生举手回答。"
        sizes="(min-width: 60rem) 50vw, 100vw"
        position="58% 40%"
        positionPhone="68% 40%"
        eager
      />
      <figcaption>天主教领岛学校的一节补习课。</figcaption>
    </figure>
  </div>

  <div class="wrap hero-figures">
    <FigureRow
    items={[
      { figure: f.recsPerYear.value, label: '每年提交的建议' },
      { figure: f.children.value, label: '教过的孩子' },
      { figure: f.schools.value, label: '合作学校' },
      { figure: f.tutors.value, label: '受训学生导师' },
    ]}
    />
  </div>

  <div class="halves doors">
    <section class="half-col tone-policy" aria-labelledby="door-policy">
      <div class="half washed door">
        <h2 id="door-policy">政策研究</h2>
        <p>我们向香港政府提交书面建议，自 2024 年起每一轮施政报告和财政预算案咨询都有参与。</p>
        <p class="door-number">{f.recsPerYear.value} <span>每年提交的建议</span></p>
        <a class="textlink" href="/zh-hans/policy">阅读我们的政策研究</a>
      </div>
      <div class="half band">
        <p class="proof-figure">HK$50M</p>
        <p class="proof-label">{f.aiForAll.budget} 年度财政预算案拨给 AI for All 的款项，正是我们一直倡议的那类普及人工智能计划</p>
      </div>
    </section>
    <section class="half-col tone-teaching" aria-labelledby="door-teaching">
      <div class="half washed door">
        <h2 id="door-teaching">教学计划</h2>
        <p>由我们亲自培训的学生导师，在七所学校为小学生提供免费补习。</p>
        <p class="door-number">{f.children.value} <span>教过的孩子</span></p>
        <a class="textlink" href="/zh-hans/teaching">看看我们的教学</a>
      </div>
      <div class="half band">
        <p class="proof-figure">{f.bandUp.value}{f.bandUp.unit}</p>
        <p class="proof-label">自 {f.bandUp.since} 年起，至少升了一个组别的学生比例</p>
      </div>
    </section>
  </div>

  <section class="sec tone-policy" aria-labelledby="ai-for-all">
    <div class="wrap">
      <Case id="ai-for-all" {...story}>
        <a slot="claim-more" href="/zh-hans/policy#ai-for-all">{story.more}</a>
      </Case>
    </div>
  </section>

  <section class="sec" aria-labelledby="who-h">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="who-h">我们是谁</h2>
      </div>
      <div class="prose">
        <p class="tagline">为我们终将继承的科技，制订政策。</p>
        <p>
          AI For Good 由学生在 2023 年 6 月创立，到今天仍然全由学生运营，现在已有超过 35 人。我们一开始是校外的独立智库，后来才陆续和全港各区的学校合作。我们同时做两件事：为政府撰写有证据支持的建议，也去教那些最先感受到这些决定影响的孩子。
        </p>
        <p><a class="textlink" href="/zh-hans/about">了解更多</a></p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="current-h">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="current-h">我们正在做的事</h2>
      </div>
      <ul class="current-list">
        <li class="tone-policy">
          <span class="tone-tag">政策</span>
          <span>就《香港特别行政区经济和社会发展第一个五年规划（2026–2030）》撰写意见书。我们主张人工智能的资源应该投放到有需要的地方，而不只是沿用现有的计划。</span>
        </li>
        <li class="tone-teaching">
          <span class="tone-tag">教学</span>
          <span>明年会带着新一批导师重返天主教领岛学校。</span>
        </li>
      </ul>
    </div>
  </section>

  <figure class="photo photo-break">
    <Photo
      name="vsa-2025-26-cohort.jpg"
      alt="2025/26 年度的学生与导师在教室内合照。"
      sizes="100vw"
      position="50% 45%"
    />
    <figcaption class="wrap">2025–26 年度的学生与导师，摄于我们与沪江维多利亚学校合办的社区课程。</figcaption>
  </figure>

  <section class="sec tone-policy washed" aria-labelledby="policy-h">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="policy-h"><span class="nowrap">自 2024 年起，</span><wbr />我们回应了<wbr />每一份施政报告<wbr />及财政预算案咨询。</h2>
        <p>每份建议书都先写支持的理由、反对的理由，然后才是我们的建议。</p>
      </div>
      <div>
        <Ledger rows={proposals} variant="brief" heading="其他近期建议" caption="其他近期建议" />
        <a class="more" href="/zh-hans/policy#submissions">所有意见书</a>
      </div>
    </div>
  </section>

  <section class="sec tone-teaching washed" aria-labelledby="teaching-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="teaching-h">孩子先自己尝试，<wbr />再请人工智能<wbr />给提示，<wbr />从不直接要答案。</h2>
        <p>每一节课都跟从同样的四个步骤，数学、英文、经济和科学都一样。</p>
      </div>
      <Steps
        items={[
          { name: '尝试', text: '先自己试着解题。' },
          { name: '提问', text: '请人工智能给提示或核对。' },
          { name: '核对', text: '比较它的回应和自己的做法。' },
          { name: '解释', text: '关掉人工智能，用自己的话解释。' },
        ]}
      />
      <Gallery
        photos={[
          {
            name: 'teaching-ai-study-partner.jpg',
            alt: '导师在小学课堂上，用投影在屏幕上的人工智能学习伙伴教学。',
            caption: '在天主教领岛学校，把人工智能当作学习伙伴。',
          },
          {
            name: 'vsa-2025-26-helping.jpg',
            alt: '导师协助一名学生使用笔记本电脑。',
            caption: '与沪江维多利亚学校合办的社区课堂，2025–26 年度。',
          },
          {
            name: 'vsa-2024-25-presenting.jpg',
            alt: '两位导师向一班年轻人讲解。',
            caption: '社区课堂，2024–25 年度。',
          },
        ]}
      />
      <div class="noted facts">
        <p class="facts-main">
          我们的 {f.tutors.value} 位受训导师，在{f.schools.word[lang]}所学校教过 {f.children.value} 个孩子。自 {f.bandUp.since} 年起，{f.bandUp.value}{f.bandUp.unit} 的学生至少升了一个组别。
        </p>
        <MarginNote label="关于这个数字。">
          这不是我们一个人的功劳。老师、家长和学生自己都付出了努力。但这是我们用来要求自己的数字。{(!f.bandUp.method.sample || showSamples) && <a href="/zh-hans/teaching#results">我们怎样计算</a>}
        </MarginNote>
      </div>
      <a class="more" href="/zh-hans/teaching">我们的教学、单元和示范课堂</a>
    </div>
  </section>

  <!-- Latest work, straight from the collections. The flagship leads. -->
  <section class="sec" aria-labelledby="latest-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="latest-h">最新工作</h2>
      </div>
      <div class="latest">
        <ul class="latest-cards">
          <li class="tone-policy">
            <a class="card" href="/zh-hans/policy#ai-for-all">
              <Photo name="vsa-2025-26-uses.jpg" alt="" sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 45vw, 100vw" widths={[480, 800]} position="50% 35%" />
              <span class="tone-tag">主要项目</span>
              <span class="card-title">AI for All：{f.aiForAll.budget} 年度财政预算案拨款{f.aiForAll.amount[lang]}</span>
              <span class="latest-meta">2024–2026 年</span>
            </a>
          </li>
          {
            proposals.map((s, i) => (
              <li class="tone-policy">
                <a class="card" href={submissionHref(s, lang)}>
                  <Photo name={cardPhotos[i % cardPhotos.length]} alt="" sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 45vw, 100vw" widths={[480, 800]} />
                  <span class="tone-tag">提案</span>
                  <span class="card-title">{s.title}</span>
                  <span class="latest-meta">{formatDate(s.date, lang, 'long')}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="latest-modules">
          {
            modules.map((m) => (
              <li class="tone-teaching">
                <span class="tone-tag">单元</span>
                <a href="/zh-hans/teaching#modules">{m.data.title_hans ?? m.data.title}</a>
                <span class="latest-meta">教学</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="partners-h">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="partners-h">合作伙伴</h2>
      </div>
      <p class="prose">
        天主教领岛学校 · St. Barnabas' Home &amp; Society · Kennedy Town School · 10% Organisation
      </p>
    </div>
  </section>
</BaseLayout>
