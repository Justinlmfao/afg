---
// GENERATED FILE — do not edit by hand.
// Run `npm run zh-hans` to rebuild this from src/pages/zh/.
// Simplified Chinese home page. Shares the English page's stylesheet
// (src/styles/pages/home.css) via pageClass, so layout changes stay in one
// place; only the prose differs. Keep each Chinese paragraph on one source
// line: Astro turns a line break into a space, which shows in Chinese.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import Now from '../../components/Now.astro';
import Case from '../../components/Case.astro';
import Ledger from '../../components/Ledger.astro';
import Steps from '../../components/Steps.astro';
import Gallery from '../../components/Gallery.astro';
import MarginNote from '../../components/MarginNote.astro';
import '../../styles/pages/home.css';
import { facts, showSamples } from '../../data/facts';
import { aiForAllCase } from '../../data/cases';
import { getSubmissions } from '../../lib/submissions';
import { getLangFromUrl } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const f = facts;
const story = aiForAllCase(lang, { document: '/zh-hans/policy#ai-for-all' });
// The proposals with a page of their own: the ones not already told above.
const proposals = (await getSubmissions(lang)).filter((s) => s.hasPaper);
---

<BaseLayout
  title="AI For Good 香港：学生主导的人工智能政策研究与免费补习"
  pageClass="page-home"
  description="AI For Good 由香港学生运营。我们每年向政府提交约二十项政策建议，也为基层家庭的小学生免费上课。"
>
  <div class="wrap hero">
    <div class="hero-grid">
      <h1>香港学生撰写人工智能政策建议，也为受影响的孩子上课。</h1>
      <div>
        <p class="lead">
          我们每年向政府提交约{f.recsPerYear.word.zh}项建议，并为基层家庭的小学生免费上课。
        </p>
        <div class="actions">
          <a class="btn" href="/zh-hans/policy">我们的政策研究</a>
          <a class="textlink" href="/zh-hans/teaching">我们的教学</a>
        </div>
      </div>
      <Now />
    </div>
  </div>

  <figure class="photo">
    <Photo
      name="teaching-classroom.jpg"
      alt="导师在天主教领岛学校上课，一名学生举手回答。"
      sizes="100vw"
      position="50% 38%"
      positionPhone="68% 40%"
      eager
    />
    <figcaption class="wrap">天主教领岛学校的一节补习课。</figcaption>
  </figure>

  <section class="sec" aria-labelledby="ai-for-all">
    <div class="wrap">
      <Case id="ai-for-all" {...story}>
        <a slot="claim-more" href="/zh-hans/policy#ai-for-all">{story.more}</a>
      </Case>
    </div>
  </section>

  <section class="sec" aria-labelledby="policy-h">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="policy-h">自 2024 年起，我们回应了每一份施政报告及财政预算案咨询。</h2>
        <p>每份建议书都先写支持的理由、反对的理由，然后才是我们的建议。</p>
      </div>
      <div>
        <Ledger rows={proposals} variant="brief" heading="其他近期建议" caption="其他近期建议" />
        <a class="more" href="/zh-hans/policy#submissions">所有意见书</a>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="teaching-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="teaching-h">孩子先自己尝试，再请人工智能给提示，从不直接要答案。</h2>
        <p>每一节课都跟从同样的四个步骤，数学、英文、经济和科学都一样。</p>
      </div>
      <Steps
        items={[
          { name: '尝试', text: '先自己试着解题。' },
          { name: '提问', text: '请人工智能给提示或核对。' },
          { name: '核对', text: '比较它的回应和自己的做法。' },
          { name: '解释', text: '关掉人工智能，用自己的话解释。' },
        ]}
      />
      <Gallery
        photos={[
          {
            name: 'teaching-ai-study-partner.jpg',
            alt: '导师在小学课堂上，用投影在屏幕上的人工智能学习伙伴教学。',
            caption: '在天主教领岛学校，把人工智能当作学习伙伴。',
          },
          {
            name: 'vsa-2025-26-helping.jpg',
            alt: '导师协助一名学生使用笔记本电脑。',
            caption: '与沪江维多利亚学校合办的社区课堂，2025–26 年度。',
          },
          {
            name: 'vsa-2024-25-presenting.jpg',
            alt: '两位导师向一班年轻人讲解。',
            caption: '社区课堂，2024–25 年度。',
          },
        ]}
      />
      <div class="noted facts">
        <p class="facts-main">
          我们的 {f.tutors.value} 位受训导师，在{f.schools.word.zh}所学校教过 {f.children.value} 个孩子。自 {f.bandUp.since} 年起，{f.bandUp.value}{f.bandUp.unit} 的学生至少升了一个组别。
        </p>
        <MarginNote label="关于这个数字。">
          这不是我们一个人的功劳。老师、家长和学生自己都付出了努力。但这是我们用来要求自己的数字。{(!f.bandUp.method.sample || showSamples) && <a href="/zh-hans/teaching#results">我们怎样计算</a>}
        </MarginNote>
      </div>
      <a class="more" href="/zh-hans/teaching">我们的教学、单元和示范课堂</a>
    </div>
  </section>

  <section class="sec" aria-labelledby="partners-h">
    <div class="wrap">
      <div class="partners">
        <h2 id="partners-h">合作伙伴</h2>
        <p>
          天主教领岛学校、Kennedy Town School、St. Barnabas' Home &amp; Society 及 10% Organisation。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
