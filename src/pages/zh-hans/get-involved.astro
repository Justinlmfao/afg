---
// GENERATED FILE — do not edit by hand.
// Run `npm run zh-hans` to rebuild this from src/pages/zh/.
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/pages/contact.css';

// Contact address chosen by Justin (school-affiliated).
const email = 'ps20153216@student.vsa.edu.hk';
---

<BaseLayout
  title="联系我们"
  pageClass="page-contact"
  description="联系 AI For Good——欢迎有意参与研究或教学的学生、学校与合作伙伴，以及其他查询。"
>
  <section class="page-top">
    <div class="container prose">
      <p class="kicker">联系我们</p>
      <h1>与我们联系</h1>
      <p class="lead">
        发电子邮件至{' '}<a href={`mailto:${email}`}>{email}</a>，或填写下方表格。我们身处香港。
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <ul class="routes">
        <li>
          <h2>学生</h2>
          <p>
            想做真正的研究或教学？比起头衔，我们更看重愿意把事情做好的人。告诉我们你想做什么。
          </p>
        </li>
        <li>
          <h2>学校与伙伴</h2>
          <p>
            如果贵校或贵机构服务基层学生，我们很希望与您合作。课程、导师与器材由我们提供。
          </p>
        </li>
        <li>
          <h2>其他查询</h2>
          <p>媒体查询、合作提案或任何问题，欢迎来信。</p>
        </li>
      </ul>

      <!--
        Netlify Forms: `data-netlify` + the hidden `form-name` input let
        Netlify capture submissions with no backend; the honeypot filters
        simple bots. This form shares the name "contact" with the English
        page, so both languages land in the same inbox in the Netlify
        dashboard under Forms.
      -->
      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="contact-form"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden-field">
          <label>
            如果您是真人，请勿填写此栏： <input name="bot-field" />
          </label>
        </p>

        <div class="field">
          <label for="name">姓名</label>
          <input id="name" type="text" name="name" required />
        </div>

        <div class="field">
          <label for="email">电子邮箱</label>
          <input id="email" type="email" name="email" required />
        </div>

        <div class="field">
          <label for="organization">机构 <span class="optional">（选填）</span></label>
          <input id="organization" type="text" name="organization" />
        </div>

        <div class="field">
          <label for="message">留言</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>

        <button type="submit" class="btn btn-policy">
          发送留言 <span class="arrow">→</span>
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
