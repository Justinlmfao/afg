---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/teaching.css';
import Icon from '../components/Icon.astro';
import { getCollection, render } from 'astro:content';

// The four teaching modules (from src/content/programs/; drafts excluded).
const modules = (await getCollection('programs'))
  .filter((m) => !m.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  modules.map(async (m) => ({
    data: m.data,
    Content: (await render(m)).Content,
  }))
);

// Sessions run at Victoria Shanghai Academy for students from the local
// community, grouped by year. Six photos per year fill a 3-column grid.
const cohorts = [
  {
    years: '2024–25',
    summary:
      'Teaching students how AI can be used in their own communities — what the tools are good for, and how to put them to work on something useful.',
    photos: [
      { src: '/programs/vsa-2024-25-group.jpg', alt: 'Tutors and students at the close of the 2024/25 sessions, in front of a slide thanking everyone for joining.' },
      { src: '/programs/vsa-2024-25-presenting.jpg', alt: 'Two tutors present to students working at laptops during a 2024/25 session.' },
      { src: '/programs/vsa-2024-25-activity.jpg', alt: 'A tutor presents a worked example on screen, showing how an AI image tool transforms one picture into another.' },
      { src: '/programs/vsa-2024-25-helping-pair.jpg', alt: 'A tutor leans in to help two students working together at a laptop.' },
      { src: '/programs/vsa-2024-25-helping.jpg', alt: 'A tutor helps a younger student working at a laptop.' },
      { src: '/programs/vsa-2024-25-side-by-side.jpg', alt: 'A tutor works through a task beside a student at a laptop.' },
    ],
  },
  {
    years: '2025–26',
    summary:
      'Teaching children in our community what AI can change for the better — and how to recognise and avoid the unethical uses of it.',
    photos: [
      { src: '/programs/vsa-2025-26-group.jpg', alt: 'Tutors in front of a board reading "Thanks for joining — A.I. For Good 25–26" at the end of the year.' },
      { src: '/programs/vsa-2025-26-cohort.jpg', alt: 'The 2025/26 group of students and tutors together in the classroom.' },
      { src: '/programs/vsa-2025-26-uses.jpg', alt: 'A tutor presents examples of what AI can be used for, including reducing traffic, predicting natural disasters, and tutoring underprivileged students.' },
      { src: '/programs/vsa-2025-26-poster.jpg', alt: 'Students build posters setting out a problem, an AI solution, and how it would be implemented.' },
      { src: '/programs/vsa-2025-26-discussion.jpg', alt: 'A tutor talks a student through their work at a laptop.' },
      { src: '/programs/vsa-2025-26-helping.jpg', alt: 'A tutor helps a student at a laptop during a session.' },
    ],
  },
];

// Photos from sessions at Ho Man Tin Ling To Catholic School. Files live in
// public/programs/. Six photos fill the grid exactly: the first spans two
// columns and two rows, the rest fill the remaining cells.
const photos = [
  {
    src: '/programs/teaching-classroom.jpg',
    alt: 'A tutor leads a session at Ho Man Tin Ling To Catholic School while a pupil raises her hand to answer.',
    span: true,
  },
  {
    src: '/programs/teaching-chalkboard-maths.jpg',
    alt: 'A tutor works through a mental-arithmetic shortcut for 1117 × 1117 on the chalkboard.',
    span: false,
  },
  {
    src: '/programs/teaching-ai-study-partner.jpg',
    alt: 'A tutor, laptop in hand, shows pupils how to explain a maths idea aloud to an AI to check they have understood it.',
    span: false,
  },
  {
    src: '/programs/teaching-ai-tools.jpg',
    alt: 'Two tutors introduce what an AI assistant can do: find information, break down hard questions, and help with writing.',
    span: false,
  },
  {
    src: '/programs/teaching-exploring-interests.jpg',
    alt: 'A tutor shows pupils how to use AI to explore their own interests, from dinosaurs to space to music.',
    span: false,
  },
  {
    src: '/programs/teaching-english-careers.jpg',
    alt: 'Two tutors run the English module, with a slide on how English opens career doors in healthcare, trade, technology, and tourism.',
    span: false,
  },
];
---

<BaseLayout
  title="Teaching"
  description="Free tutoring for underprivileged primary students in Hong Kong — 350 children taught across 7 schools by 43 trained student tutors; 86% of students moved up at least one class band since 2024."

  pageClass="page-teaching">
  <section class="page-top">
    <div class="container prose">
      <p class="kicker kicker-teaching">Teaching</p>
      <h1>Free tutoring for children the system overlooks</h1>
      <p class="lead">
        Trained student tutors teach underprivileged primary students across
        Hong Kong, pairing school subjects with AI as a free, patient learning
        tool.
      </p>
    </div>
  </section>

  <!-- The outcome — the one figure this page leads with -->
  <section class="outcome">
    <div class="container">
      <p class="outcome-figure" data-reveal>
        <span class="outcome-number"><span data-count="86">86</span>%</span>
        <span class="outcome-rule" aria-hidden="true"></span>
      </p>
      <p class="outcome-sentence" data-reveal style="--reveal-delay:0.15s">
        of our students have moved up at least one class band since 2024.
      </p>
      <p class="quiet-facts" data-reveal style="--reveal-delay:0.25s">
        350 children taught · 7 schools · 43 tutors trained
      </p>
    </div>
  </section>

  <!-- How we teach — four modules as a ruled list, not cards -->
  <section class="modules">
    <div class="container">
      <h2 class="section-title">How we teach — four modules</h2>
      <p class="modules-note prose">
        Each module pairs a school subject with AI, designed to close — not
        widen — the gap between our students and their wealthier peers.
      </p>
      <ol class="module-list">
        {
          rendered.map((m) => (
            <li class="module">
              <div class="module-side">
                <span class="module-glyph" aria-hidden="true">
                  <Icon name={m.data.icon} size={22} />
                </span>
                <h3>{m.data.title}</h3>
              </div>
              <div class="module-main">
                <div class="module-body">
                  <m.Content />
                </div>
                {m.data.why && (
                  <p class="module-why">
                    <span>Why it closes the gap —</span> {m.data.why}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Sample lesson.
       Deliberately text-only: the game is named, but no character art, logos
       or screenshots appear anywhere — third-party game IP on a nonprofit's
       public curriculum page is risk for no teaching benefit. The figures are
       read off the children's own screens rather than published here, so the
       lesson never goes stale on a balance patch and we never present numbers
       as though they were official game data.
       Justin: this is labelled a sample. Once it has been taught as written,
       say so — "first taught at [school], [month]" is stronger. -->
  <section class="sample tint-sample">
    <div class="container">
      <div class="prose">
        <p class="kicker kicker-teaching">Sample lesson</p>
        <h2>Bigger isn't better</h2>
        <p class="sample-note">
          One session, drawing on the <strong>Mathematics</strong> and{' '}
          <strong>English</strong> modules above. Published as a sample so
          schools can see how a session is built before they host one.
        </p>
        <ul class="sample-meta">
          <li><span>Level</span> P5–P6</li>
          <li><span>Length</span> 60 minutes</li>
          <li><span>Staffing</span> 2 tutors per 8–10 students</li>
        </ul>
      </div>

      <div class="parts">
        <article class="part">
          <p class="part-tag">Part 1 · Maths · 30 min</p>
          <h3>Bigger isn't better</h3>
          <p class="objective">
            <span>Objective</span> Students calculate a rate and explain why a
            larger single value can lose to a smaller one.
          </p>
          <p>
            Each student picks two characters they actually play in{' '}
            <em>Brawl Stars</em> and reads the damage per shot and the reload
            speed off their own screen. Almost always they pick one heavy slow
            hitter and one fast weak one, and almost always they assume the big
            number wins.
          </p>
          <p>
            Then they compute damage per second. The fast one usually comes out
            ahead. The lesson lands in the gap between what they assumed and
            what they calculated: a single number out of context tells you
            nothing, and the useful number is almost always a rate.
          </p>
          <p class="aside">
            <span>Extension</span> What would have to change about the reload
            speed for the answer to flip? A first encounter with solving for an
            unknown, arrived at from curiosity rather than a textbook.
          </p>
          <p class="aside watch">
            <span>Watch for</span> Students who get the arithmetic right but
            can't say why the answer surprised them. The explanation is the
            objective; the multiplication is just the vehicle.
          </p>
        </article>

        <article class="part">
          <p class="part-tag">Part 2 · English · 30 min</p>
          <h3>Make the case</h3>
          <p class="objective">
            <span>Objective</span> Students write a short argument with a claim,
            evidence, a fair statement of the opposing view, and a
            recommendation.
          </p>
          <p>
            They argue which of their two characters is better, using the
            numbers they just calculated as evidence. One hard rule: you must
            write one true sentence explaining why someone would reasonably
            choose the other one. Anyone who can't do that hasn't understood
            their own argument yet.
          </p>
          <p>Sentence frames go on the board for second-language learners:</p>
          <ul class="frames">
            <li>I think ______ is better because ______.</li>
            <li>The evidence is ______.</li>
            <li>Someone might choose ______ instead, because ______.</li>
            <li>Even so, I would recommend ______ because ______.</li>
          </ul>
          <p>
            Four or five sentences is a complete piece of work. Two or three
            students read theirs aloud; the group's job is to identify the
            counterclaim, not to judge who won.
          </p>
          <p class="aside watch">
            <span>Watch for</span> The counterclaim written as a straw man —
            "someone might choose it because they're bad at the game." Send it
            back. Learning to state the other side honestly is the whole point.
          </p>
        </article>
      </div>

      <!-- The line that makes the two halves of AFG one organisation -->
      <p class="sample-link">
        Claim, evidence, the honest case against, recommendation — that is the
        same structure we use in{' '}
        <a class="link-quiet" href="/policy">every proposal we file with the government</a>.
        We teach one method at both ends: to eleven-year-olds, and to the
        bureaux.
      </p>
    </div>
  </section>

  <!-- Partners — a text list, not a logo wall -->
  <section class="partners">
    <div class="container prose">
      <h2 class="section-title">Where we teach</h2>
      <p>
        We teach across 7 schools, including
        <strong> Ho Man Tin Ling To Catholic School</strong> and
        <strong> Kennedy Town School</strong>, and with community partners
        <strong> St. Barnabas' Home &amp; Society</strong> and
        <strong> "10% Organisation"</strong>.
      </p>
    </div>
  </section>

  <!-- In the classroom — photos -->
  <section class="classroom">
    <div class="container">
      <h2 class="section-title">In the classroom</h2>
      <p class="modules-note prose">
        Tutors running sessions at Ho Man Tin Ling To Catholic School.
      </p>
      <div class="gallery">
        {
          photos.map((photo, i) => (
            <button
              type="button"
              class={`shot ${photo.span ? 'shot-wide' : ''}`}
              data-lightbox
              data-src={photo.src}
              data-alt={photo.alt}
              aria-label={`Expand photo: ${photo.alt}`}
            >
              <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="533" />
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Sessions at Victoria Shanghai Academy, by year -->
  <section class="cohorts">
    <div class="container">
      <div class="prose">
        <h2 class="section-title">In partnership with Victoria Shanghai Academy</h2>
        <p class="modules-note">
          Alongside the primary-school programme, we run sessions in
          partnership with Victoria Shanghai Academy for students from the
          local community.
        </p>
      </div>

      {
        cohorts.map((cohort) => (
          <div class="cohort">
            <div class="cohort-head">
              <h3>{cohort.years}</h3>
              <p>{cohort.summary}</p>
            </div>
            <div class="cohort-grid">
              {cohort.photos.map((photo) => (
                <button
                  type="button"
                  class="shot"
                  data-lightbox
                  data-src={photo.src}
                  data-alt={photo.alt}
                  aria-label={`Expand photo: ${photo.alt}`}
                >
                  <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- A moment from the work -->
  <section class="anecdote">
    <div class="container prose">
      <h2 class="section-title">A moment from the work</h2>
      <blockquote class="anecdote-quote">
        We arrived at Ling To expecting to have to convince a room of children
        that AI and current affairs had anything to do with their lives. We
        were wrong. They weren't uninterested — they had simply never been
        handed the spark. Within an hour they were arguing about whether an
        algorithm could be fair. The gap was never curiosity. It was access.
      </blockquote>
    </div>
  </section>
</BaseLayout>

