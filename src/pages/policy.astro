---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/policy.css';
import { getCollection } from 'astro:content';

// Real, filed submissions only (drafts are templates and never render).
// While the collection is empty the page shows the filed-state note below —
// inventing a think tank's output would discredit the whole page.
const submissions = (await getCollection('submissions'))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Policy"
  description="A student-led think tank that submits written recommendations to Hong Kong lawmakers — roughly twenty per year, to the Policy Address, the Budget, and the First Five-Year Plan."

  pageClass="page-policy">
  <section class="page-top">
    <div class="container prose">
      <p class="kicker">Policy</p>
      <h1>A think tank that writes to lawmakers</h1>
      <p class="lead">
        AI For Good's policy arm researches and drafts written recommendations
        to the Hong Kong government. The work is real, filed, and ongoing.
      </p>
    </div>
  </section>

  <!-- The record, as a ruled ledger — one weighted row -->
  <section class="record">
    <div class="container">
      <h2 class="section-title">The record</h2>
      <dl class="ledger">
        <div class="ledger-row">
          <dt class="ledger-figure">~20</dt>
          <dd class="ledger-label">recommendations submitted to government each year</dd>
        </div>
        <div class="ledger-row weighted">
          <dt class="ledger-figure">HK$50M</dt>
          <dd class="ledger-label">
            allocated to <strong>AI for All</strong> in the 2026–27 Budget — the
            inclusive AI programme we argued for.
            <a class="link-quiet" href="#ai-for-all">What we submitted, and what we can claim →</a>
          </dd>
        </div>
        <div class="ledger-row">
          <dt class="ledger-figure">2024–</dt>
          <dd class="ledger-label">
            submissions to Policy Address consultations and Budget proposal
            feedback, every cycle since 2024
          </dd>
        </div>
        <div class="ledger-row">
          <dt class="ledger-figure">2026–2030</dt>
          <dd class="ledger-label">
            currently submitting to the First Five-Year Plan for Economic and
            Social Development
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Flagship: AI for All.
       Attribution is deliberately limited. AI for All is a government
       programme; we recommended an inclusive AI programme and the Budget went
       that way. Nothing here says we caused it, because that is not a claim
       anyone could verify — and one unverifiable claim would put every other
       number on this site in doubt.
       TODO (Justin): link the Budget speech / Budget paper as the source for
       the figures below, and attach the August 2025 submission as a PDF once
       it is cleared for publication. -->
  <section id="ai-for-all" class="flagship">
    <div class="container">
      <div class="prose">
        <p class="kicker">Flagship</p>
        <h2>AI for All</h2>
        <p class="flagship-lede">
          In February 2026, the Hong Kong Budget allocated HK$50 million to an
          inclusive AI programme reaching an estimated 50,000 residents over two
          years, through more than 200 courses, seminars and competitions. It is
          delivered by Cyberport, HKSTP and the Hong Kong Productivity Council,
          with Cyberport's share aimed at students, parents, the elderly and
          underprivileged communities.
        </p>
      </div>

      <!-- The credibility guard, stated before anything else -->
      <p class="attribution">
        <strong>What we can claim:</strong> we recommended it, and the Budget
        went that way. AI for All is the government's programme, funded and
        delivered by public bodies — we did not fund it, run it, or cause it.
      </p>

      <ol class="timeline">
        <li>
          <span class="t-phase">What we noticed<span class="t-date">2024</span></span>
          <span class="t-body">
            Teaching in schools with no AI curriculum and no budget to build
            one, we kept recording the same thing in every classroom. The
            children were quick; what they didn't have was access. The families
            most likely to be left behind by AI were the ones least likely to
            be reached by any programme that ran through schools and employers.
          </span>
        </li>
        <li>
          <span class="t-phase">What we did<span class="t-date">Aug 2025</span></span>
          <span class="t-body">
            We turned what we had seen into a written argument: interviews with
            the members who teach, research on what public provision already
            existed and who it missed, then a proposal stating the case for, the
            case against, and the recommendation. We filed it to the Policy
            Address consultation in August 2025 and made the same case again in
            our Budget feedback.
          </span>
        </li>
        <li>
          <span class="t-phase">What changed<span class="t-date">Feb–Jun 2026</span></span>
          <span class="t-body">
            The 2026–27 Budget allocated HK$50 million to AI for All, and the
            programme launched in June 2026. The argument we had been making
            was echoed in how it was built: Cyberport's share is aimed at
            students, parents, the elderly and underprivileged communities —
            the people we had said a general AI-skills push would reach last.
            The sources are listed below; check them rather than take our word
            for it.
          </span>
        </li>
      </ol>

      <!-- Same three-part structure as every proposal, so the method is
           visible on our own flagship result too. -->
      <article class="proposal" aria-label="AI for All — our submission and our reading of it">
        <div class="proposal-part">
          <p class="part-label">Why we asked for it</p>
          <p class="part-body">
            We teach AI to primary students in schools that had no AI
            curriculum and no budget to build one. The gap was not interest —
            the children were quick — it was access. So our submissions argued
            the same point each year: AI literacy funded only through schools
            and employers will reach the households that already have it, and
            miss the ones that don't. Public money had to be spent on the people
            at the back of the queue, not the front.
          </p>
        </div>
        <div class="proposal-part">
          <p class="part-label">What we submitted</p>
          <p class="part-body">
            In August 2025 we put that argument to the Policy Address
            consultation, and made it again in our Budget feedback: fund AI
            literacy directly for the people least likely to encounter it —
            children in under-resourced schools, their parents, and older
            residents — instead of routing it through institutions that would
            reach them last. We asked for public funding attached to that group
            specifically, rather than a general commitment to AI skills.
          </p>
        </div>
        <div class="proposal-part part-recommendation">
          <p class="part-label">What it means, and what it doesn't</p>
          <p class="part-body">
            The allocation is a start, not a settlement. The government has
            described HK$50 million as an initial figure and the
            50,000-participant target as a baseline shaped by current resources;
            officials have said more funding may follow if demand is there.
            Fifty thousand people is a small fraction of Hong Kong. Our position
            for the next cycle is that the demand exists and the funding should
            follow it, and we intend to say so in our submission to the First
            Five-Year Plan.
          </p>
        </div>
      </article>

      <!-- Sources for the figures above. A page that cites a government
           allocation should show where the numbers come from — it is also
           what lets a reader check the one claim that matters.
           Justin: confirm each link still resolves before launch, and check
           the wording above matches what these actually say. -->
      <aside class="sources" aria-label="Sources for the AI for All figures">
        <p class="sources-label">Sources</p>
        <ul>
          <li>
            <a href="https://www.info.gov.hk/gia/general/202606/10/P2026061000476.htm" rel="noopener">
              Government press release, 10 June 2026
            </a>
            <span>info.gov.hk</span>
          </li>
          <li>
            <a href="https://www.thestandard.com.hk/news/article/334092/HK-launches-50m-AI-for-All-campaign-to-benefit-50000-residents" rel="noopener">
              "HK launches $50m AI for All campaign to benefit 50,000 residents"
            </a>
            <span>The Standard</span>
          </li>
          <li>
            <a href="https://www.scmp.com/news/hong-kong/hong-kong-economy/article/3365474/hong-kong-launch-free-ai-courses-tech-giants-google-microsoft-smes" rel="noopener">
              "Hong Kong to launch free AI courses with tech giants Google, Microsoft for SMEs"
            </a>
            <span>South China Morning Post</span>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- The method, shown structurally -->
  <section class="method">
    <div class="container">
      <h2 class="section-title">How a proposal is made</h2>
      <!-- Justin: adjust the detail under each step to match how the team
           actually works — this is the section a sceptical reader uses to
           decide whether the work is systematic or ad hoc. -->
      <ol class="steps-detail">
        <li>
          <span class="step-num">1</span>
          <div>
            <h3>Member interviews</h3>
            <p>
              Topics come from what members have seen, not from whatever is in
              the news. We interview the people who teach: what they ran into in
              a classroom, which children it affected, and whether it happened
              once or every week. A problem that only one person has noticed
              goes back for more evidence before it becomes a proposal.
            </p>
          </div>
        </li>
        <li>
          <span class="step-num">2</span>
          <div>
            <h3>Research</h3>
            <p>
              We then test whether it is a policy problem at all. What does the
              government already fund in this area, who does that provision
              reach, and who does it miss? What have comparable jurisdictions
              tried, and what did it cost? If existing policy already covers the
              problem, we say so and stop — the point of this step is to kill
              proposals, not to justify them.
            </p>
          </div>
        </li>
        <li>
          <span class="step-num">3</span>
          <div>
            <h3>Drafting and filing</h3>
            <p>
              A member drafts the proposal in the three-part shape below, and
              the case against is written to be as strong as we can honestly
              make it. If it wins, the proposal does not go out. What survives
              is filed to whichever consultation is open — the Policy Address
              consultation, Budget proposal feedback, or a bureau's own call for
              views — with the recommendation stated plainly enough to be
              actioned.
            </p>
          </div>
        </li>
      </ol>

      <p class="method-note prose">
        Every proposal takes the same shape — and it's the shape, not the
        length, that makes the work credible:
      </p>

      <!-- The standing proposal template. Real submissions below render in
           exactly this structure; here it carries the method itself. -->
      <article class="proposal proposal-demo" aria-label="The structure every proposal follows">
        <header class="proposal-head">
          <h3 class="proposal-title">Every proposal, the same shape</h3>
          <p class="proposal-meta">The standing structure of an AFG submission</p>
        </header>
        <div class="proposal-part">
          <p class="part-label">The case for</p>
          <p class="part-body">
            The strongest arguments in favour, steel-manned — what the policy
            would achieve and for whom, grounded in evidence.
          </p>
        </div>
        <div class="proposal-part">
          <p class="part-label">The case against</p>
          <p class="part-body">
            The honest counter-case — costs, risks, and who bears them. If the
            against-case wins, the proposal isn't filed.
          </p>
        </div>
        <div class="proposal-part part-recommendation">
          <p class="part-label">Recommendation</p>
          <p class="part-body">
            What we ask the government to do, stated plainly — only after both
            cases have been made.
          </p>
        </div>
      </article>
    </div>
  </section>

  <!-- Filed submissions -->
  <section class="filings">
    <div class="container">
      <h2 class="section-title">Submissions</h2>
      {
        submissions.length === 0 ? (
          <p class="empty-note">Submissions are published here after they are filed.</p>
        ) : (
          <div class="filed-list">
            {submissions.map((s) => (
              <article class="proposal">
                <header class="proposal-head">
                  <h3 class="proposal-title">{s.data.title}</h3>
                  <p class="proposal-meta">
                    Submitted to {s.data.submittedTo} · {s.data.date}
                  </p>
                </header>
                <div class="proposal-part">
                  <p class="part-label">The case for</p>
                  <p class="part-body">{s.data.for}</p>
                </div>
                <div class="proposal-part">
                  <p class="part-label">The case against</p>
                  <p class="part-body">{s.data.against}</p>
                </div>
                <div class="proposal-part part-recommendation">
                  <p class="part-label">Recommendation</p>
                  <p class="part-body">{s.data.recommendation}</p>
                </div>
                {s.data.pdf && (
                  <p class="proposal-pdf">
                    <a class="link-quiet" href={s.data.pdf}>Read the full submission (PDF) →</a>
                  </p>
                )}
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

