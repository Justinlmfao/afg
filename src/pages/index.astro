---
// Home page. The words that also appear elsewhere (the AI for All case, the
// figures, the "Now" note) come from src/data/; the rest is written here.
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import NowStrip from '../components/NowStrip.astro';
import FigureRow from '../components/FigureRow.astro';
import Case from '../components/Case.astro';
import Ledger from '../components/Ledger.astro';
import Steps from '../components/Steps.astro';
import Gallery from '../components/Gallery.astro';
import MarginNote from '../components/MarginNote.astro';
import '../styles/pages/home.css';
import { getCollection } from 'astro:content';
import { facts, showSamples } from '../data/facts';
import { aiForAllCase } from '../data/cases';
import { formatDate } from '../lib/dates';
import { getSubmissions, submissionHref } from '../lib/submissions';
import { getLangFromUrl } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const f = facts;
const story = aiForAllCase(lang, { document: '/policy#ai-for-all' });
// The proposals with a page of their own.
const proposals = (await getSubmissions(lang)).filter((s) => s.hasPaper);
const modules = (await getCollection('programs'))
  .filter((m) => !m.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
// Photographs for the proposal cards, in order. They show our own work in
// class, so they are decorative here (empty alt text).
const cardPhotos = ['teaching-chalkboard-maths.jpg', 'team-outside-school.jpg'];
---

<BaseLayout
  title="AI For Good Hong Kong: student-led AI policy research and free tutoring"
  pageClass="page-home"
  description="AI For Good is run by students in Hong Kong. We send the government around twenty policy recommendations a year, and teach primary school children from underprivileged families, for free."
>
  <!-- "Now": what we're working on this month, in a strip under the header -->
  <NowStrip />

  <!-- Hero: the classroom photo runs to the right edge of the screen and the
       words sit on a paper panel over its top-left corner. On phones the
       panel overlaps the bottom of the photo instead. The hand-drawn marks
       (.drawn-under, .drawn-circle) are the only pencil colour on the page. -->
  <div class="hero-stage">
    <figure class="hero-photo">
      <Photo
        name="teaching-classroom.jpg"
        alt="A tutor leads a session at Ho Man Tin Ling To Catholic School while a pupil raises her hand to answer."
        sizes="(min-width: 60rem) 75vw, 100vw"
        position="62% 45%"
        positionPhone="68% 40%"
        eager
      />
      <figcaption>A tutoring session at Ho Man Tin Ling To Catholic School.</figcaption>
    </figure>
    <div class="hero-text">
      <h1>We teach kids in Hong Kong <span class="drawn-under">for free</span>, then tell the government what we saw in class.</h1>
      <p class="lead">In 2024 we were teaching in schools with no AI lessons and no money to start any. In August 2025 we put what we saw into our Policy Address submission. The {f.aiForAll.budget} Budget gave <span class="drawn-circle">{f.aiForAll.amount.en}</span> to AI for All, the kind of programme we'd asked for.</p>
      <p class="hero-sub">We're more than 35 students. We study how AI and economic policy are changing the city, send around {f.recsPerYear.word.en} recommendations a year to the government, and teach AI and economics, for free, to primary school children from underprivileged families.</p>
      <div class="actions">
        <a class="btn" href="/policy">See what we told the government</a>
        <a class="textlink" href="/teaching/sample-lesson">Try one of our lessons</a>
      </div>
    </div>
    <p class="hand-note">Our tutors are still at secondary school themselves.</p>
  </div>

  <div class="wrap hero-figures">
    <FigureRow
    items={[
      { figure: f.recsPerYear.value, label: 'recommendations a year' },
      { figure: f.children.value, label: 'children taught' },
      { figure: f.schools.value, label: 'partner schools' },
      { figure: f.tutors.value, label: 'student tutors trained' },
    ]}
    />
  </div>

  <!-- The two halves of the work, each in its own colour: what it is on the
       pale ground, and the one outcome it rests on in the solid band. -->
  <div class="halves doors">
    <section class="half-col tone-policy" aria-labelledby="door-policy">
      <div class="half washed door">
        <h2 id="door-policy">Policy</h2>
        <p>
          We write recommendations to the Hong Kong government, and have responded to every Policy
          Address and Budget consultation since 2024.
        </p>
        <p class="door-number">{f.recsPerYear.value} <span>recommendations a year</span></p>
        <a class="textlink" href="/policy">Every submission we've sent</a>
      </div>
      <div class="half band">
        <p class="proof-figure">HK$50M</p>
        <p class="proof-label">
          allocated to AI for All in the {f.aiForAll.budget} Budget, the kind of inclusive AI programme
          we'd been arguing for
        </p>
      </div>
    </section>
    <section class="half-col tone-teaching" aria-labelledby="door-teaching">
      <div class="half washed door">
        <h2 id="door-teaching">Teaching</h2>
        <p>
          Free tutoring for primary school children, run by student tutors we train ourselves, in
          seven schools.
        </p>
        <p class="door-number">{f.children.value} <span>children taught</span></p>
        <a class="textlink" href="/teaching">How our lessons work</a>
      </div>
      <div class="half band">
        <p class="proof-figure">{f.bandUp.value}{f.bandUp.unit}</p>
        <p class="proof-label">
          of our students have moved up at least one class band since {f.bandUp.since}
        </p>
      </div>
    </section>
  </div>

  <section class="sec tone-policy" aria-labelledby="ai-for-all">
    <div class="wrap">
      <Case id="ai-for-all" {...story}>
        <a slot="claim-more" href="/policy#ai-for-all">{story.more}</a>
      </Case>
    </div>
  </section>

  <section class="sec" aria-labelledby="who-h">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="who-h">Who we are</h2>
      </div>
      <div class="prose">
        <p class="tagline">Policy for a technology we'll inherit.</p>
        <p>
          No adults run this. AI For Good was started by students in June 2023, and it's still run
          entirely by students. There are more than 35 of us now. We began outside school as an
          independent think tank, and since then we've teamed up with schools across Hong Kong. We do two
          things side by side: we write evidence-based recommendations for the government, and we teach
          the children who feel the effects of those decisions first. Some weeks that means drafting a
          submission; other weeks it means standing at a whiteboard in front of a primary class.
        </p>
        <p><a class="textlink" href="/about">More about us</a></p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="current-h">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="current-h">What we're working on</h2>
      </div>
      <ul class="current-list">
        <li class="tone-policy">
          <span class="tone-tag">Policy</span>
          <span>
            Our submission to the First Five-Year Plan for Economic and Social Development (2026–2030).
            We're arguing that AI funding should go where the need is, not just where programmes already
            exist.
          </span>
        </li>
        <li class="tone-teaching">
          <span class="tone-tag">Teaching</span>
          <span>Going back to Ho Man Tin Ling To Catholic School next year with a new group of tutors.</span>
        </li>
      </ul>
    </div>
  </section>

  <figure class="photo photo-break">
    <Photo
      name="vsa-2025-26-cohort.jpg"
      alt="The 2025/26 group of students and tutors together in the classroom."
      sizes="100vw"
      position="50% 45%"
    />
    <figcaption class="wrap">Our 2025–26 students and tutors, at our community sessions with Victoria Shanghai Academy.</figcaption>
  </figure>

  <section class="sec tone-policy washed" aria-labelledby="policy-h">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="policy-h">We've answered every Policy Address and Budget consultation since 2024.</h2>
        <p>Every proposal states the case for, the case against, then what we recommend.</p>
      </div>
      <div>
        <Ledger rows={proposals} variant="brief" heading="Other recent proposals" caption="Other recent proposals" />
        <a class="more" href="/policy#submissions">All our submissions</a>
      </div>
    </div>
  </section>

  <section class="sec tone-teaching washed" aria-labelledby="teaching-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="teaching-h">Children try first, and ask the AI for a hint, never the answer.</h2>
        <p>Every lesson follows the same four steps, in maths, English, economics and science.</p>
      </div>
      <Steps
        items={[
          { name: 'Attempt', text: 'Try the problem alone first.' },
          { name: 'Ask', text: 'Ask the AI for a hint or a check.' },
          { name: 'Check', text: 'Compare its reply with your own work.' },
          { name: 'Explain', text: 'AI off. Explain it in your own words.' },
        ]}
      />
      <!-- A real line from one of our tutors (in full on the Teaching page) -->
      <figure class="home-quote">
        <blockquote><p>Curiosity was never what was missing. Access was.</p></blockquote>
        <figcaption>One of our tutors, after a session at Ho Man Tin Ling To Catholic School. <a href="/teaching#a-moment">The whole story</a></figcaption>
      </figure>
      <Gallery
        photos={[
          {
            name: 'teaching-ai-study-partner.jpg',
            alt: 'A tutor teaches a primary class using an AI study partner shown on the screen.',
            caption: 'Using AI as a study partner at Ho Man Tin Ling To Catholic School.',
          },
          {
            name: 'vsa-2025-26-helping.jpg',
            alt: 'A tutor helps a pupil at a laptop.',
            caption: 'Community session with Victoria Shanghai Academy, 2025–26.',
          },
          {
            name: 'vsa-2024-25-presenting.jpg',
            alt: 'Two tutors present to a room of young people.',
            caption: 'Community session, 2024–25.',
          },
        ]}
      />
      <div class="noted facts">
        <p class="facts-main">
          Our {f.tutors.value} trained tutors have taught {f.children.value} children in {f.schools.word.en} schools. Since {f.bandUp.since}, {f.bandUp.value}{f.bandUp.unit} of our students have moved up at least one class band.
        </p>
        <MarginNote label="About that number.">
          We don't claim it as ours alone. Teachers, families and the students themselves did the work. But
          it's the number we hold ourselves to.{' '}
          {(!f.bandUp.method.sample || showSamples) && <a href="/teaching#results">How we count it</a>}
        </MarginNote>
      </div>
      <a class="more" href="/teaching">Our teaching, modules and a sample lesson</a>
    </div>
  </section>

  <!-- Latest work, straight from the collections. The flagship leads. -->
  <section class="sec" aria-labelledby="latest-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="latest-h">Latest work</h2>
      </div>
      <div class="latest">
        <ul class="latest-cards">
          <li class="tone-policy">
            <a class="card" href="/policy#ai-for-all">
              <Photo name="vsa-2025-26-uses.jpg" alt="" sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 45vw, 100vw" widths={[480, 800]} position="50% 35%" />
              <span class="tone-tag">Flagship</span>
              <span class="card-title">AI for All: {f.aiForAll.amount.en} in the {f.aiForAll.budget} Budget</span>
              <span class="latest-meta">2024–2026</span>
            </a>
          </li>
          {
            proposals.map((s, i) => (
              <li class="tone-policy">
                <a class="card" href={submissionHref(s, lang)}>
                  <Photo name={cardPhotos[i % cardPhotos.length]} alt="" sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 45vw, 100vw" widths={[480, 800]} />
                  <span class="tone-tag">Proposal</span>
                  <span class="card-title">{s.title}</span>
                  <span class="latest-meta">{formatDate(s.date, lang, 'long')}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="latest-modules">
          {
            modules.map((m) => (
              <li class="tone-teaching">
                <span class="tone-tag">Module</span>
                <a href="/teaching#modules">{m.data.title}</a>
                <span class="latest-meta">Teaching</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="partners-h">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="partners-h">Who we work with</h2>
      </div>
      <p class="prose">
        Ho Man Tin Ling To Catholic School · St. Barnabas' Home &amp; Society · Kennedy Town School ·
        10% Organisation
      </p>
    </div>
  </section>
</BaseLayout>
