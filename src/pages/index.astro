---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/home.css';
import { getCollection } from 'astro:content';
import { getLangFromUrl } from '../i18n';
import { getLatestPapers, formatMonth, paperLabels } from '../papers';

// Latest work, pulled from the collections so the page stays current as
// entries are added — no layout edits needed. Papers only appear once a real
// one is published (drafts never render); the three most recently written
// are shown, each labelled with what it is.
const lang = getLangFromUrl(Astro.url);
const label = paperLabels[lang];
const papers = await getLatestPapers(lang, 3);

const modules = (await getCollection('programs'))
  .filter((m) => !m.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout pageClass="page-home" title="AI For Good Hong Kong: student-led AI policy and free tutoring">
  <!-- 1. Hero — editorial and quiet. No AI imagery: serif headline, one
       accent, four verified figures under a hairline. The HK$50M is
       deliberately kept out of the hero; it needs a sentence of context and
       gets one further down and in full on /policy. -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">
        <span class="eyebrow-rule" aria-hidden="true"></span>
        Student-led policy research
      </p>

      <h1>Policy for a technology we'll inherit.</h1>

      <p class="hero-sub">
        We're a group of students in Hong Kong. We study how AI and economic
        policy are changing the city, and send around twenty recommendations a
        year to the government. We also teach AI and economics, for free, to
        primary school children from underprivileged families.
      </p>

      <div class="hero-actions">
        <a class="btn btn-policy" href="/policy">
          Read our policy work <span class="arrow">→</span>
        </a>
        <a class="hero-secondary" href="/teaching">
          See our teaching <span class="arrow">→</span>
        </a>
      </div>

      <dl class="stat-strip">
        <div>
          <dt>~20</dt>
          <dd>recommendations a year</dd>
        </div>
        <div>
          <dt>350</dt>
          <dd>children taught</dd>
        </div>
        <div>
          <dt>7</dt>
          <dd>partner schools</dd>
        </div>
        <div>
          <dt>43</dt>
          <dd>student tutors trained</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- One real photograph, full-bleed. Justin: add the month and year to the
       caption below once you have them — a dated caption is worth more than
       an undated one. -->
  <figure class="hero-photo-band">
    <img
      src="/programs/teaching-classroom.jpg"
      alt="A tutor leads a session at Ho Man Tin Ling To Catholic School while a pupil raises her hand to answer."
      loading="lazy"
      decoding="async"
    />
    <figcaption>
      A tutoring session at Ho Man Tin Ling To Catholic School.
    </figcaption>
  </figure>

  <!-- 2. The two doors — the routing decision this page exists to serve -->
  <section class="doors-section">
    <div class="container doors">
      <a href="/policy" class="door door-policy">
        <p class="door-name">Policy</p>
        <p class="door-line">
          We write recommendations to the Hong Kong government, and have
          responded to every Policy Address and Budget consultation since 2024.
        </p>
        <p class="door-number">~20 <span>recommendations a year</span></p>
        <span class="door-cta">Read our policy work <span class="arrow">→</span></span>
      </a>

      <a href="/teaching" class="door door-teaching">
        <p class="door-name">Teaching</p>
        <p class="door-line">
          Free tutoring for primary school children, run by student tutors we
          train ourselves, in seven schools.
        </p>
        <p class="door-number">350 <span>children taught</span></p>
        <span class="door-cta">See our teaching <span class="arrow">→</span></span>
      </a>
    </div>
  </section>

  <!-- 3. Proof — two outcomes, not six stats -->
  <section class="proof">
    <div class="container proof-grid">
      <div class="proof-item">
        <p class="proof-figure proof-policy">HK$50M</p>
        <p class="proof-label">
          allocated to AI for All in the 2026–27 Budget, the kind of inclusive
          AI programme we'd been arguing for
        </p>
      </div>
      <div class="proof-item">
        <p class="proof-figure proof-teaching">
          <span data-count="86">86</span>%
        </p>
        <p class="proof-label">
          of our students have moved up at least one class band since 2024
        </p>
      </div>
    </div>
  </section>

  <!-- 4. The short version -->
  <section class="section-tight rail-section">
    <div class="container rail">
      <h2 class="rail-head">Who we are</h2>
      <div class="rail-body prose">
        <p>
          AI For Good was started by students in June 2023, and it's still run
          entirely by students. There are more than 35 of us now. We began
          outside school as an independent think tank, and since then we've
          teamed up with schools across Hong Kong. We do two things side by side:
          we write evidence-based recommendations for the government, and we teach
          the children who feel the effects of those decisions first.{' '}
          <a class="link-quiet nowrap" href="/about">More about us →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- 5. Current work -->
  <section class="section-tight current rail-section">
    <div class="container rail">
      <h2 class="rail-head">What we're working on</h2>
      <div class="rail-body">
        <ul class="current-list">
          <li>
            <span class="current-tag current-policy">Policy</span>
            <!-- The 2026-30 consultation window closed on 14 August 2026, so
                 this no longer claims it is open. Justin: if the submission has
                 been filed, say so here — "Filed to the First Five-Year Plan…"
                 is stronger than "working on". -->
            <span class="current-body">
              Our submission to the First Five-Year Plan for Economic and Social
              Development (2026–2030). We're arguing that AI funding should go
              where the need is, not just where programmes already exist.
            </span>
          </li>
          <li>
            <span class="current-tag current-teaching">Teaching</span>
            <span class="current-body">
              Going back to Ho Man Tin Ling To Catholic School next year with a
              new group of tutors.
            </span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 6. Latest work, straight from the collections -->
  <section class="section-tight latest rail-section">
    <div class="container rail">
      <h2 class="rail-head">Latest work</h2>
      <div class="rail-body">
        <ul class="latest-list">
          <!-- The flagship always leads the list -->
          <li>
            <a href="/policy#ai-for-all">
              <span class="latest-kind latest-policy">Flagship</span>
              <span class="latest-title">AI for All: HK$50 million in the 2026–27 Budget</span>
              <span class="latest-meta">2024–2026</span>
            </a>
          </li>
          {
            papers.map((s) => (
              <li>
                <a href={`/policy#${s.data.key}`}>
                  <span class="latest-kind latest-policy">{label.kind[s.data.kind]}</span>
                  <span class="latest-title">{s.data.title}</span>
                  <span class="latest-meta">{formatMonth(s.data.written, lang)}</span>
                </a>
              </li>
            ))
          }
          {
            modules.map((m) => (
              <li>
                <a href="/teaching">
                  <span class="latest-kind latest-teaching">Module</span>
                  <span class="latest-title">{m.data.title}</span>
                  <span class="latest-meta">Teaching</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 7. Partners, as text -->
  <section class="section-tight partners rail-section">
    <div class="container rail">
      <h2 class="rail-head">Who we work with</h2>
      <div class="rail-body prose">
        <p>
          Ho Man Tin Ling To Catholic School · St. Barnabas' Home &amp; Society ·
          Kennedy Town School · 10% Organisation
        </p>
      </div>
    </div>
  </section>

  <!-- 8. Two calls to action -->
  <section class="ctas">
    <div class="container cta-grid">
      <div class="cta">
        <h2 class="h-sm">Schools and organisations</h2>
        <p>
          If you work with children from underprivileged families and could use
          tutors, we'll bring the lessons, the tutors and the equipment.
        </p>
        <a class="btn btn-teaching" href="/get-involved">
          Work with us <span class="arrow">→</span>
        </a>
      </div>
      <div class="cta">
        <h2 class="h-sm">Students</h2>
        <p>
          We're recruiting at Victoria Shanghai Academy. If you're interested in
          policy, economics or AI, we'd love to hear from you.
        </p>
        <a class="btn btn-policy" href="/get-involved">
          Join us <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
