---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="AI For Good">
  <!-- Intro: one plain statement, then route the reader to a pillar -->
  <section class="intro">
    <div class="container">
      <h1 class="intro-line">
        AI For Good is a student-led organisation in Hong Kong, founded in June
        2023. It does two things.
      </h1>
    </div>
  </section>

  <!-- The two pillars. Same grid, different inks: policy is dense and ruled;
       teaching is warm and airy. A reader knows which side they're on in
       five seconds. -->
  <section class="pillars-section">
    <div class="container pillars">
      <!-- Pillar 1: Policy -->
      <a href="/policy" class="pillar pillar-policy" data-reveal>
        <p class="pillar-kicker">1 · Policy</p>
        <h2>A think tank that writes to lawmakers</h2>
        <p class="pillar-desc">
          Members research and draft written recommendations to the Hong Kong
          government — each one stating the case for, the case against, then
          the recommendation.
        </p>
        <ul class="pillar-facts">
          <li><strong>~20</strong> recommendations submitted to government each year</li>
          <li><strong>HK$50M</strong> government AI course commitment</li>
          <li>Policy Address and Budget consultations since 2024; currently submitting to the First Five-Year Plan (2026–2030)</li>
        </ul>
        <span class="pillar-cta">Read the policy work <span class="arrow">→</span></span>
      </a>

      <!-- Pillar 2: Teaching -->
      <a href="/teaching" class="pillar pillar-teaching" data-reveal style="--reveal-delay:0.1s">
        <img
          class="pillar-photo"
          src="/programs/teaching-classroom.jpg"
          alt="A tutor leads a session at Ho Man Tin Ling To Catholic School while a pupil raises her hand to answer."
          loading="lazy"
          decoding="async"
          width="1600"
          height="1066"
        />
        <p class="pillar-kicker">2 · Teaching</p>
        <h2>Free tutoring for children the system overlooks</h2>
        <p class="pillar-desc">
          Trained student tutors teach underprivileged primary students across
          Hong Kong — maths, English, economics, and science, each paired with
          AI as a learning tool.
        </p>
        <p class="pillar-outcome">
          <strong>86%</strong> of students moved up at least one class band
          since 2024.
        </p>
        <ul class="pillar-facts">
          <li><strong>350</strong> children taught across <strong>7</strong> schools</li>
          <li><strong>43</strong> tutors trained</li>
        </ul>
        <span class="pillar-cta">See the teaching <span class="arrow">→</span></span>
      </a>
    </div>
  </section>

  <!-- Quiet strip -->
  <div class="quiet-strip">
    <div class="container">
      <p>35+ members · student-led and student-founded · Hong Kong</p>
    </div>
  </div>

  <!-- Short story — no club-status claims, present tense -->
  <section>
    <div class="container prose">
      <p class="kicker">Where it comes from</p>
      <h2>Students who didn't wait for permission</h2>
      <p>
        AI For Good was founded in June 2023 by Justin Lo, a secondary school
        student in Hong Kong. The questions raised by AI and by economic policy
        — about fairness, access, and who gets a say — will land hardest on the
        generation now in school. So the organisation works on them directly:
        it writes to the people making the decisions, and it teaches the
        children with the least access to the tools.
      </p>
      <p>
        Two habits hold across both pillars: every claim is grounded in
        evidence, and every argument states its own counter-case before it asks
        for anything.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: clamp(3rem, 8vw, 6rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .intro-line {
    font-weight: 400;
    max-width: 24ch;
  }

  .pillars-section {
    padding-top: 0;
  }

  .pillars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 2.1rem 2.2rem 1.9rem;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
    border-top-width: 4px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    overflow: hidden;
  }

  /* Teaching carries a photograph; policy stays ruled and textual — the two
     pillars are meant to look different. */
  .pillar-photo {
    width: calc(100% + 4.4rem);
    margin: -2.1rem -2.2rem 0.4rem;
    height: 11rem;
    object-fit: cover;
    object-position: center 38%;
  }

  .pillar:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px rgba(28, 27, 24, 0.1);
    color: var(--ink);
  }

  .pillar h2 {
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
  }

  .pillar-desc {
    color: var(--graphite);
  }

  .pillar-kicker {
    font-weight: 650;
    font-size: 0.92rem;
  }

  /* Policy: cool wash, ruled, denser */
  .pillar-policy {
    background: var(--policy-wash);
    border-top-color: var(--policy);
  }

  .pillar-policy .pillar-kicker {
    color: var(--policy);
  }

  .pillar-policy .pillar-facts {
    list-style: none;
    padding: 0;
    margin-top: 0.25rem;
    border-top: 1px solid var(--rule);
  }

  .pillar-policy .pillar-facts li {
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.95rem;
    color: var(--graphite);
  }

  .pillar-policy .pillar-facts strong {
    color: var(--policy-deep);
    font-weight: 650;
  }

  .pillar-policy .pillar-cta {
    color: var(--policy);
  }

  /* Teaching: warm wash, airier */
  .pillar-teaching {
    background: var(--teaching-wash);
    border-top-color: var(--teaching);
  }

  .pillar-teaching .pillar-kicker {
    color: var(--teaching);
  }

  .pillar-outcome {
    font-size: 1.05rem;
    border-left: 3px solid var(--teaching);
    padding-left: 0.9rem;
  }

  .pillar-outcome strong {
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--teaching-deep);
  }

  .pillar-teaching .pillar-facts {
    list-style: none;
    padding: 0;
    color: var(--graphite);
    font-size: 0.95rem;
  }

  .pillar-teaching .pillar-facts li + li {
    margin-top: 0.3rem;
  }

  .pillar-teaching .pillar-facts strong {
    color: var(--ink);
    font-weight: 650;
  }

  .pillar-teaching .pillar-cta {
    color: var(--teaching-deep);
  }

  .pillar-cta {
    margin-top: auto;
    font-weight: 650;
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
  }

  .pillar-cta .arrow {
    transition: transform 0.15s ease;
  }

  .pillar:hover .pillar-cta .arrow {
    transform: translateX(4px);
  }

  .quiet-strip {
    border-block: 1px solid var(--rule);
    padding-block: 0.9rem;
    color: var(--graphite);
    font-size: 0.95rem;
  }

  @media (max-width: 52rem) {
    .pillars {
      grid-template-columns: 1fr;
    }
  }
</style>
