---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Latest work, pulled from the collections so the page stays current as
// entries are added — no layout edits needed. Submissions only appear once a
// real, filed one is published (drafts never render), so until then this
// section shows the teaching modules alone rather than placeholder cards.
const submissions = (await getCollection('submissions'))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const modules = (await getCollection('programs'))
  .filter((m) => !m.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout title="AI For Good">
  <!-- 1. Hero — editorial and quiet. No AI imagery: serif headline, one
       accent, four verified figures under a hairline. The HK$50M is
       deliberately kept out of the hero; it needs a sentence of context and
       gets one further down and in full on /policy. -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow-mono">
        <span class="eyebrow-rule" aria-hidden="true"></span>
        Student-led policy research
      </p>

      <h1>Policy for a technology we'll inherit.</h1>

      <p class="hero-sub">
        We research how AI and economic policy shape Hong Kong, and file around
        twenty recommendations a year to government consultations. We also
        teach AI and economic literacy, free, to underprivileged primary
        students — the children those decisions reach first.
      </p>

      <div class="hero-actions">
        <a class="btn btn-policy" href="/policy">
          Read the policy work <span class="arrow">→</span>
        </a>
        <a class="hero-secondary" href="/teaching">
          Our teaching programme <span class="arrow">→</span>
        </a>
      </div>

      <dl class="stat-strip">
        <div>
          <dt>~20</dt>
          <dd>recommendations to government each year</dd>
        </div>
        <div>
          <dt>350</dt>
          <dd>children taught</dd>
        </div>
        <div>
          <dt>7</dt>
          <dd>partner schools</dd>
        </div>
        <div>
          <dt>43</dt>
          <dd>tutors trained</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- One real photograph, full-bleed. Justin: add the month and year to the
       caption below once you have them — a dated caption is worth more than
       an undated one. -->
  <figure class="hero-photo-band">
    <img
      src="/programs/teaching-classroom.jpg"
      alt="A tutor leads a session at Ho Man Tin Ling To Catholic School while a pupil raises her hand to answer."
      loading="lazy"
      decoding="async"
    />
    <figcaption>
      Ho Man Tin Ling To Catholic School — a session from the tutoring
      programme.
    </figcaption>
  </figure>

  <!-- 2. The two doors — the routing decision this page exists to serve -->
  <section class="doors-section">
    <div class="container doors">
      <a href="/policy" class="door door-policy">
        <p class="door-name">Policy</p>
        <p class="door-line">
          Written recommendations to the Hong Kong government, filed to Policy
          Address and Budget consultations since 2024.
        </p>
        <p class="door-number">~20 <span>recommendations a year</span></p>
        <span class="door-cta">Read the policy work <span class="arrow">→</span></span>
      </a>

      <a href="/teaching" class="door door-teaching">
        <p class="door-name">Teaching</p>
        <p class="door-line">
          Free tutoring for underprivileged primary students, delivered by
          trained student tutors across seven schools.
        </p>
        <p class="door-number">350 <span>children taught</span></p>
        <span class="door-cta">See the teaching <span class="arrow">→</span></span>
      </a>
    </div>
  </section>

  <!-- 3. Proof — two outcomes, not six stats -->
  <section class="proof">
    <div class="container proof-grid">
      <div class="proof-item">
        <p class="proof-figure proof-policy">HK$50M</p>
        <p class="proof-label">
          allocated to AI for All in the 2026–27 Budget — the inclusive AI
          programme we argued for
        </p>
      </div>
      <div class="proof-item">
        <p class="proof-figure proof-teaching">
          <span data-count="86">86</span>%
        </p>
        <p class="proof-label">
          of our students have moved up at least one class band since 2024
        </p>
      </div>
    </div>
  </section>

  <!-- 4. The short version -->
  <section class="section-tight">
    <div class="container prose">
      <p>
        AI For Good is student-led and student-founded, started in Hong Kong in
        June 2023 and run entirely by students — 35+ of them. We began outside
        school as an independent think tank, and have since expanded into
        partnerships with schools across the city. We do two things at once:
        file evidence-based recommendations to government, and teach the
        children those decisions will reach first.{' '}
        <a class="link-quiet" href="/about">Read about us →</a>
      </p>
    </div>
  </section>

  <!-- 5. Current work -->
  <section class="section-tight current">
    <div class="container">
      <h2 class="h-sm">Current work</h2>
      <ul class="current-list">
        <li>
          <span class="current-tag current-policy">Policy</span>
          <!-- The 2026-30 consultation window closed on 14 August 2026, so
               this no longer claims it is open. Justin: if the submission has
               been filed, say so here — "Filed to the First Five-Year Plan…"
               is stronger than "working on". -->
          <span class="current-body">
            Our submission to the First Five-Year Plan for Economic and Social
            Development (2026–2030), arguing that AI funding should follow
            demand rather than existing provision.
          </span>
        </li>
        <li>
          <span class="current-tag current-teaching">Teaching</span>
          <span class="current-body">
            Returning to Ho Man Tin Ling To Catholic School next year, with a
            new cohort of tutors.
          </span>
        </li>
      </ul>
    </div>
  </section>

  <!-- 6. Latest work, straight from the collections -->
  <section class="section-tight latest">
    <div class="container">
      <h2 class="h-sm">
        {submissions.length > 0 ? 'Latest submissions and programmes' : 'What we teach'}
      </h2>
      <ul class="latest-list">
        {
          submissions.map((s) => (
            <li>
              <a href="/policy">
                <span class="latest-kind latest-policy">Submission</span>
                <span class="latest-title">{s.data.title}</span>
                <span class="latest-meta">{s.data.date}</span>
              </a>
            </li>
          ))
        }
        {
          modules.map((m) => (
            <li>
              <a href="/teaching">
                <span class="latest-kind latest-teaching">Module</span>
                <span class="latest-title">{m.data.title}</span>
                <span class="latest-meta">Teaching</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. Partners, as text -->
  <section class="section-tight partners">
    <div class="container prose">
      <h2 class="h-sm">Partners</h2>
      <p>
        Ho Man Tin Ling To Catholic School · St. Barnabas' Home &amp; Society ·
        Kennedy Town School · 10% Organisation
      </p>
    </div>
  </section>

  <!-- 8. Two calls to action -->
  <section class="ctas">
    <div class="container cta-grid">
      <div class="cta">
        <h2 class="h-sm">Schools and organisations</h2>
        <p>
          If you work with underprivileged students and want tutors, we bring
          the curriculum, the tutors, and the equipment.
        </p>
        <a class="btn btn-teaching" href="/get-involved">
          Work with us <span class="arrow">→</span>
        </a>
      </div>
      <div class="cta">
        <h2 class="h-sm">Students</h2>
        <p>
          We have opened recruitment at Victoria Shanghai Academy for students
          interested in policy, economics, and AI.
        </p>
        <a class="btn btn-policy" href="/get-involved">
          Join us <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .h-sm {
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }

  /* 1. Hero — single column, left-aligned, generous air */
  .hero {
    padding-block: 4.5rem 3rem;
  }

  @media (min-width: 52rem) {
    .hero {
      padding-block: 7.5rem 5rem;
    }
  }

  .hero-inner {
    max-width: 1100px;
  }

  /* Mono eyebrow with a short hairline lead-in */
  .eyebrow-mono {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--graphite);
    margin-bottom: 1.5rem;
  }

  .eyebrow-rule {
    display: block;
    width: 18px;
    height: 1px;
    background: var(--ink);
    flex-shrink: 0;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 15ch;
  }

  .hero-sub {
    margin-top: 1.75rem;
    max-width: 56ch;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--graphite);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.5rem;
  }

  .hero-secondary {
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1.5px solid var(--rule);
    padding-bottom: 2px;
    transition: border-color 0.15s ease;
  }

  .hero-secondary:hover {
    border-bottom-color: var(--ink);
    color: var(--ink);
  }

  .hero-secondary .arrow,
  .hero-actions .arrow {
    display: inline-block;
    transition: transform 0.15s ease;
  }

  .hero-secondary:hover .arrow {
    transform: translateX(3px);
  }

  /* Four verified figures under a hairline */
  .stat-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem 2rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .stat-strip dt {
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .stat-strip dd {
    margin: 0.45rem 0 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--graphite);
    max-width: 20ch;
  }

  /* Full-bleed photograph */
  .hero-photo-band {
    margin: 0;
  }

  .hero-photo-band img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    display: block;
  }

  .hero-photo-band figcaption {
    max-width: var(--wide);
    margin-inline: auto;
    padding: 0.85rem 1.5rem 0;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--graphite);
  }

  /* Motion: one sequence, fade up 12px with a 60ms stagger */
  @media (prefers-reduced-motion: no-preference) {
    .hero-inner > * {
      animation: heroIn 0.4s ease-out both;
    }
    .hero-inner > *:nth-child(1) { animation-delay: 0ms; }
    .hero-inner > *:nth-child(2) { animation-delay: 60ms; }
    .hero-inner > *:nth-child(3) { animation-delay: 120ms; }
    .hero-inner > *:nth-child(4) { animation-delay: 180ms; }
    .hero-inner > *:nth-child(5) { animation-delay: 240ms; }
  }

  @keyframes heroIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* 2. The two doors — full padding now that the photo band sits above */
  .doors-section {
    padding-top: clamp(2.75rem, 6vw, 4.5rem);
  }

  .doors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .door {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.9rem 2rem 1.7rem;
    border: 1px solid var(--rule);
    border-top-width: 4px;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .door:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px rgba(28, 27, 24, 0.1);
    color: var(--ink);
  }

  .door-name {
    font-family: var(--serif);
    font-size: 1.75rem;
  }

  .door-line {
    color: var(--graphite);
  }

  .door-number {
    font-weight: 700;
    font-size: 1.9rem;
    letter-spacing: -0.02em;
    margin-top: 0.2rem;
  }

  .door-number span {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--graphite);
    letter-spacing: 0;
  }

  .door-cta {
    margin-top: auto;
    padding-top: 0.6rem;
    font-weight: 650;
  }

  .door-cta .arrow {
    transition: transform 0.15s ease;
    display: inline-block;
  }

  .door:hover .door-cta .arrow {
    transform: translateX(4px);
  }

  .door-policy {
    background: var(--policy-wash);
    border-top-color: var(--policy);
  }
  .door-policy .door-number,
  .door-policy .door-cta {
    color: var(--policy);
  }

  .door-teaching {
    background: var(--teaching-wash);
    border-top-color: var(--teaching);
  }
  .door-teaching .door-number,
  .door-teaching .door-cta {
    color: var(--teaching-deep);
  }

  /* 3. Proof */
  .proof {
    border-block: 1px solid var(--rule);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    max-width: 50rem;
  }

  .proof-figure {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(2.8rem, 6.5vw, 4.2rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .proof-policy {
    color: var(--policy);
  }

  .proof-teaching {
    color: var(--teaching-deep);
  }

  .proof-label {
    color: var(--graphite);
    max-width: 26ch;
  }

  /* 5. Current work */
  .current-list {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
    border-top: 1px solid var(--rule);
  }

  .current-list li {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }

  .current-tag {
    font-size: 0.85rem;
    font-weight: 650;
  }

  .current-policy {
    color: var(--policy);
  }

  .current-teaching {
    color: var(--teaching-deep);
  }

  .current-body {
    color: var(--graphite);
  }

  /* 6. Latest */
  .latest-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    max-width: var(--measure);
  }

  .latest-list a {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s ease;
  }

  .latest-list a:hover {
    border-color: var(--graphite);
    color: var(--ink);
  }

  .latest-kind {
    font-size: 0.78rem;
    font-weight: 650;
  }

  .latest-policy {
    color: var(--policy);
  }

  .latest-teaching {
    color: var(--teaching-deep);
  }

  .latest-title {
    font-family: var(--serif);
    font-size: 1.1rem;
  }

  .latest-meta {
    color: var(--graphite);
    font-size: 0.88rem;
  }

  /* 7 & 8 */
  .partners p {
    color: var(--graphite);
  }

  .ctas {
    border-top: 1px solid var(--rule);
  }

  .cta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }

  .cta p {
    color: var(--graphite);
    margin-bottom: 1.1rem;
    max-width: 34ch;
  }

  @media (max-width: 52rem) {
    .stat-strip {
      grid-template-columns: repeat(2, 1fr);
    }

    .doors,
    .proof-grid,
    .cta-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .latest-list a {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .current-list li {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
