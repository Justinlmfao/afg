---
// Traditional Chinese home page. Shares the English page's stylesheet
// (src/styles/pages/home.css) via pageClass, so layout changes stay in one
// place; only the prose differs. Keep each Chinese paragraph on one source
// line: Astro turns a line break into a space, which shows in Chinese.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import NowStrip from '../../components/NowStrip.astro';
import FigureRow from '../../components/FigureRow.astro';
import Case from '../../components/Case.astro';
import Ledger from '../../components/Ledger.astro';
import Steps from '../../components/Steps.astro';
import Gallery from '../../components/Gallery.astro';
import MarginNote from '../../components/MarginNote.astro';
import '../../styles/pages/home.css';
import { getCollection } from 'astro:content';
import { facts, showSamples } from '../../data/facts';
import { aiForAllCase } from '../../data/cases';
import { formatDate } from '../../lib/dates';
import { getSubmissions, submissionHref } from '../../lib/submissions';
import { getLangFromUrl } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const f = facts;
const story = aiForAllCase(lang, { document: '/zh/policy#ai-for-all' });
// The proposals with a page of their own.
const proposals = (await getSubmissions(lang)).filter((s) => s.hasPaper);
const modules = (await getCollection('programs'))
  .filter((m) => !m.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
// Photographs for the proposal cards, in order. They show our own work in
// class, so they are decorative here (empty alt text).
const cardPhotos = ['teaching-chalkboard-maths.jpg', 'team-outside-school.jpg'];
---

<BaseLayout
  title="AI For Good 香港：學生主導的人工智能政策研究與免費補習"
  pageClass="page-home"
  description="AI For Good 是一個由香港學生創辦和營運的組織：我們向政府提交政策建議，也為基層家庭的小學生提供免費補習。"
>
  <!-- "Now": what we're working on this month, in a strip under the header -->
  <NowStrip />

  <!-- Hero: the classroom photo runs to the right edge of the screen and the
       words sit on a paper panel over its top-left corner. On phones the
       panel overlaps the bottom of the photo instead. The hand-drawn marks
       (.drawn-under, .drawn-circle) are the only pencil colour on the page. -->
  <div class="hero-stage">
    <figure class="hero-photo">
      <Photo
        name="teaching-classroom.jpg"
        alt="導師在天主教領島學校上課，一名學生舉手回答。"
        sizes="(min-width: 60rem) 75vw, 100vw"
        position="62% 45%"
        positionPhone="68% 40%"
        eager
      />
      <figcaption>天主教領島學校的一節補習課。</figcaption>
    </figure>
    <div class="hero-text">
      <h1>我們<span class="drawn-under">免費</span>教香港的孩子，<wbr />再把在課室看到的<wbr />告訴政府。</h1>
      <p class="lead">2024 年，我們在一些沒有人工智能課堂、也沒有資源開辦的學校教書。2025 年 8 月，我們把所見寫進施政報告意見書。{f.aiForAll.budget} 年度財政預算案撥款<span class="drawn-circle">{f.aiForAll.amount[lang]}</span>予 AI for All，正是我們提出的那類計劃。</p>
      <p class="hero-sub">我們有超過 35 名學生成員，研究人工智能和經濟政策如何改變這座城市，每年向政府提交約{f.recsPerYear.word[lang]}項建議，也為基層家庭的小學生免費教授人工智能和經濟知識。</p>
      <div class="actions">
        <a class="btn" href="/zh/policy">看看我們向政府說了什麼</a>
        <a class="textlink" href="/zh/teaching/sample-lesson">試上我們的一課</a>
      </div>
    </div>
    <p class="hand-note">我們的導師自己也還是中學生。</p>
  </div>

  <div class="wrap hero-figures">
    <FigureRow
    items={[
      { figure: f.recsPerYear.value, label: '每年提交的建議' },
      { figure: f.children.value, label: '教過的孩子' },
      { figure: f.schools.value, label: '合作學校' },
      { figure: f.tutors.value, label: '受訓學生導師' },
    ]}
    />
  </div>

  <div class="halves doors">
    <section class="half-col tone-policy" aria-labelledby="door-policy">
      <div class="half washed door">
        <h2 id="door-policy">政策研究</h2>
        <p>我們向香港政府提交書面建議，自 2024 年起每一輪施政報告和財政預算案諮詢都有參與。</p>
        <p class="door-number">{f.recsPerYear.value} <span>每年提交的建議</span></p>
        <a class="textlink" href="/zh/policy">我們提交過的所有意見書</a>
      </div>
      <div class="half band">
        <p class="proof-figure">HK$50M</p>
        <p class="proof-label">{f.aiForAll.budget} 年度財政預算案撥給 AI for All 的款項，正是我們一直倡議的那類普及人工智能計劃</p>
      </div>
    </section>
    <section class="half-col tone-teaching" aria-labelledby="door-teaching">
      <div class="half washed door">
        <h2 id="door-teaching">教學計劃</h2>
        <p>由我們親自培訓的學生導師，在七間學校為小學生提供免費補習。</p>
        <p class="door-number">{f.children.value} <span>教過的孩子</span></p>
        <a class="textlink" href="/zh/teaching">我們怎樣上課</a>
      </div>
      <div class="half band">
        <p class="proof-figure">{f.bandUp.value}{f.bandUp.unit}</p>
        <p class="proof-label">自 {f.bandUp.since} 年起，至少升了一個組別的學生比例</p>
      </div>
    </section>
  </div>

  <section class="sec tone-policy" aria-labelledby="ai-for-all">
    <div class="wrap">
      <Case id="ai-for-all" {...story}>
        <a slot="claim-more" href="/zh/policy#ai-for-all">{story.more}</a>
      </Case>
    </div>
  </section>

  <section class="sec" aria-labelledby="who-h">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="who-h">我們是誰</h2>
      </div>
      <div class="prose">
        <p class="tagline">為我們終將繼承的科技，制訂政策。</p>
        <p>
          這裡沒有大人主理。AI For Good 由學生在 2023 年 6 月創立，到今天仍然全由學生營運，現在已有超過 35 人。我們一開始是校外的獨立智庫，後來才陸續和全港各區的學校合作。我們同時做兩件事：為政府撰寫有證據支持的建議，也去教那些最先感受到這些決定影響的孩子。有些星期，我們在趕一份給政府的意見書；有些星期，我們站在白板前，面對一班小學生。
        </p>
        <p><a class="textlink" href="/zh/about">了解更多</a></p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="current-h">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="current-h">我們正在做的事</h2>
      </div>
      <ul class="current-list">
        <li class="tone-policy">
          <span class="tone-tag">政策</span>
          <span>就《香港特別行政區經濟和社會發展第一個五年規劃（2026–2030）》撰寫意見書。我們主張人工智能的資源應該投放到有需要的地方，而不只是沿用現有的計劃。</span>
        </li>
        <li class="tone-teaching">
          <span class="tone-tag">教學</span>
          <span>明年會帶著新一批導師重返天主教領島學校。</span>
        </li>
      </ul>
    </div>
  </section>

  <figure class="photo photo-break">
    <Photo
      name="vsa-2025-26-cohort.jpg"
      alt="2025/26 年度的學生與導師在課室內合照。"
      sizes="100vw"
      position="50% 45%"
    />
    <figcaption class="wrap">2025–26 年度的學生與導師，攝於我們與滬江維多利亞學校合辦的社區課程。</figcaption>
  </figure>

  <section class="sec tone-policy washed" aria-labelledby="policy-h">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="policy-h"><span class="nowrap">自 2024 年起，</span><wbr />我們回應了<wbr />每一份施政報告<wbr />及財政預算案諮詢。</h2>
        <p>每份建議書都先寫支持的理由、反對的理由，然後才是我們的建議。</p>
      </div>
      <div>
        <Ledger rows={proposals} variant="brief" heading="其他近期建議" caption="其他近期建議" />
        <a class="more" href="/zh/policy#submissions">所有意見書</a>
      </div>
    </div>
  </section>

  <section class="sec tone-teaching washed" aria-labelledby="teaching-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="teaching-h">孩子先自己嘗試，<wbr />再請人工智能<wbr />給提示，<wbr />從不直接要答案。</h2>
        <p>每一節課都跟從同樣的四個步驟，數學、英文、經濟和科學都一樣。</p>
      </div>
      <Steps
        items={[
          { name: '嘗試', text: '先自己試著解題。' },
          { name: '提問', text: '請人工智能給提示或核對。' },
          { name: '核對', text: '比較它的回應和自己的做法。' },
          { name: '解釋', text: '關掉人工智能，用自己的話解釋。' },
        ]}
      />
      <!-- A real line from one of our tutors (in full on the Teaching page) -->
      <figure class="home-quote">
        <blockquote><p>他們從來不缺好奇心，缺的是機會。</p></blockquote>
        <figcaption>我們的一位導師，在天主教領島學校上完課後. <a href="/zh/teaching#a-moment">完整的故事</a></figcaption>
      </figure>
      <Gallery
        photos={[
          {
            name: 'teaching-ai-study-partner.jpg',
            alt: '導師在小學課堂上，用投影在螢幕上的人工智能學習夥伴教學。',
            caption: '在天主教領島學校，把人工智能當作學習夥伴。',
          },
          {
            name: 'vsa-2025-26-helping.jpg',
            alt: '導師協助一名學生使用手提電腦。',
            caption: '與滬江維多利亞學校合辦的社區課堂，2025–26 年度。',
          },
          {
            name: 'vsa-2024-25-presenting.jpg',
            alt: '兩位導師向一班年輕人講解。',
            caption: '社區課堂，2024–25 年度。',
          },
        ]}
      />
      <div class="noted facts">
        <p class="facts-main">
          我們的 {f.tutors.value} 位受訓導師，在{f.schools.word[lang]}間學校教過 {f.children.value} 個孩子。自 {f.bandUp.since} 年起，{f.bandUp.value}{f.bandUp.unit} 的學生至少升了一個組別。
        </p>
        <MarginNote label="關於這個數字。">
          這不是我們一個人的功勞。老師、家長和學生自己都付出了努力。但這是我們用來要求自己的數字。{(!f.bandUp.method.sample || showSamples) && <a href="/zh/teaching#results">我們怎樣計算</a>}
        </MarginNote>
      </div>
      <a class="more" href="/zh/teaching">我們的教學、單元和示範課堂</a>
    </div>
  </section>

  <!-- Latest work, straight from the collections. The flagship leads. -->
  <section class="sec" aria-labelledby="latest-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="latest-h">最新工作</h2>
      </div>
      <div class="latest">
        <ul class="latest-cards">
          <li class="tone-policy">
            <a class="card" href="/zh/policy#ai-for-all">
              <Photo name="vsa-2025-26-uses.jpg" alt="" sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 45vw, 100vw" widths={[480, 800]} position="50% 35%" />
              <span class="tone-tag">主要項目</span>
              <span class="card-title">AI for All：{f.aiForAll.budget} 年度財政預算案撥款{f.aiForAll.amount[lang]}</span>
              <span class="latest-meta">2024–2026 年</span>
            </a>
          </li>
          {
            proposals.map((s, i) => (
              <li class="tone-policy">
                <a class="card" href={submissionHref(s, lang)}>
                  <Photo name={cardPhotos[i % cardPhotos.length]} alt="" sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 45vw, 100vw" widths={[480, 800]} />
                  <span class="tone-tag">提案</span>
                  <span class="card-title">{s.title}</span>
                  <span class="latest-meta">{formatDate(s.date, lang, 'long')}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="latest-modules">
          {
            modules.map((m) => (
              <li class="tone-teaching">
                <span class="tone-tag">單元</span>
                <a href="/zh/teaching#modules">{m.data.title_zh ?? m.data.title}</a>
                <span class="latest-meta">教學</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="partners-h">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="partners-h">合作夥伴</h2>
      </div>
      <p class="prose">
        天主教領島學校 · St. Barnabas' Home &amp; Society · Kennedy Town School · 10% Organisation
      </p>
    </div>
  </section>
</BaseLayout>
