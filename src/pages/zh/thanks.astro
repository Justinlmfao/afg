---
// Where the contact form lands once Netlify has accepted a message
// (the form's action attribute points here).
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTop from '../../components/PageTop.astro';
import '../../styles/pages/utility.css';
import { contactEmail } from '../../data/facts';
---

<BaseLayout
  title="訊息已送出"
  description="你給 AI For Good 的訊息已經送出。"
  pageClass="page-utility"
  noindex
>
  <PageTop vertical="聯絡">
    <h1>謝謝，<wbr />我們已收到<wbr />你的訊息。</h1>
    <p class="lead">
      我們會回覆到你提供的電郵地址，通常在一星期內。如需補充，可以直接電郵至{' '}<a href={`mailto:${contactEmail}`}>{contactEmail}</a>。
    </p>
    <ul class="next-links">
      <li><a class="textlink" href="/zh/">返回首頁</a></li>
      <li><a class="textlink" href="/zh/policy">我們的政策研究</a></li>
    </ul>
  </PageTop>
</BaseLayout>
