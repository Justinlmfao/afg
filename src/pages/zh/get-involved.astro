---
// Traditional Chinese Contact page. Shares src/styles/pages/contact.css with
// the English page. Keep each Chinese paragraph on one source line.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTop from '../../components/PageTop.astro';
import '../../styles/pages/contact.css';
import { contactEmail, contactForm } from '../../data/facts';
import { getLangFromUrl, ui } from '../../i18n';

const t = ui[getLangFromUrl(Astro.url)];
---

<BaseLayout
  title="聯絡我們"
  pageClass="page-contact"
  description="聯絡 AI For Good：歡迎想參與研究或教學的學生、學校和合作夥伴，以及任何查詢。"
>
  <PageTop vertical="聯絡">
    <h1>與我們聯絡。</h1>
    <p class="lead">
      歡迎電郵至{' '}<a href={`mailto:${contactEmail}`}>{contactEmail}</a>，或填寫下面的表格。我們在香港。我們通常會在一星期內回覆。
    </p>
  </PageTop>

  <!-- Who writes to us sits in the margin column beside the form -->
  <section class="sec">
    <div class="wrap rail">
      <ul class="routes">
        <li id="students">
          <h2>學生</h2>
          <p>想做真正的研究或教學？比起頭銜，我們更在乎你想做什麼。告訴我們你想參與哪方面的工作。</p>
        </li>
        <li id="schools">
          <h2>學校與夥伴</h2>
          <p>如果你的學校或機構服務基層家庭的孩子，我們很希望和你合作。課程、導師和器材都由我們負責。</p>
        </li>
        <li>
          <h2>其他查詢</h2>
          <p>傳媒查詢、合作建議，或者只是想問問題，都歡迎來信。</p>
        </li>
      </ul>

      <!--
        Messages go to Formspree (the address is contactForm in
        src/data/facts.ts), which emails them on. The hidden _gotcha field
        catches simple spam bots: people never see it, so anything typed in
        it marks the message as spam. Both languages use the same form.
      -->
      <form
        method="POST"
        action={contactForm}
        data-thanks="/zh/thanks/"
        class="contact-form"
      >
        <input type="hidden" name="_subject" value="來自 AI For Good 網站的訊息" />
        <p class="hidden-field" aria-hidden="true">
          <label>
            如果您是真人，請勿填寫此欄： <input name="_gotcha" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <div class="field">
          <label for="name">姓名</label>
          <input id="name" type="text" name="name" autocomplete="name" required />
        </div>

        <div class="field">
          <label for="email">電郵地址</label>
          <input id="email" type="email" name="email" autocomplete="email" required />
        </div>

        <div class="field">
          <label for="organization">機構 <span class="optional">（選填）</span></label>
          <input id="organization" type="text" name="organization" autocomplete="organization" />
        </div>

        <div class="field">
          <label for="message">訊息</label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>

        <button type="submit" class="btn" data-sending={t.sending}>發送訊息</button>
        <p class="form-error" role="alert" hidden>{t.formError}</p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  // Sends the form without leaving the page, then shows our own thank-you
  // page. While it sends, the button says so and can't be pressed twice. The
  // browser's own checks run first, so this only runs on a valid form.
  // Without this script the form still sends, and Formspree shows its own
  // confirmation page instead.
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const error = form?.querySelector<HTMLElement>('.form-error');
  const idleText = button?.textContent;

  const reset = () => {
    if (!button) return;
    button.disabled = false;
    button.removeAttribute('aria-busy');
    button.textContent = idleText || '';
  };

  form?.addEventListener('submit', async (event) => {
    if (!button) return;
    event.preventDefault();
    button.disabled = true;
    button.setAttribute('aria-busy', 'true');
    button.textContent = button.dataset.sending || '';
    if (error) error.hidden = true;
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(String(response.status));
      window.location.href = form.dataset.thanks || '/thanks/';
    } catch {
      reset();
      if (error) error.hidden = false;
    }
  });

  // Coming back with the browser's Back button restores a usable form
  window.addEventListener('pageshow', reset);
</script>
