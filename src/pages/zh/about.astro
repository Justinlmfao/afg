---
// Traditional Chinese About page. Shares src/styles/pages/about.css with the
// English page. Roles and bios come from role_zh and bio_zh in
// src/content/team/*.md (bio_zh is one string per paragraph); anything
// untranslated falls back to English. Keep each Chinese paragraph on one
// source line.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTop from '../../components/PageTop.astro';
import SummaryList from '../../components/SummaryList.astro';
import Gallery from '../../components/Gallery.astro';
import '../../styles/pages/about.css';
import { getCollection, render } from 'astro:content';
import { facts } from '../../data/facts';
import { getLangFromUrl } from '../../i18n';

// The page's language, from its address: this file is also the source of the
// Simplified page, where the same lookups return the Simplified wording.
const lang = getLangFromUrl(Astro.url);
const f = facts;

const people = await Promise.all(
  (await getCollection('team'))
    .filter((m) => !m.data.draft)
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (m) => ({
      name: m.data.name,
      first: m.data.name.split(' ')[0],
      role: m.data.role_zh ?? m.data.role,
      paras: m.data.bio_zh,
      Bio: m.body?.trim() ? (await render(m)).Content : null,
    }))
);
---

<BaseLayout
  title="關於我們"
  pageClass="page-about"
  description="AI For Good 是一個由香港學生營運的組織，於 2023 年 6 月成立。我們為政府撰寫政策建議，也為基層家庭的孩子提供免費補習。"
>
  <PageTop vertical="關於我們">
    <h1>政策和教學，<wbr />出於同一個原因。</h1>
    <p class="lead">
      AI For Good 是一個由香港學生營運的組織，於 {f.founded[lang]}成立。我們為政府撰寫人工智能和經濟政策的建議，也為基層家庭的小學生提供免費補習。
    </p>
  </PageTop>

  <section class="sec" aria-labelledby="at-a-glance">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="at-a-glance">概覽。</h2>
      </div>
      <SummaryList
        rows={[
          { key: '成立', value: `${f.founded[lang]}，由 ${f.founders[0]}、${f.founders[1]} 和 ${f.founders[2]} 創辦` },
          { key: '成員', value: `${f.members.value} 位學生` },
          {
            key: '政策',
            value: `每年約 ${f.recsPerYear.value.replace('~', '')} 項建議；自 ${f.recsPerYear.since} 年起，回應每一份施政報告及財政預算案諮詢`,
          },
          {
            key: '教學',
            value: `${f.children.value} 個孩子、${f.schools.value} 間學校、${f.tutors.value} 位受訓導師、${f.modules.length} 個單元`,
          },
          {
            key: '成果',
            value: `${f.aiForAll.budget} 年度財政預算案<a href="/zh/policy#ai-for-all">撥款${f.aiForAll.amount[lang]}推行 AI for All</a>`,
          },
          {
            key: '合作夥伴',
            value: "天主教領島學校、Kennedy Town School、St. Barnabas' Home &amp; Society 及 10% Organisation",
          },
        ]}
      />
    </div>
  </section>

  <section class="sec" aria-labelledby="why-both">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="why-both">寫政策的人，<wbr />應該見過<wbr />受政策影響的人。</h2>
      </div>
      <div class="prose">
        <p class="lead">
          如果寫人工智能政策的人從未見過受影響的人，這樣的政策不會是好政策。我們教的孩子，正是受影響的人。
        </p>
        <p>
          我們兩樣都做，並不是巧合。坐在何文田的課室裡，看著一個孩子第一次用人工智能導師，你會明白很多諮詢文件不會告訴你的事：哪些孩子家裡早就有補習老師，哪些有電腦，而哪些孩子正因為一項人人都說能「拉平差距」的科技，被拋得更遠。
        </p>
        <p>
          我們大部分的意見書都是從這裡開始的。教學讓我們看到差距在哪裡，研究幫我們判斷這是不是政策問題，最後由意見書請政府去解決。反過來也一樣：我們在研究教育和勞工政策時學到的東西，也會改變我們覺得值得教給十歲孩子的內容。比起只讀過資料的人，我們寧願做真正去過現場的人。
        </p>
      </div>
    </div>
  </section>

  <!-- Justin's own account, in the first person and left in his words. -->
  <section class="sec" aria-labelledby="why-i-started">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="why-i-started">我為什麼創辦它。</h2>
      </div>
      <div class="prose">
        <h3>為什麼做政策研究</h3>
        <p>
          人工智能來到香港的速度，比這座城市決定它應該為誰服務還要快。我先在自己的學校看到它，然後是朋友的實習，再然後是政府的規劃，每次的情況都一樣：本來機會最多的人，最先得到它。沒有人刻意這樣選擇，只是因為從來沒有人被問過。我花了兩年時間去了解公帑怎樣分配、一個決定的代價最後由誰承擔。眼看這些決定就在幾公里外發生，自己卻什麼都不做，實在說不過去。所以我們開始寫信給作決定的人。
        </p>
        <h3>為什麼做教學</h3>
        <p>
          一開始，只是我們幾個同學在學校裡互相教人工智能，大多是邊玩邊學。我們做過很多失敗的東西，也做出了幾樣成功的。很明顯，只要有人教你第一步，這些工具能幫到你很多。接著我們也看得很清楚，是誰沒有人教。最能從人工智能得益的孩子，往往最沒有機會接觸它，而這個差距不會自己消失。於是我們把原本在課室裡玩得很開心的事，帶到一些沒有人提供這些的學校。
        </p>
        <p class="signed">創辦人兼總監 Justin Lo</p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="people">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="people">全由學生營運。</h2>
        <p>我們的成員分別參與政策研究和補習工作。以下是帶領團隊的成員。</p>
      </div>
      <div>
        <ul class="people">
          {
            people.map(({ name, first, role, paras, Bio }) => (
              <li class="person">
                <h3>{name}</h3>
                <p class="person-role">{role}</p>
                {(paras || Bio) && (
                  <details>
                    <summary>關於 {first}</summary>
                    <div class="prose" lang={paras ? undefined : 'en'}>
                      {paras ? paras.map((p) => <p>{p}</p>) : Bio && <Bio />}
                    </div>
                  </details>
                )}
              </li>
            ))
          }
        </ul>
        <div class="people-photos">
          <Gallery
            photos={[
              {
                name: 'team-classroom.jpg',
                alt: '六位 AI For Good 成員在天主教領島學校的課室內，攝於一節課之後。',
                caption: '在天主教領島學校的課室內，攝於一節課之後。',
              },
              {
                name: 'team-outside-school.jpg',
                alt: '五位 AI For Good 成員在天主教領島學校門外。',
                caption: '學校門外。',
              },
            ]}
          />
        </div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="how-it-started">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="how-it-started">我們怎樣開始。</h2>
      </div>
      <div class="prose">
        <p>
          AI For Good 由 <strong>Justin Lo</strong>、<strong>Ka Hei Ng</strong> 和 <strong>Oscar Zheng</strong> 創立，<strong>David Dong</strong> 和 <strong>Jackie Xue</strong> 其後加入。我們一開始是校外的獨立智庫，不是學校的學會。後來成員漸漸增加，也開始和全港各區的學校合作，補習計劃就是這樣接觸到今天這些孩子。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
