---
// Traditional Chinese Teaching page. Shares src/styles/pages/teaching.css
// with the English page. Module copy comes from the *_zh fields in
// src/content/programs/. Keep each Chinese paragraph on one source line.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTop from '../../components/PageTop.astro';
import OnThisPage from '../../components/OnThisPage.astro';
import Case from '../../components/Case.astro';
import Steps from '../../components/Steps.astro';
import Annotated from '../../components/Annotated.astro';
import Gallery from '../../components/Gallery.astro';
import MarginNote from '../../components/MarginNote.astro';
import '../../styles/pages/teaching.css';
import { getCollection } from 'astro:content';
import { facts, showSamples } from '../../data/facts';
import { getLangFromUrl, ui } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const f = facts;

const modules = (await getCollection('programs'))
  .filter((m) => !m.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .map((m) => m.data);
---

<BaseLayout
  title="教學計劃"
  pageClass="page-teaching"
  description="為香港基層家庭的小學生提供免費補習。43 位受訓學生導師在 7 間學校教過 350 個孩子；自 2024 年起，86% 的學生至少升了一個組別。"
>
  <PageTop vertical="教學">
    <h1>免費補習：孩子先自己嘗試，再問人工智能。</h1>
    <p class="lead">
      我們的學生導師在全港各區為基層家庭的小學生上課。每個科目都配上人工智能，讓孩子多了一個免費、有耐性、課後也能繼續用的學習夥伴。
    </p>
    <OnThisPage
      items={[
        { href: '#how-it-started', label: '怎樣開始' },
        { href: '#think-first', label: 'Think First 先想後問' },
        { href: '#promises', label: '我們的承諾' },
        { href: '#modules', label: '四個單元' },
        { href: '#sample-lesson', label: '示範課堂' },
        { href: '#where-we-teach', label: '在哪裡教' },
      ]}
    />
  </PageTop>

  <section class="sec" aria-labelledby="how-it-started">
    <div class="wrap">
      <Case
        id="how-it-started"
        title="我們為什麼教，又帶來了什麼改變。"
        noticed={{
          date: '2023',
          text: '在香港，課後的額外輔導通常要花錢。付得起補習費的家庭會請補習，付不起的，只能看著孩子落後。一位有耐性的人工智能導師可以改變這一點，但前提是有人教孩子怎樣好好使用它。',
        }}
        did={{
          date: '2024/2026',
          text: `我們培訓了 ${f.tutors.value} 位中學生導師，在${f.schools.word.zh}間學校教過 ${f.children.value} 個孩子，共四個單元（數學、英文、經濟和科學），每一節課都以 Think First 先想後問為基礎。`,
        }}
        changed={{
          dateLabel: `自 ${f.bandUp.since} 年起`,
          status: 'changed',
          figure: `${f.bandUp.value}${f.bandUp.unit}`,
          text: '的學生至少升了一個組別。',
        }}
      >
        <Fragment slot="changed-note">
          <MarginNote label="關於這個數字。" id="results">這不是我們一個人的功勞。老師、家長和學生自己都付出了努力。但這是我們用來要求自己的數字。</MarginNote>
          {
            showSamples && f.bandUp.method.sample && (
              <MarginNote label="我們怎樣計算。">
                <span class="sample-tag" data-sample>{ui[lang].sample}</span>
                {f.bandUp.method.zh}
              </MarginNote>
            )
          }
          {!f.bandUp.method.sample && <MarginNote label="我們怎樣計算。">{f.bandUp.method.zh}</MarginNote>}
        </Fragment>
      </Case>

      <figure class="quote">
        <blockquote>
          <p>
            我們去天主教領島學校之前，以為要花很多力氣，才能說服一班孩子人工智能和時事跟他們有關。我們錯了。他們不是沒有興趣，只是從來沒有人給過他們機會。不到一小時，他們已經在爭論一個演算法算不算公平。他們從來不缺好奇心，缺的是機會。
          </p>
        </blockquote>
        <figcaption>我們的一位導師，在天主教領島學校上完一節課之後</figcaption>
      </figure>
    </div>
  </section>

  <section class="sec" aria-labelledby="think-first">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="think-first">每一節課，都跟從同樣的四個步驟。</h2>
        <p>
          工具有多大用處，要看孩子懂不懂得好好使用。一個直接問人工智能要答案的孩子，什麼也學不到；一個先自己嘗試、再問提示、最後用自己的話解釋答案的孩子，學到的會比自己一個人學更多。教會孩子分辨這兩種用法，就是我們的導師在做的事。我們把它叫做 Think First 先想後問。
        </p>
      </div>
      <Steps
        items={[
          { name: '嘗試', text: '孩子先自己試著解題。' },
          { name: '提問', text: '他們只問人工智能要提示或核對，永遠不直接問答案。' },
          { name: '核對', text: '他們比較人工智能的回應和自己的做法，找出不同之處。' },
          { name: '解釋', text: '關掉人工智能後，用自己的話解釋答案。' },
        ]}
      />

      <p class="sheet-intro">
        這是我們其中一節課的工作紙：孩子比較自己常玩的遊戲裡的兩個角色，再論證哪一個比較好。
      </p>
      <Annotated
        notes={[
          '數字由孩子從自己的遊戲畫面讀出來，所以數據是他們自己的。',
          '意想不到的結果：通常是較快的角色勝出。單看一個數字，說明不了太多。',
          '誠實地替另一方寫一句。這和我們寫每一份建議書時用的規矩一樣。',
        ]}
      />

      <p class="closing-line">
        孩子能在沒有人工智能的情況下解釋，就代表學會了；做不到的話，我們就退回上一步。
      </p>
    </div>
  </section>

  <section class="sec" aria-labelledby="promises">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="promises">學校和家長可以放心的事。</h2>
      </div>
      <ul class="promise-list">
        <li>導師上課時，一定有學校或中心的職員在場。</li>
        <li>我們不收集兒童的個人資料。</li>
        <li>我們只使用合作學校批准的人工智能工具。</li>
        <li>教學永遠免費。</li>
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="modules">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="modules">四個學科，每一科都以人工智能作為學習夥伴。</h2>
        <p>
          我們不把人工智能當作獨立的科目來教。我們的導師都是中學生，完成 AFG 的培訓後才開始教學，並以小組形式上課，讓每個孩子都得到照顧。
        </p>
      </div>
      <ul class="module-list">
        {
          modules.map((m) => (
            <li class="module">
              <h3>{m.title_zh ?? m.title}</h3>
              <p>{m.summary_zh ?? m.summary}</p>
              {m.why_zh && (
                <p class="module-why">
                  <b>有什麼幫助：</b>{m.why_zh}
                </p>
              )}
              {m.body_zh && (
                <details>
                  <summary>這個單元的詳情</summary>
                  <div class="prose">
                    <p>{m.body_zh}</p>
                  </div>
                </details>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="sample-lesson">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="sample-lesson">一節課，由頭到尾。</h2>
      </div>
      <div class="prose">
        <p>
          <strong>數字大，不代表比較強：</strong>一節 60 分鐘的課，對象是小五至小六學生，用上數學和英文，每 8–10 位學生配 2 位導師。我們把它公開，讓學校在邀請我們之前，先看看一節課是怎樣設計的。
        </p>
        <p><a class="textlink" href="/zh/teaching/sample-lesson">完整教案</a></p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="where-we-teach">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="where-we-teach">我們在哪裡教。</h2>
      </div>
      <div>
        <p class="prose">
          我們上課的小學包括何文田的<strong>天主教領島學校</strong>和 <strong>Kennedy Town School</strong>，也和社區夥伴 <strong>St. Barnabas' Home &amp; Society</strong> 及 <strong>10% Organisation</strong> 合作。
        </p>
        <div class="place-gallery">
          <Gallery
            photos={[
              {
                name: 'teaching-ai-tools.jpg',
                alt: '兩位導師介紹人工智能助手可以做什麼：搜尋資料、拆解難題，以及協助寫作。',
                caption: '在天主教領島學校，介紹人工智能助手可以做什麼。',
              },
              {
                name: 'teaching-english-careers.jpg',
                alt: '兩位導師教英文單元，投影片說明英文怎樣在醫療、貿易、科技和旅遊業打開就業之門。',
                caption: '英文單元。',
              },
              {
                name: 'teaching-exploring-interests.jpg',
                alt: '一位導師示範怎樣用人工智能探索自己的興趣，由恐龍、太空到音樂。',
                caption: '用人工智能探索自己的興趣。',
              },
            ]}
          />
        </div>

        <h3 class="place-h">與滬江維多利亞學校合作</h3>
        <p class="prose">
          除了在小學上課，我們也和滬江維多利亞學校合辦課程，對象是社區裡的年輕人。
        </p>
        <dl class="years">
          <div>
            <dt>2024–25</dt>
            <dd>教學生在自己的社區裡運用人工智能：這些工具擅長做什麼，以及怎樣用它們做些真正有用的事。</dd>
          </div>
          <div>
            <dt>2025–26</dt>
            <dd>教社區裡的孩子，人工智能可以令哪些事情變得更好，以及怎樣分辨和避開它被濫用的情況。</dd>
          </div>
        </dl>
        <div class="place-gallery">
          <Gallery
            photos={[
              {
                name: 'vsa-2025-26-poster.jpg',
                alt: '學生製作海報，列出一個問題、一個人工智能方案，以及怎樣落實。',
                caption: '學生構思怎樣用人工智能處理社區裡的一個問題，2025–26 年度。',
              },
              {
                name: 'vsa-2024-25-group.jpg',
                alt: '2024–25 年度課程結束時，導師和學生在一張感謝大家參加的投影片前合照。',
                caption: '2024–25 年度課程的最後一節。',
              },
              {
                name: 'vsa-2025-26-cohort.jpg',
                alt: '2025–26 年度的學生和導師在課室裡合照。',
                caption: '學生和導師，2025–26 年度。',
              },
            ]}
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
