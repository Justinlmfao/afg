---
// Traditional Chinese Teaching page. Shares src/styles/pages/teaching.css
// with the English page. Module copy comes from the *_zh fields in
// src/content/programs/. Keep each Chinese paragraph on one source line.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTop from '../../components/PageTop.astro';
import OnThisPage from '../../components/OnThisPage.astro';
import Case from '../../components/Case.astro';
import Steps from '../../components/Steps.astro';
import Annotated from '../../components/Annotated.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import MarginNote from '../../components/MarginNote.astro';
import Lesson from './_lesson.astro';
import '../../styles/pages/teaching.css';
import { getCollection } from 'astro:content';
import { facts, showSamples } from '../../data/facts';
import { getLangFromUrl, ui } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const f = facts;

const modules = (await getCollection('programs'))
  .filter((m) => !m.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .map((m) => m.data);

// Photos from sessions at Ho Man Tin Ling To Catholic School. The first is
// shown large.
const photos = [
  { name: 'teaching-classroom.jpg', alt: '導師在天主教領島學校授課，一名學生舉手回答。', position: '60% 40%' },
  { name: 'teaching-chalkboard-maths.jpg', alt: '導師在黑板上示範 1117 × 1117 的心算捷徑。' },
  { name: 'teaching-ai-study-partner.jpg', alt: '導師手持手提電腦，示範如何向人工智能大聲講解一個數學概念，藉此檢查自己是否真的明白。' },
  { name: 'teaching-ai-tools.jpg', alt: '兩位導師介紹人工智能助理可以做什麼：查找資料、拆解難題，以及協助寫作。' },
  { name: 'teaching-exploring-interests.jpg', alt: '導師示範如何用人工智能探索自己的興趣，由恐龍、太空到音樂。' },
  { name: 'teaching-english-careers.jpg', alt: '兩位導師教授英文單元，投影片說明英文如何在醫療、貿易、科技與旅遊業打開職業大門。' },
];

// Sessions run at Victoria Shanghai Academy, grouped by year: six each.
const cohorts = [
  {
    years: '2024–25',
    summary: '教學生在自己的社區裡運用人工智能：這些工具擅長做什麼，以及怎樣用它們做些真正有用的事。',
    photos: [
      { name: 'vsa-2024-25-group.jpg', alt: '2024/25 年度課程結束時，導師與學生在感謝參加者的投影片前合照。' },
      { name: 'vsa-2024-25-presenting.jpg', alt: '兩位導師在 2024/25 年度的一節課上向使用手提電腦的學生講解。' },
      { name: 'vsa-2024-25-activity.jpg', alt: '導師在螢幕上展示範例，說明人工智能影像工具如何把一張圖片轉換成另一張。' },
      { name: 'vsa-2024-25-helping-pair.jpg', alt: '導師俯身協助兩名一起使用手提電腦的學生。' },
      { name: 'vsa-2024-25-helping.jpg', alt: '導師協助一名使用手提電腦的年幼學生。', position: '50% 35%' },
      { name: 'vsa-2024-25-side-by-side.jpg', alt: '導師與學生並肩在手提電腦前完成練習。', position: '50% 35%' },
    ],
  },
  {
    years: '2025–26',
    summary: '教社區裡的孩子，人工智能可以令哪些事情變得更好，以及怎樣分辨和避開它被濫用的情況。',
    photos: [
      { name: 'vsa-2025-26-group.jpg', alt: '年度結束時，導師在寫著「Thanks for joining — A.I. For Good 25–26」的白板前合照。' },
      { name: 'vsa-2025-26-cohort.jpg', alt: '2025/26 年度的學生與導師在課室內合照。' },
      { name: 'vsa-2025-26-uses.jpg', alt: '導師展示人工智能的用途例子，包括紓緩交通、預測天災，以及為基層學生提供輔導。', position: '50% 35%' },
      { name: 'vsa-2025-26-poster.jpg', alt: '學生製作海報，列出問題、人工智能的解決方案，以及實行方式。' },
      { name: 'vsa-2025-26-discussion.jpg', alt: '導師與學生在手提電腦前討論作業。' },
      { name: 'vsa-2025-26-helping.jpg', alt: '導師在課堂上協助一名使用手提電腦的學生。' },
    ],
  },
];
---

<BaseLayout
  title="教學計劃"
  pageClass="page-teaching tone-teaching"
  description="為香港基層家庭的小學生提供免費補習。43 位受訓學生導師在 7 間學校教過 350 個孩子；自 2024 年起，86% 的學生至少升了一個組別。"
>
  <PageTop vertical="教學" band>
    <h1>免費補習：<wbr />孩子先自己嘗試，<wbr />再問人工智能。</h1>
    <p class="lead">
      我們的學生導師在全港各區為基層家庭的小學生上課。每個科目都配上人工智能，讓孩子多了一個免費、有耐性、課後也能繼續用的學習夥伴。
    </p>
    <OnThisPage
      items={[
        { href: '#why-we-teach', label: '為什麼教' },
        { href: '#think-first', label: 'Think First 先想後問' },
        { href: '#modules', label: '四個單元' },
        { href: '#sample-lesson', label: '示範課堂' },
        { href: '#where-we-teach', label: '在哪裡教' },
        { href: '#in-the-classroom', label: '課室裡' },
      ]}
    />
  </PageTop>

  <section class="sec" aria-labelledby="the-programme">
    <div class="wrap">
      <Case
        id="the-programme"
        title="我們為什麼教，又帶來了什麼改變。"
        noticed={{
          date: '2023',
          text: '在香港，課後的額外輔導通常要花錢。付得起補習費的家庭會請補習，付不起的，只能看著孩子落後。一位有耐性的人工智能導師可以改變這一點，但前提是有人教孩子怎樣好好使用它。',
        }}
        did={{
          date: '2024/2026',
          text: `我們培訓了 ${f.tutors.value} 位中學生導師，在${f.schools.word[lang]}間學校教四個單元（數學、英文、經濟和科學），每一節課都以 Think First 先想後問為基礎。`,
        }}
        changed={{
          dateLabel: `自 ${f.bandUp.since} 年起`,
          status: 'changed',
          figure: `${f.bandUp.value}${f.bandUp.unit}`,
          text: `的學生自 ${f.bandUp.since} 年起，至少升了一個組別。`,
        }}
      >
        <Fragment slot="changed-note">
          <p class="quiet-facts">教過 {f.children.value} 個孩子 · {f.schools.value} 間學校 · {f.tutors.value} 位受訓導師</p>
          <MarginNote id="results">這 {f.bandUp.value}{f.bandUp.unit} 不是我們一個人的功勞。老師、家長和學生自己都付出了努力。但這是我們用來要求自己的數字。</MarginNote>
          {
            showSamples && f.bandUp.method.sample && (
              <MarginNote label="我們怎樣計算。">
                <span class="sample-tag" data-sample>{ui[lang].sample}</span>
                {f.bandUp.method[lang]}
              </MarginNote>
            )
          }
          {!f.bandUp.method.sample && <MarginNote label="我們怎樣計算。">{f.bandUp.method[lang]}</MarginNote>}
        </Fragment>
      </Case>
    </div>
  </section>

  <section class="sec" aria-labelledby="why-we-teach">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="why-we-teach">我們為什麼教</h2>
      </div>
      <div class="prose">
        <p class="tagline">每個請不起補習的孩子，都值得一位免費導師。</p>
        <p>
          在香港，課後的額外輔導通常要花錢。付得起補習費的家庭會請補習，付不起的，只能看著孩子落後。人工智能改變了這一點：第一次，一位能用五種方法解釋同一條題目、又有耐性的導師，可以免費得到。
        </p>
        <p>
          但工具有多大用處，要看孩子懂不懂得好好使用。一個直接問人工智能要答案的孩子，什麼也學不到；一個先自己嘗試、再問提示、最後用自己的話解釋答案的孩子，學到的會比自己一個人學更多。教會孩子分辨這兩種用法，就是我們的導師在做的事。
        </p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="a-moment">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="a-moment">課堂上的一刻</h2>
      </div>
      <figure class="quote">
        <blockquote>
          <p>
            我們去天主教領島學校之前，以為要花很多力氣，才能說服一班孩子人工智能和時事跟他們有關。我們錯了。他們不是沒有興趣，只是從來沒有人給過他們機會。不到一小時，他們已經在爭論一個演算法算不算公平。他們從來不缺好奇心，缺的是機會。
          </p>
        </blockquote>
        <figcaption>我們的一位導師，在天主教領島學校上完一節課之後</figcaption>
      </figure>
    </div>
  </section>

  <section class="sec washed" aria-labelledby="think-first">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker-date">我們怎樣教：Think First 先想後問</p>
        <h2 id="think-first">每一節課，<wbr />都跟從同樣的<wbr />四個步驟。</h2>
        <p>每一節用到人工智能的課，都跟從同樣的四個步驟。</p>
      </div>
      <Steps
        items={[
          { name: '嘗試', text: '孩子先自己試著解題。' },
          { name: '提問', text: '他們只問人工智能要提示或核對，永遠不直接問答案。' },
          { name: '核對', text: '他們比較人工智能的回應和自己的做法，找出不同之處。' },
          { name: '解釋', text: '關掉人工智能後，用自己的話解釋答案。' },
        ]}
      />

      <p class="sheet-intro">
        這是我們其中一節課的工作紙：孩子比較自己常玩的遊戲裡的兩個角色，再論證哪一個比較好。
      </p>
      <Annotated
        notes={[
          '數字由孩子從自己的遊戲畫面讀出來，所以數據是他們自己的。',
          '意想不到的結果：通常是較快的角色勝出。單看一個數字，說明不了太多。',
          '誠實地替另一方寫一句。這和我們寫每一份提案時用的規矩一樣。',
        ]}
      />

      <div class="prose">
        <p class="closing-line">
          孩子能在沒有人工智能的情況下解釋，就代表學會了；做不到的話，我們就退回上一步。
        </p>
        <p>
          我們不把人工智能當作獨立的科目來教。我們教數學、英文、經濟和科學，再讓孩子看到人工智能可以怎樣幫助他們學好每一科。我們的導師都是中學生，完成 AFG 的培訓後才開始教學，並以小組形式上課，讓每個孩子都得到照顧。
        </p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="modules">
    <div class="wrap rail">
      <div class="rail-head">
        <p class="kicker-date">我們的四個單元</p>
        <h2 id="modules">四個學科，<wbr />每一科都以<wbr />人工智能<wbr />作為學習夥伴。</h2>
        <p>每個單元都把一個學科和人工智能配合起來，目的是縮窄我們的學生和家境較好的同齡人之間的差距，而不是令它擴大。</p>
      </div>
      <ul class="module-list">
        {
          modules.map((m) => (
            <li class="module">
              <h3>{m.title_zh ?? m.title}</h3>
              <div class="prose">
                <p>{m.body_zh}</p>
              </div>
              {m.why_zh && (
                <p class="module-why">
                  <b>有什麼幫助：</b>{m.why_zh}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec washed" aria-labelledby="sample-lesson">
    <div class="wrap">
      <div class="rail lesson-top">
        <div class="rail-head">
          <p class="kicker-date">示範課堂</p>
          <h2 id="sample-lesson">數字大，<wbr />不代表比較強</h2>
        </div>
        <div>
          <p class="prose">
            這節課用上了上面的<strong>數學</strong>和<strong>英文</strong>單元。我們把它公開，讓學校在邀請我們之前，先看看一節課是怎樣設計的。
          </p>
          <ul class="lesson-facts">
            <li><span>程度</span>小五至小六</li>
            <li><span>時長</span>60 分鐘</li>
            <li><span>人手</span>每 8–10 位學生配 2 位導師</li>
          </ul>
          <p><a class="more" href="/zh/teaching/sample-lesson">獨立一頁的教案，附可列印的工作紙</a></p>
        </div>
      </div>
      <Lesson />
    </div>
  </section>

  <section class="sec" aria-labelledby="where-we-teach">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="where-we-teach">我們在哪裡教</h2>
      </div>
      <p class="prose">
        我們在七間學校上課，包括何文田的<strong>天主教領島學校</strong>和 <strong>Kennedy Town School</strong>，也和社區夥伴 <strong>St. Barnabas' Home &amp; Society</strong> 及 <strong>10% Organisation</strong> 合作。
      </p>
    </div>
  </section>

  <section class="sec" aria-labelledby="promises">
    <div class="wrap rail">
      <div class="rail-head">
        <p class="kicker-date">我們對學校和家長的承諾</p>
        <h2 id="promises">學校和家長<wbr />可以放心的事。</h2>
      </div>
      <ul class="promise-list">
        <li>導師上課時，一定有學校或中心的職員在場。</li>
        <li>我們不收集兒童的個人資料。</li>
        <li>我們只使用合作學校批准的人工智能工具。</li>
        <li>教學永遠免費。</li>
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="in-the-classroom">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="in-the-classroom">課室裡</h2>
        <p>我們的導師在天主教領島學校上課。</p>
      </div>
      <PhotoGrid photos={photos} feature />
    </div>
  </section>

  <section class="sec" aria-labelledby="with-vsa">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="with-vsa">與滬江維多利亞學校<wbr />合作</h2>
        <p>除了在小學上課，我們也和滬江維多利亞學校合辦課程，對象是社區裡的年輕人。</p>
      </div>
      <div>
        {
          cohorts.map((cohort) => (
            <div class="cohort">
              <h3>{cohort.years}</h3>
              <p class="prose">{cohort.summary}</p>
              <PhotoGrid photos={cohort.photos} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sec washed" aria-label="參與我們">
    <div class="wrap">
      <div class="halves-plain cta-pair">
        <div>
          <h2>邀請我們到你的學校</h2>
          <p>如果你負責一間小學、社區中心或兒童計劃，希望為學生提供免費補習，歡迎聯絡我們。</p>
          <a class="btn" href="/zh/get-involved#schools">聯絡我們</a>
        </div>
        <div>
          <h2>成為導師</h2>
          <p>如果你是想教學的中學生，我們會先為你提供培訓。</p>
          <a class="btn" href="/zh/get-involved#students">報名</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
