---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/pages/policy.css';
import { getCollection, render } from 'astro:content';
import { getLangFromUrl } from '../../i18n';

// Proposals in this page's language: the .zh.md files here, and the generated
// .hans.md files on the Simplified page (the language comes from the URL).
const lang = getLangFromUrl(Astro.url);
const proposals = await Promise.all(
  (await getCollection('submissions'))
    .filter((s) => !s.data.draft && s.data.lang === lang)
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (s) => ({ ...s.data, Body: (await render(s)).Content }))
);
---

<BaseLayout
  title="政策研究"
  pageClass="page-policy"
  description="AI For Good 的政策研究：每年向香港政府提交約二十項書面建議，涵蓋施政報告、財政預算案和第一個五年規劃。"
>
  <section class="page-top">
    <div class="container prose">
      <p class="kicker">政策研究</p>
      <h1>寫給作決定的人</h1>
      <p class="lead">
        我們的政策團隊研究在香港看到的問題，再向政府提交建議。這裡列出的都是真正提交過的工作，而且還會陸續有更多。
      </p>
    </div>
  </section>

  <section class="record">
    <div class="container">
      <h2 class="section-title">到目前為止</h2>
      <dl class="ledger">
        <div class="ledger-row">
          <dt class="ledger-figure">~20</dt>
          <dd class="ledger-label">每年向政府提交的建議</dd>
        </div>
        <div class="ledger-row weighted">
          <dt class="ledger-figure">HK$50M</dt>
          <dd class="ledger-label">
            2026–27 年度財政預算案撥給 <strong>AI for All</strong> 的款項，正是我們一直倡議的那類普及人工智能計劃。<a class="link-quiet" href="#ai-for-all">我們提交了什麼，又可以怎樣說 →</a>
          </dd>
        </div>
        <div class="ledger-row">
          <dt class="ledger-figure">2024–</dt>
          <dd class="ledger-label">
            自 2024 年起，每一輪施政報告和財政預算案諮詢都有提交意見
          </dd>
        </div>
        <div class="ledger-row">
          <dt class="ledger-figure">2026–2030</dt>
          <dd class="ledger-label">
            正在為《經濟和社會發展第一個五年規劃》撰寫意見書
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section id="ai-for-all" class="flagship">
    <div class="container">
      <div class="prose">
        <p class="kicker">我們的主要項目</p>
        <h2>AI for All</h2>
        <p class="flagship-lede">
          2026 年 2 月，香港財政預算案撥出五千萬港元，推行一個普及人工智能計劃。計劃預計在兩年內，透過超過 200 個課程、講座和比賽，接觸約 50,000 名市民，由數碼港、香港科技園公司和香港生產力促進局負責推行，其中數碼港的部分以學生、家長、長者和基層社群為對象。
        </p>
      </div>

      <p class="attribution">
        <strong>我們可以這樣說：</strong>我們提出了這項建議，而預算案朝這個方向走。AI for All 是政府的計劃，由公營機構出資和推行。我們沒有出資，也沒有參與營運，更不能說是我們促成的。
      </p>

      <ol class="timeline">
        <li>
          <span class="t-phase">我們看到的問題<span class="t-date">2024</span></span><span class="t-body">
            我們在一些沒有人工智能課堂、也沒有資源開辦的學校教書，每間課室都看到同一件事：孩子學得很快，缺的是接觸的機會。最容易被人工智能拋離的家庭，偏偏也是經學校和僱主推行的計劃最難接觸到的一群。
          </span>
        </li>
        <li>
          <span class="t-phase">我們做了什麼<span class="t-date">2025 年 8 月</span></span><span class="t-body">
            我們把看到的寫成一份論證：先訪問負責教學的成員，再研究現有的公共支援幫到誰、漏了誰，然後寫成一份包括支持理由、反對理由和建議的意見書。我們在 2025 年 8 月把它提交到施政報告諮詢，之後在財政預算案的意見中再次提出同一論點。
          </span>
        </li>
        <li>
          <span class="t-phase">之後的發展<span class="t-date">2026 年 2–6 月</span></span><span class="t-body">
            2026–27 年度財政預算案撥出五千萬港元推行 AI for All，計劃在 2026 年 6 月正式啟動。我們一直提出的論點，在計劃的設計中得到呼應：數碼港的部分以學生、家長、長者和基層社群為對象，正是我們指出一般人工智能技能推廣最遲才會照顧到的人。資料來源列在下面，你可以自己查證。
          </span>
        </li>
      </ol>

      <article class="proposal" aria-label="AI for All：我們的意見書和我們對結果的看法">
        <div class="proposal-part">
          <p class="part-label">我們為什麼提出</p>
          <p class="part-body">
            我們在沒有人工智能課堂、也沒有相關預算的學校教小學生。孩子很有興趣，也學得很快，他們缺的是機會。所以我們每年的意見書都提出同一點：如果人工智能培訓只經學校和僱主推行，最後只會惠及本來已有機會的家庭，漏掉真正需要的人。公帑應該先照顧排在隊尾的人。
          </p>
        </div>
        <div class="proposal-part">
          <p class="part-label">我們提交了什麼</p>
          <p class="part-body">
            2025 年 8 月，我們在施政報告諮詢中提出這個論點，之後在財政預算案的意見中再次提出。我們建議政府直接資助最難接觸到人工智能的人，例如資源不足學校的孩子、他們的家長和長者，而不是經那些最遲才會照顧到他們的機構轉介。我們要求的是專門撥給這群人的款項，而不是一個籠統的人工智能技能承諾。
          </p>
        </div>
        <div class="proposal-part part-recommendation">
          <p class="part-label">這代表什麼，又不代表什麼</p>
          <p class="part-body">
            這是一個開始，不是終點。政府形容五千萬港元只是初步撥款，50,000 名參加者的目標也只是按現有資源訂下的基準；官員表示如果有需求，可能會再增加撥款。五萬人只佔香港人口的一小部分。我們在下一輪的立場是：需求確實存在，撥款應該跟上，我們也打算在五年規劃的意見書中這樣說。
          </p>
        </div>
      </article>

      <div class="flagship-more">
        <h3>為什麼這很重要</h3>
        <p>
          能夠接觸人工智能，只解決了一半問題。2019 年，全港有 94% 的家庭可以上網，但月入少於一萬港元的家庭只有 71%。而即使有電腦，如果沒有人教孩子好好使用人工智能，他們也可能只是依賴它，而不是從中學習。這第二道差距，正是我們<a href="#think-first">《Think First 先想後問》建議</a>要處理的問題。
        </p>
        <h3>我們接下來會留意的事</h3>
        <ul class="watch-list">
          <li>
            <strong>接觸到誰。</strong>名額是否真的去到低收入家庭的學生、家長和長者，以及政府會否公布參加者的背景。
          </li>
          <li>
            <strong>怎樣教。</strong>給孩子的課程，是否教他們用人工智能來思考，而不只是教他們怎樣用。
          </li>
          <li>
            <strong>會否擴大。</strong>五千萬港元和五萬人是一個開始。我們會繼續主張撥款應該跟隨需求增加。
          </li>
        </ul>
      </div>

      <aside class="sources" aria-label="AI for All 資料來源">
        <p class="sources-label">資料來源</p>
        <ul>
          <li>
            <a href="https://www.info.gov.hk/gia/general/202606/10/P2026061000476.htm" rel="noopener">
              政府新聞公報，2026 年 6 月 10 日
            </a><span>info.gov.hk</span>
          </li>
          <li>
            <a href="https://www.thestandard.com.hk/news/article/334092/HK-launches-50m-AI-for-All-campaign-to-benefit-50000-residents" rel="noopener">
              「HK launches $50m AI for All campaign to benefit 50,000 residents」
            </a><span>The Standard</span>
          </li>
          <li>
            <a href="https://www.scmp.com/news/hong-kong/hong-kong-economy/article/3365474/hong-kong-launch-free-ai-courses-tech-giants-google-microsoft-smes" rel="noopener">
              「Hong Kong to launch free AI courses with tech giants Google, Microsoft for SMEs」
            </a><span>South China Morning Post</span>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="method">
    <div class="container">
      <h2 class="section-title">我們怎樣寫一份提案</h2>
      <ol class="steps-detail">
        <li>
          <span class="step-num">1</span>
          <div>
            <h3>和受影響的人傾談</h3>
            <p>
              每一份提案都從受政策影響的人開始。我們的議題來自成員親眼見到的事，而不是新聞；我們會訪問老師、家長、打工仔和前線人員，也會問我們自己的導師：發生了什麼、影響了誰、是只發生過一次還是每星期都有。如果只有一個人留意到某個問題，我們會先找更多證據，才把它寫成提案。
            </p>
          </div>
        </li>
        <li>
          <span class="step-num">2</span>
          <div>
            <h3>做研究</h3>
            <p>
              接著我們會檢查這是否真的是政策問題。政府在這方面已經資助了什麼？這些資助幫到誰、漏了誰？其他地方試過什麼方法、成本多少？如果現有政策已經處理了這個問題，我們會直說，然後放棄這份提案。這一步的目的是篩走提案，而不是替提案找理由。
            </p>
          </div>
        </li>
        <li>
          <span class="step-num">3</span>
          <div>
            <h3>撰寫和提交</h3>
            <p>
              由一位成員按下面的三段格式撰寫提案，反對的理由會寫得盡量有力。如果反對的理由勝出，提案就不會提交。通過的提案會交到當時開放的諮詢，例如施政報告、財政預算案或個別政策局的意見徵集，而建議會寫得清楚具體，讓對方可以據此行動。
            </p>
          </div>
        </li>
      </ol>

      <p class="method-note prose">
        每一份提案都用同一個三段格式：
      </p>

      <article class="proposal proposal-demo" aria-label="每份提案共用的格式">
        <header class="proposal-head">
          <h3 class="proposal-title">每份提案都用的格式</h3>
          <p class="proposal-meta">AI For Good 意見書的結構</p>
        </header>
        <div class="proposal-part">
          <p class="part-label">支持的理由</p>
          <p class="part-body">
            最有力的支持論點：這項政策能做到什麼、幫到誰，以及背後的證據。
          </p>
        </div>
        <div class="proposal-part">
          <p class="part-label">反對的理由</p>
          <p class="part-body">
            誠實地寫出反對的論點：成本、風險，以及由誰承擔。如果這一方勝出，我們就不提交。
          </p>
        </div>
        <div class="proposal-part part-recommendation">
          <p class="part-label">建議</p>
          <p class="part-body">
            在兩方面都說清楚之後，用簡單直接的話寫出我們希望政府做什麼，包括需要多少錢，以及怎樣知道它是否有效。
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="filings">
    <div class="container">
      <h2 class="section-title">我們的兩份提案</h2>
      <p class="filings-note prose">
        以下是我們提交給政府的兩個例子，較新的排在前面。每一份都先寫支持和反對的理由，再提出建議，並列明成本和衡量成效的方法。
      </p>
      {
        proposals.length === 0 ? (
          <p class="empty-note">提案提交後，會在這裡公開。</p>
        ) : (
          proposals.map(({ key, title, date, area, summary, pdf, Body }) => (
            <article class="filed" id={key}>
              <p class="filed-meta">
                <time>{date}</time> · {area}
              </p>
              <h3 class="filed-title">{title}</h3>
              <p class="filed-summary">{summary}</p>
              <details class="filed-more">
                <summary>閱讀完整提案</summary>
                <div class="filed-body">
                  <Body />
                  {pdf && (
                    <p>
                      <a class="link-quiet" href={pdf}>下載 PDF →</a>
                    </p>
                  )}
                </div>
              </details>
            </article>
          ))
        )
      }
    </div>
  </section>
</BaseLayout>
