---
// Traditional Chinese Policy page. Shares src/styles/pages/policy.css with
// the English page. Keep each Chinese paragraph on one source line.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTop from '../../components/PageTop.astro';
import OnThisPage from '../../components/OnThisPage.astro';
import Case from '../../components/Case.astro';
import CaseBrief from '../../components/CaseBrief.astro';
import Ledger from '../../components/Ledger.astro';
import Steps from '../../components/Steps.astro';
import ThreePart from '../../components/ThreePart.astro';
import MarginNote from '../../components/MarginNote.astro';
import '../../styles/pages/policy.css';
import { facts } from '../../data/facts';
import { aiForAllCase } from '../../data/cases';
import { getSubmissions } from '../../lib/submissions';
import { getLangFromUrl } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const f = facts;
// The same case as the home page, told at full length here.
const short = aiForAllCase(lang, { document: '#submissions' });
const story = {
  ...short,
  period: `我們的主要項目 · ${short.period}`,
  noticed: {
    ...short.noticed,
    text: '我們在一些沒有人工智能課堂、也沒有資源開辦的學校教書，每間課室都看到同一件事：孩子學得很快，缺的是接觸的機會。最容易被人工智能拋離的家庭，偏偏也是經學校和僱主推行的計劃最難接觸到的一群。',
  },
  did: {
    ...short.did,
    text: '我們把看到的寫成一份論證：先訪問負責教學的成員，再研究現有的公共支援幫到誰、漏了誰，然後寫成一份包括支持理由、反對理由和建議的意見書。我們在 2025 年 8 月把它提交到施政報告諮詢，之後在財政預算案的意見中再次提出同一論點。',
  },
  changed: {
    ...short.changed,
    text: '2026–27 年度財政預算案撥出五千萬港元推行 AI for All，計劃在 2026 年 6 月正式啟動。我們一直提出的論點，在計劃的設計中得到呼應：數碼港的部分以<mark>學生、家長、長者和基層社群</mark>為對象，正是我們指出一般人工智能技能推廣最遲才會照顧到的人。資料來源列在下面，你可以自己查證。',
  },
};
// Submissions in this page's language: the .zh.md files here, and the
// generated .hans.md files on the Simplified page.
const submissions = await getSubmissions(lang);
const proposals = submissions.filter((s) => s.hasPaper);
---

<BaseLayout
  title="政策研究"
  pageClass="page-policy tone-policy"
  description="AI For Good 的政策研究：每年向香港政府提交約二十項書面建議，涵蓋施政報告、財政預算案和第一個五年規劃。"
>
  <PageTop vertical="政策" band>
    <h1>寫給作決定的人。</h1>
    <p class="lead">
      我們的政策團隊研究在香港看到的問題，再向政府提交建議。這裡列出的都是真正提交過的工作，而且還會陸續有更多。
    </p>
    <OnThisPage
      items={[
        { href: '#so-far', label: '到目前為止' },
        { href: '#ai-for-all', label: 'AI for All' },
        { href: '#submissions', label: '所有意見書' },
        { href: '#how-we-write', label: '怎樣寫提案' },
        { href: '#proposals', label: '我們的提案' },
      ]}
    />
  </PageTop>

  <section class="sec" aria-labelledby="so-far">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="so-far">到目前為止</h2>
      </div>
      <dl class="record">
        <div>
          <dt>{f.recsPerYear.value}</dt>
          <dd>每年向政府提交的建議</dd>
        </div>
        <div>
          <dt>HK$50M</dt>
          <dd>
            {f.aiForAll.budget} 年度財政預算案撥給 <strong>AI for All</strong> 的款項，正是我們一直倡議的那類普及人工智能計劃。<a href="#ai-for-all">我們提交了什麼，又可以怎樣說</a>
          </dd>
        </div>
        <div>
          <dt>2024–</dt>
          <dd>自 2024 年起，每一輪施政報告和財政預算案諮詢都有提交意見</dd>
        </div>
        <div>
          <dt>2026–2030</dt>
          <dd>正在為《經濟和社會發展第一個五年規劃》撰寫意見書</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="sec" aria-labelledby="ai-for-all">
    <div class="wrap">
      <Case id="ai-for-all" {...story}>
        <p slot="intro">
          2026 年 2 月，香港財政預算案撥出五千萬港元，推行一個普及人工智能計劃。計劃預計在兩年內，透過超過 200 個課程、講座和比賽，接觸約 {f.aiForAll.reach.toLocaleString('en')} 名市民，由數碼港、香港科技園公司和香港生產力促進局負責推行，其中數碼港的部分以學生、家長、長者和基層社群為對象。
        </p>
      </Case>

      <dl class="threepart flagship-parts">
        <div>
          <dt>我們為什麼提出</dt>
          <dd>我們在沒有人工智能課堂、也沒有相關預算的學校教小學生。孩子很有興趣，也學得很快，他們缺的是機會。所以我們每年的意見書都提出同一點：如果人工智能培訓只經學校和僱主推行，最後只會惠及本來已有機會的家庭，漏掉真正需要的人。公帑應該先照顧排在隊尾的人。</dd>
        </div>
        <div>
          <dt>我們提交了什麼</dt>
          <dd>2025 年 8 月，我們在施政報告諮詢中提出這個論點，之後在財政預算案的意見中再次提出。我們建議政府直接資助最難接觸到人工智能的人，例如資源不足學校的孩子、他們的家長和長者，而不是經那些最遲才會照顧到他們的機構轉介。我們要求的是專門撥給這群人的款項，而不是一個籠統的人工智能技能承諾。</dd>
        </div>
        <div>
          <dt>這代表什麼，又不代表什麼</dt>
          <dd>這是一個開始，不是終點。政府形容五千萬港元只是初步撥款，50,000 名參加者的目標也只是按現有資源訂下的基準；官員表示如果有需求，可能會再增加撥款。五萬人只佔香港人口的一小部分。我們在下一輪的立場是：需求確實存在，撥款應該跟上，我們也打算在五年規劃的意見書中這樣說。</dd>
        </div>
      </dl>

      <div class="after-case">
        <div class="prose">
          <h3>為什麼這很重要</h3>
          <p>
            能夠接觸人工智能，只解決了一半問題。2019 年，全港有 94% 的家庭可以上網，但月入少於一萬港元的家庭只有 71%。而即使有電腦，如果沒有人教孩子好好使用人工智能，他們也可能只是依賴它，而不是從中學習。這第二道差距，正是我們<a href="/zh/policy/think-first">《Think First 先想後問》建議</a>要處理的問題。
          </p>
          <h3>我們接下來會留意的事</h3>
          <ul>
            <li>
              <strong>接觸到誰。</strong>名額是否真的去到低收入家庭的學生、家長和長者，以及政府會否公布參加者的背景。
            </li>
            <li>
              <strong>怎樣教。</strong>給孩子的課程，是否教他們用人工智能來思考，而不只是教他們怎樣用。
            </li>
            <li>
              <strong>會否擴大。</strong>五千萬港元和五萬人是一個開始。我們會繼續主張撥款應該跟隨需求增加。
            </li>
          </ul>
        </div>

        <aside class="sources" aria-labelledby="sources-h">
          <p class="sources-label" id="sources-h">資料來源</p>
          <ul>
            <li>
              <a href={f.aiForAll.source} rel="noopener">政府新聞公報，2026 年 6 月 10 日</a>
              <span>info.gov.hk</span>
            </li>
            <li>
              <a href="https://www.thestandard.com.hk/news/article/334092/HK-launches-50m-AI-for-All-campaign-to-benefit-50000-residents" rel="noopener" lang="en">"HK launches $50m AI for All campaign to benefit 50,000 residents"</a>
              <span>The Standard</span>
            </li>
            <li>
              <a href="https://www.scmp.com/news/hong-kong/hong-kong-economy/article/3365474/hong-kong-launch-free-ai-courses-tech-giants-google-microsoft-smes" rel="noopener" lang="en">"Hong Kong to launch free AI courses with tech giants Google, Microsoft for SMEs"</a>
              <span>South China Morning Post</span>
            </li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="sec washed" aria-labelledby="submissions">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="submissions">我們向政府提交過的<wbr />所有意見書。</h2>
        <p>每份意見書包含多項建議：每年合共約{f.recsPerYear.word[lang]}項。</p>
      </div>
      <Ledger rows={submissions} caption="我們向香港政府提交的意見書，由新到舊" />
    </div>
  </section>

  <section class="sec" aria-labelledby="how-we-write">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker-date">我們怎樣寫一份提案</p>
        <h2 id="how-we-write">每份建議書<wbr />都先反駁自己。</h2>
      </div>
      <Steps
        long
        items={[
          {
            name: '和受影響的人傾談',
            text: '每一份提案都從受政策影響的人開始。我們的議題來自成員親眼見到的事，而不是新聞；我們會訪問老師、家長、打工仔和前線人員，也會問我們自己的導師：發生了什麼、影響了誰、是只發生過一次還是每星期都有。如果只有一個人留意到某個問題，我們會先找更多證據，才把它寫成提案。',
          },
          {
            name: '做研究',
            text: '接著我們會檢查這是否真的是政策問題。政府在這方面已經資助了什麼？這些資助幫到誰、漏了誰？其他地方試過什麼方法、成本多少？如果現有政策已經處理了這個問題，我們會直說，然後放棄這份提案。這一步的目的是篩走提案，而不是替提案找理由。',
          },
          {
            name: '撰寫和提交',
            text: '由一位成員按下面的三段格式撰寫提案，反對的理由會寫得盡量有力。如果反對的理由勝出，提案就不會提交。通過的提案會交到當時開放的諮詢，例如施政報告、財政預算案或個別政策局的意見徵集，而建議會寫得清楚具體，讓對方可以據此行動。',
          },
        ]}
      />

      <p class="format-intro">每一份提案都用同一個三段格式：</p>
      <div class="noted">
        <div>
          <h3 class="format-title">每份提案都用的格式</h3>
          <p class="small format-sub">AI For Good 意見書的結構</p>
          <ThreePart
            caseFor="最有力的支持論點：這項政策能做到什麼、幫到誰，以及背後的證據。"
            caseAgainst="誠實地寫出反對的論點：成本、風險，以及由誰承擔。如果這一方勝出，我們就不提交。"
            recommendation="在兩方面都說清楚之後，用簡單直接的話寫出我們希望政府做什麼，包括需要多少錢，以及怎樣知道它是否有效。"
          />
        </div>
        <MarginNote label="我們的規矩。">如果反對的理由更有說服力，這份提案就不會提交。</MarginNote>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="proposals">
    <div class="wrap rail">
      <div class="rail-head">
        <h2 id="proposals">我們的兩份提案</h2>
        <p>以下是我們提交給政府的兩個例子，較新的排在前面。每一份都先寫支持和反對的理由，再提出建議，並列明成本和衡量成效的方法。</p>
      </div>
      <div>
        {proposals.map((s) => <CaseBrief submission={s} />)}
      </div>
    </div>
  </section>
</BaseLayout>
