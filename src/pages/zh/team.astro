---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/pages/team.css';
import { getCollection } from 'astro:content';

// Same team collection as the English page; only the role line is translated
// (role_zh in src/content/team/*.md), and it falls back to English if absent.
const members = (await getCollection('team'))
  .filter((m) => !m.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="團隊"
  pageClass="page-team"
  description="AI For Good 全數由學生營運——超過 35 名成員，分佈於研究、夥伴關係與技術團隊。"
>
  <section class="page-top">
    <div class="container prose">
      <p class="kicker">團隊</p>
      <h1>全數由學生營運</h1>
      <p class="lead">
        超過 35 名成員分別參與政策研究與補習計劃。以下是帶領這些工作的人：
      </p>
    </div>
  </section>

  <!-- Team photographs -->
  <section class="section-tight">
    <div class="container team-photos">
      <figure>
        <img
          src="/programs/team-classroom.jpg"
          alt="六位 AI For Good 成員在天主教領島學校的課室內，攝於一節課之後。"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure>
        <img
          src="/programs/team-outside-school.jpg"
          alt="五位 AI For Good 成員在天主教領島學校門外。"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <ul class="team-list">
        {
          members.map((person) => (
            <li class="member">
              <p class="member-name">{person.data.name}</p>
              <p class="member-role">{person.data.role_zh ?? person.data.role}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
