---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/pages/team.css';
import { getCollection, render } from 'astro:content';

// Same team collection and order as the English page. Role and bio come from
// role_zh and bio_zh in src/content/team/*.md (bio_zh is one string per
// paragraph). Anything untranslated falls back to English rather than
// disappearing; anyone without a bio is listed without the toggle.
const members = await Promise.all(
  (await getCollection('team'))
    .filter((m) => !m.data.draft)
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (m) => ({
      name: m.data.name,
      role: m.data.role_zh ?? m.data.role,
      paras: m.data.bio_zh,
      Bio: m.body?.trim() ? (await render(m)).Content : null,
    }))
);
---

<BaseLayout
  title="團隊"
  pageClass="page-team"
  description="AI For Good 全由學生營運，超過 35 位成員參與政策研究和補習工作。"
>
  <section class="page-top">
    <div class="container prose">
      <p class="kicker">團隊</p>
      <h1>全數由學生營運</h1>
      <p class="lead">
        我們有超過 35 位成員，分別參與政策研究和補習工作。以下是帶領團隊的成員，按一下名字就可以看看他們的介紹。
      </p>
    </div>
  </section>

  <!-- The leads. Each name opens its bio: native <details>, so it works
       without JavaScript and from the keyboard. -->
  <section class="section-tight">
    <div class="container">
      <div class="people">
        {
          members.map(({ name, role, paras, Bio }) =>
            paras || Bio ? (
              <details class="person">
                <summary>
                  <span class="person-head">
                    <h2 class="person-name">{name}</h2>
                    <span class="person-role">{role}</span>
                  </span>
                  <span class="person-toggle" aria-hidden="true" />
                </summary>
                <div class="person-bio" lang={paras ? undefined : 'en'}>
                  {paras ? paras.map((p) => <p>{p}</p>) : Bio && <Bio />}
                </div>
              </details>
            ) : (
              <div class="person person-static">
                <span class="person-head">
                  <h2 class="person-name">{name}</h2>
                  <span class="person-role">{role}</span>
                </span>
              </div>
            )
          )
        }
      </div>
    </div>
  </section>

  <!-- Team photographs -->
  <section class="section-tight">
    <div class="container team-photos">
      <figure>
        <img
          src="/programs/team-classroom.jpg"
          alt="六位 AI For Good 成員在天主教領島學校的課室內，攝於一節課之後。"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure>
        <img
          src="/programs/team-outside-school.jpg"
          alt="五位 AI For Good 成員在天主教領島學校門外。"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>
</BaseLayout>
