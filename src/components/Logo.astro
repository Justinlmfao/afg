---
// The AFG mark: three rules descending in length — the shape of every
// proposal we file. The case for, the case against, and the recommendation,
// which is the shortest line and the one in the accent colour.
//
// `boxed` wraps it in a rounded square for the favicon and any context that
// needs a solid shape at very small sizes; the header and footer use the bare
// rules, which sit better beside the wordmark.
interface Props {
  size?: number;
  boxed?: boolean;
}
const { size = 22, boxed = false } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  class="afg-mark"
>
  {boxed && <rect width="24" height="24" rx="5" fill="var(--paper, #faf7f2)" />}
  <rect x={boxed ? 4 : 3} y="6" width={boxed ? 16 : 18} height="2.6" rx="1.3" fill="var(--ink, #1c1b18)" />
  <rect x={boxed ? 4 : 3} y="10.7" width={boxed ? 11.5 : 13} height="2.6" rx="1.3" fill="var(--policy, #2f5d93)" />
  <rect x={boxed ? 4 : 3} y="15.4" width={boxed ? 7 : 8} height="2.6" rx="1.3" fill="var(--teaching, #c2461e)" />
</svg>

<style>
  .afg-mark {
    display: block;
    flex-shrink: 0;
  }

  /* The accent rule nudges out on hover — the recommendation being made */
  :global(a:hover) > .afg-mark rect:last-child {
    transition: transform 0.2s ease;
    transform: translateX(2px);
  }
</style>
