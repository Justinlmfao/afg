---
// Site header: the wordmark, the four sections and the three languages.
// On phones the sections fold into a sheet behind a Menu button, and one
// language link stays in view: Chinese from the English pages, English from
// either Chinese version.
import Logo from './Logo.astro';
import {
  getLangFromUrl,
  localizePath,
  ui,
  navItems,
  langOrder,
  langShort,
  htmlLangs,
  hreflangs,
} from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = ui[lang];

// Current path with any language prefix removed, so it matches navItems paths.
const path = localizePath(Astro.url.pathname, 'en');
// The 404 page exists only once, so its language links go to each home page.
const switchPath = /^\/404(\.html)?\/?$/.test(Astro.url.pathname) ? '/' : Astro.url.pathname;
const quick = lang === 'en' ? ({ code: 'zh', label: '中文' } as const) : ({ code: 'en', label: 'EN' } as const);

const links = navItems.map((item) => ({
  href: localizePath(item.path, lang),
  label: t.nav[item.key],
  // "Here" covers pages inside a section too, e.g. /policy/think-first.
  here: path === item.path || path.startsWith(item.path + '/'),
  current: path === item.path,
}));
const languages = langOrder.map((code) => ({
  code,
  href: localizePath(switchPath, code),
  label: langShort[code],
  current: code === lang,
}));
---

<header class="site-head">
  <div class="wrap site-head-in">
    <a class="wordmark" href={localizePath('/', lang)} aria-label={t.home}>
      <Logo />
    </a>

    <nav class="nav" aria-label={t.navPrimary}>
      {
        links.map((link) => (
          <a href={link.href} class:list={[link.here && 'is-here']} aria-current={link.current ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      <span class="lang" role="group" aria-label={t.langLabel}>
        {
          languages.map((l, i) => (
            <>
              {i > 0 && <span class="lang-dot" aria-hidden="true">·</span>}
              <a
                href={l.href}
                lang={htmlLangs[l.code]}
                hreflang={hreflangs[l.code]}
                aria-current={l.current ? 'true' : undefined}
              >
                {l.label}
              </a>
            </>
          ))
        }
      </span>
      <button class="theme-btn" type="button" aria-pressed="false" aria-label={t.darkMode}>
        <span aria-hidden="true"></span>
      </button>
    </nav>

    <div class="head-phone">
      <a class="lang-quick" href={localizePath(switchPath, quick.code)} lang={htmlLangs[quick.code]}>
        {quick.label}
      </a>
      <button class="theme-btn" type="button" aria-pressed="false" aria-label={t.darkMode}>
        <span aria-hidden="true"></span>
      </button>
      <button
        class="menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="menu"
        aria-label={t.menu}
        data-open={t.menu}
        data-close={t.close}
      >
        <span class="menu-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="menu" id="menu" hidden>
    <div class="wrap">
      <nav aria-label={t.navPrimary}>
        <ul>
          {
            links.map((link) => (
              <li>
                <a
                  class:list={['menu-link', link.here && 'is-here']}
                  href={link.href}
                  aria-current={link.current ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="menu-lang">
        {
          languages.map((l) => (
            <a href={l.href} lang={htmlLangs[l.code]} aria-current={l.current ? 'true' : undefined}>
              {l.label}
            </a>
          ))
        }
      </p>
    </div>
  </div>
</header>

<script>
  // Light and dark mode. The page starts in the device's setting; pressing
  // the button switches and remembers the choice (the early script in
  // BaseLayout applies it before the page is drawn).
  const root = document.documentElement;
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => root.dataset.theme === 'dark' || (!root.dataset.theme && systemDark.matches);
  const themeButtons = document.querySelectorAll<HTMLButtonElement>('.theme-btn');
  const showTheme = () => themeButtons.forEach((b) => b.setAttribute('aria-pressed', String(isDark())));
  showTheme();
  systemDark.addEventListener('change', showTheme);
  themeButtons.forEach((b) =>
    b.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage can be blocked; the choice then lasts for this page only.
      }
      showTheme();
    })
  );

  // Opening and closing the phone menu.
  const button = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('menu');

  const setOpen = (open: boolean) => {
    if (!button || !menu) return;
    menu.hidden = !open;
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', (open ? button.dataset.close : button.dataset.open) ?? '');
  };

  button?.addEventListener('click', () => setOpen(menu?.hidden ?? false));

  // Escape closes the menu and puts focus back on its button
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.hidden) {
      setOpen(false);
      button?.focus();
    }
  });

  // So does tapping anywhere outside the header
  document.addEventListener('click', (event) => {
    if (menu && !menu.hidden && !(event.target as Element).closest('.site-head')) setOpen(false);
  });

  // And widening the window past the point where the full nav appears
  window.matchMedia('(min-width: 52.01rem)').addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });
</script>
