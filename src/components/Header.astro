---
// Site header. The brand mark (see Logo.astro) is three rules descending in
// length — the shape of every proposal we file. Mobile menu is progressively
// enhanced. Nav links and the language switcher follow the current locale.
import Logo from './Logo.astro';
import {
  getLangFromUrl,
  localizePath,
  ui,
  navItems,
  langOrder,
  langShort,
  htmlLangs,
  switchLabels,
} from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = ui[lang];

// Current path with any language prefix removed, so it matches navItems paths.
const path = localizePath(Astro.url.pathname, 'en');
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a href={localizePath('/', lang)} class="brand" aria-label={t.home}>
      <Logo size={22} />
      AI For Good
    </a>

    <button
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Menu"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={localizePath(item.path, lang)}
                aria-current={path === item.path ? 'page' : undefined}
              >
                {t.nav[item.key]}
              </a>
            </li>
          ))
        }
        <li class="lang-item">
          {/*
            Three languages don't fit as full names, so the switcher is a short
            group with the current language marked rather than linked. Each
            link keeps you on the page you were reading.
          */}
          <span class="lang-group" role="group" aria-label={t.langLabel}>
            {
              langOrder.map((code, i) => (
                <>
                  {i > 0 && <span class="lang-sep" aria-hidden="true">·</span>}
                  {code === lang ? (
                    <span class="lang-current" aria-current="true" lang={htmlLangs[code]}>
                      {langShort[code]}
                    </span>
                  ) : (
                    <a
                      class="lang-switch"
                      href={localizePath(Astro.url.pathname, code)}
                      lang={htmlLangs[code]}
                      aria-label={switchLabels[lang][code]}
                    >
                      {langShort[code]}
                    </a>
                  )}
                </>
              ))
            }
          </span>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    background: rgba(250, 247, 242, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
    z-index: 90;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .primary-nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.7rem;
    padding: 0;
    margin: 0;
  }

  .primary-nav a {
    color: var(--graphite);
    text-decoration: none;
    font-size: 0.97rem;
    font-weight: 600;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }

  .primary-nav a:hover {
    color: var(--ink);
  }

  .primary-nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--policy);
  }

  /* The Teaching link underlines in its own ink when current */
  .primary-nav a[href$='/teaching'][aria-current='page'] {
    border-bottom-color: var(--teaching);
  }

  /* Language switch sits apart from the nav proper */
  .lang-item {
    padding-left: 1.7rem;
    border-left: 1px solid var(--rule);
  }

  .lang-group {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .lang-switch {
    font-size: 0.9rem !important;
    font-weight: 500 !important;
    color: var(--policy) !important;
  }

  .lang-switch:hover {
    color: var(--policy-deep) !important;
  }

  /* The language you are already reading: shown, not offered */
  .lang-current {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
  }

  .lang-sep {
    font-size: 0.9rem;
    color: var(--graphite);
    opacity: 0.45;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 2.5rem;
    height: 2.5rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .nav-toggle-bar {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--ink);
    border-radius: 2px;
  }

  @media (max-width: 52rem) {
    .nav-toggle {
      display: flex;
    }

    .primary-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--paper);
      border-bottom: 1px solid var(--rule);
    }

    .primary-nav.is-open {
      display: block;
    }

    .primary-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem 1.5rem 1rem;
    }

    .primary-nav li {
      border-top: 1px solid var(--rule);
    }

    .primary-nav a {
      display: block;
      padding: 0.85rem 0;
      border-bottom: none;
    }

    .primary-nav a[aria-current='page'] {
      color: var(--policy);
    }

    .lang-item {
      padding-left: 0;
      border-left: none;
      padding-block: 0.85rem;
    }

    /* Keep the three languages on one row inside the stacked mobile menu */
    .lang-item .lang-switch {
      display: inline;
      padding: 0;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('primary-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(open)));
  });
</script>
