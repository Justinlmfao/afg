---
// Site footer, on the dark ground with the full logo. It is also every
// page's closing call to action: one line for schools and organisations, one
// for students. No page carries a separate closing section.
import Logo from './Logo.astro';
import { contactEmail } from '../data/facts';
import { monthOf } from '../lib/dates';
import { getLangFromUrl, localizePath, ui, navItems, langOrder, langShort, htmlLangs } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = ui[lang];
const f = t.footer;
const contact = localizePath('/get-involved', lang);
const switchPath = /^\/404(\.html)?\/?$/.test(Astro.url.pathname) ? '/' : Astro.url.pathname;
// The month the site was last built, which is when its content last changed.
const updated = monthOf(new Date(), lang);
---

<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <Logo variant="lockup" label="AI For Good Hong Kong" />
        <p class="foot-blurb">{f.blurb}</p>
      </div>
      <div>
        <h2>{f.schoolsTitle}</h2>
        <p>{f.schoolsText}</p>
        <a class="btn-light" href={`${contact}#schools`}>{f.schoolsAction}</a>
      </div>
      <div>
        <h2>{f.studentsTitle}</h2>
        <p>{f.studentsText}</p>
        <a class="btn-light" href={`${contact}#students`}>{f.studentsAction}</a>
      </div>
    </div>

    <div class="foot-base">
      <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
      <nav aria-label={t.navFooter}>
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={localizePath(item.path, lang)}>{t.nav[item.key]}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ul aria-label={t.langLabel}>
        {
          langOrder.map((code) => (
            <li>
              <a
                href={localizePath(switchPath, code)}
                lang={htmlLangs[code]}
                aria-current={code === lang ? 'true' : undefined}
              >
                {langShort[code]}
              </a>
            </li>
          ))
        }
      </ul>
      <span class="foot-meta">
        {f.place} · {f.updated}{lang === 'en' ? ' ' : ''}{updated}
      </span>
      <span class="foot-meta">&copy; {new Date().getFullYear()} AI For Good</span>
    </div>
  </div>
</footer>
