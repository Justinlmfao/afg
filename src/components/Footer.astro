---
// Site footer — quiet, ruled, document-like.
import Logo from './Logo.astro';
import { getLangFromUrl, localizePath, ui, navItems } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = ui[lang];
const year = new Date().getFullYear();
const email = 'ps20153216@student.vsa.edu.hk';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-brand">
        <Logo size={20} />
        AI For Good
      </p>
      <p class="footer-tagline">{t.footerTagline}</p>
    </div>

    <nav class="footer-nav" aria-label={t.navFooter}>
      {
        navItems.map((item) => (
          <a href={localizePath(item.path, lang)}>{t.nav[item.key]}</a>
        ))
      }
    </nav>

    <div class="footer-contact">
      <a href={`mailto:${email}`}>{email}</a>
      <p class="footer-meta">{t.footerMeta}</p>
      <p class="footer-meta footer-copy">&copy; {year} AI For Good</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--rule);
    padding-block: 3rem;
    font-size: 0.95rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.5fr 0.7fr 1.1fr;
    gap: 2rem;
    align-items: start;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--serif);
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .footer-tagline {
    color: var(--graphite);
    max-width: 30rem;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-nav a {
    color: var(--graphite);
    text-decoration: none;
    width: fit-content;
  }

  .footer-nav a:hover {
    color: var(--ink);
  }

  /* Padding on the inline link widens its tap target without moving text */
  .footer-contact a {
    font-weight: 600;
    overflow-wrap: anywhere;
    padding-block: 0.3rem;
  }

  .footer-meta {
    color: var(--graphite);
    margin-top: 0.75rem;
    font-size: 0.85rem;
  }

  .footer-copy {
    margin-top: 0.15rem;
  }

  @media (max-width: 46rem) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
